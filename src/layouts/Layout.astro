---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/lexend';
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interVietnamese from '@fontsource-variable/inter/files/inter-vietnamese-wght-normal.woff2?url';
import interExtended from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/section-headings.css';
import '../styles/hero-spacing.css';
interface Props {
	title: string;
  canonicalURL?: string | URL;
	image?: string;
	description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string,unknown>[];
}

const { title, canonicalURL, image, type, noindex, publishedTime, modifiedTime, structuredData, description = "Dịch vụ decal dán kính cách nhiệt & trang trí chuyên nghiệp" } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVietnamese} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interExtended} as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/idecal-logo.png" />
		<meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/google-sans-flex/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans-flex/google-sans-flex-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
		<SEO canonicalURL={canonicalURL} title={title} description={description} image={image} type={type} noindex={noindex} publishedTime={publishedTime} modifiedTime={modifiedTime} structuredData={structuredData} />
	</head>
	<body class="bg-background font-body text-secondary">
		<Header />
		
		<main class:list={['page-content', { 'site-section-headings': !Astro.url.pathname.startsWith('/blog') && !noindex }]}>
			<slot /> 
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Đảm bảo trang luôn đủ chiều cao để Footer nằm ở dưới cùng */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.page-content {
		flex: 1;
	}
</style>
