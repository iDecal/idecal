---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/lexend';
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/hero-spacing.css';
interface Props {
	title: string;
  canonicalURL?: string | URL;
	image?: string;
	description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string,unknown>[];
}

const { title, canonicalURL, image, type, noindex, publishedTime, modifiedTime, structuredData, description = "Dịch vụ decal dán kính cách nhiệt & trang trí chuyên nghiệp" } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/idecal-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<SEO canonicalURL={canonicalURL} title={title} description={description} image={image} type={type} noindex={noindex} publishedTime={publishedTime} modifiedTime={modifiedTime} structuredData={structuredData} />
	</head>
	<body class="bg-background font-body text-secondary">
		<Header />
		
		<main class="page-content">
			<slot /> 
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Đảm bảo trang luôn đủ chiều cao để Footer nằm ở dưới cùng */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.page-content {
		flex: 1;
	}
</style>
