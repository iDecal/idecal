---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/lexend';
import '../styles/global.css';
interface Props {
	title: string;
	image?: string;
	description?: string; // Thêm mô tả để tốt cho SEO
}

const { title, image, description = "Dịch vụ decal dán kính cách nhiệt & trang trí chuyên nghiệp" } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/idecal-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<SEO title={title} description={description} image={image} />
	</head>
	<body class="bg-background font-body text-secondary">
		<Header />
		
		<main class="page-content">
			<slot /> 
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Đảm bảo trang luôn đủ chiều cao để Footer nằm ở dưới cùng */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.page-content {
		flex: 1;
	}
</style>
