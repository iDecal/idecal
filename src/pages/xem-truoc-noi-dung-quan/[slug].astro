---
import Layout from '../../layouts/Layout.astro';
import drafts from '../../data/district-docx-preview.json';
import {districts,districtUrl,districtBookingUrl} from '../../data/districts';
import LocalInstallationPhotos from '../../components/LocalInstallationPhotos.astro';
import '../../styles/district-preview.css';
export function getStaticPaths(){return drafts.map(draft=>({params:{slug:draft.slug},props:{draft}}));}
const {draft}=Astro.props;
const clean=(value:string)=>value.replace(/\s*\[[^\]]*\]/g,'').trim();
const nearby=draft.nearby.filter(value=>!value.startsWith('Xem thêm')).map(value=>{const name=value.replace('Dán decal kính ','').split(' (')[0];const district=districts.find(d=>d.name===name||d.name.replace('TP. ','')===name);return {name,url:district?districtUrl(district.slug):'/khu-vuc/tp-hcm'};});
---
<Layout title={`Bản duyệt: ${draft.name}`} description={`Đề xuất nội dung dán decal kính ${draft.name} từ DOCX, chưa áp dụng lên website chính.`} noindex={true}>
<div class="draft-wrap">
<div class="draft-toolbar"><a href="/xem-truoc-noi-dung-quan">← Danh sách 21 khu vực</a><a href={`https://idecal.pages.dev${districtUrl(draft.slug)}`} target="_blank" rel="noopener">Đối chiếu trang hiện tại ↗</a></div>
<details class="draft-review"><summary>Ghi chú duyệt nội dung · Chưa xuất bản</summary><p>URL giữ nguyên: <strong>{districtUrl(draft.slug)}</strong>. Không áp dụng URL mới trong DOCX.</p><p>Tiêu đề SEO đề xuất: {draft.metadata.Title}</p><p>Mô tả đề xuất: {draft.metadata['Meta description']}</p><p>Email trong tệp là idecals.net@gmail.com, khác thông tin hiện tại. Chưa thay email hoặc bổ sung địa chỉ khi chưa xác nhận.</p>{draft.notes.length>0&&<><h2>Các dòng cần kiểm tra trong tệp</h2><ul>{draft.notes.map(note=><li>{note}</li>)}</ul></>}<p>Phần dưới là bản dàn trang đề xuất. Các chính sách có ghi chú xác nhận chưa được coi là thông tin chính thức. Bài gốc trên website chính được giữ nguyên.</p></details>
<header class="draft-hero"><p class="draft-label">DỊCH VỤ TẠI {draft.name.toLocaleUpperCase('vi')}</p><h1>{draft.heading}</h1><p class="draft-lead">{draft.intro}</p><div class="draft-actions"><a class="draft-button" href={districtBookingUrl(draft.slug)}>Nhận tư vấn & báo giá ↗</a><a href="https://zalo.me/0866077040">Gọi / Zalo: 0866.077.040</a></div><p class="draft-small">Tên quận/huyện dùng để tham chiếu khu vực cũ. Khi gửi yêu cầu, vui lòng ghi địa chỉ theo phường/xã hiện tại.</p></header>
<section class="draft-split"><div><p class="draft-label">CHỌN THEO KHÔNG GIAN</p><h2>Nhu cầu dán decal kính tại {draft.name}</h2></div><ul class="draft-needs">{draft.needs.map((text,index)=><li><span aria-hidden="true">0{index+1}</span><p>{text}</p></li>)}</ul></section>
<section class="draft-materials"><h2>Chọn loại decal phù hợp</h2><div>{draft.materials.map((text,index)=><article><h3>{clean(text).split(':')[0]}</h3><p>{clean(text).split(':').slice(1).join(':').trim()}</p><a href={['/dich-vu/decal-dan-kinh-van-phong','/dich-vu/cat-decal','/san-pham/decal-mo-hoa-tiet-cham','/dich-vu/phim-cach-nhiet'][index]}>Tìm hiểu vật liệu →</a></article>)}</div></section>
<aside class="draft-note"><h2>Lưu ý khi thi công tại {draft.name}</h2><p>{draft.localNote.includes('[Xác nhận')?'Lịch thi công, việc đăng ký với ban quản lý và các chi phí liên quan cần trao đổi theo địa chỉ thực tế. Xem nội dung đề xuất đầy đủ trong phần ghi chú duyệt ở đầu trang.':clean(draft.localNote)}</p></aside>
</div>
<LocalInstallationPhotos areaKey={draft.slug} areaName={draft.name} />
<div class="draft-wrap">
<section class="draft-split"><div><p class="draft-label">TỪ YÊU CẦU ĐẾN HOÀN THIỆN</p><h2>Quy trình thi công</h2></div><ol class="draft-steps">{draft.steps.map(step=><li>{step}</li>)}</ol></section>
<section class="draft-faq"><h2>Câu hỏi về dán decal kính {draft.name}</h2>{draft.faqs.map(item=><details><summary>{clean(item.question)}</summary><p>{item.answer.includes('[Xác nhận')?'Thông tin này cần được iDecal xác nhận trước khi công bố. Vui lòng liên hệ để trao đổi theo nhu cầu thực tế.':clean(item.answer)}</p></details>)}</section>
<nav class="draft-nearby" aria-label="Khu vực lân cận"><span>Khu vực lân cận</span>{nearby.map(item=><a href={item.url}>{item.name} ↗</a>)}<a href="/khu-vuc/tp-hcm">Toàn TP.HCM →</a></nav>
<section class="draft-contact"><div><h2>Trao đổi nhu cầu tại {draft.name}</h2><p>Gửi ảnh kính, kích thước và địa chỉ thi công để được tư vấn.</p></div><a class="draft-button" href={districtBookingUrl(draft.slug)}>Gửi yêu cầu ↗</a></section>
</div>
</Layout>
