---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id));
const categories = ['Tất cả', ...new Set(projects.map(project => project.data.category))];
---

<Layout title="Công trình thực tế | Thi công decal iDecal" description="Khám phá các công trình decal dán kính, trang trí văn phòng và showroom do iDecal thực hiện. Xem hình ảnh và thông tin từng công trình.">
  <section class="border-b border-slate-100 bg-slate-50 py-16 md:py-24">
    <div class="container">
      <nav aria-label="Đường dẫn" class="mb-8 text-sm text-slate-500"><a href="/" class="hover:text-primary">Trang chủ</a><span aria-hidden="true" class="mx-3">/</span><span aria-current="page">Công trình</span></nav>
      <p class="!mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Hồ sơ công trình iDecal</p>
      <h1 class="max-w-3xl">Công trình thực tế</h1>
      <p class="!mb-0 max-w-2xl text-lg text-slate-500">Từ ý tưởng đến không gian hoàn thiện. Xem hình ảnh, hạng mục và thông tin các công trình iDecal đã thực hiện.</p>
    </div>
  </section>

  <section class="container py-12 md:py-16" aria-label="Danh sách công trình">
    <div class="mb-10 flex flex-col gap-6">
      <div class="max-w-lg">
        <label for="project-search" class="mb-2 block text-sm font-semibold text-secondary">Tìm công trình</label>
        <input id="project-search" type="search" placeholder="Tên công trình, khách hàng, khu vực…" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-secondary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
      </div>
      <div class="flex flex-wrap gap-3" role="group" aria-label="Lọc theo hạng mục">
        {categories.map(category => (
          <button type="button" class={`project-filter rounded-full border px-5 py-2.5 text-sm font-semibold transition-colors ${category === 'Tất cả' ? 'border-primary bg-primary text-white' : 'border-slate-200 bg-white text-slate-600 hover:border-primary'}`} data-category={category} aria-pressed={category === 'Tất cả'}>
            {category}
          </button>
        ))}
      </div>
      <p id="project-count" class="!mb-0 text-sm text-slate-500" role="status" aria-live="polite" aria-atomic="true">Hiển thị {projects.length} công trình</p>
    </div>

    <div id="project-grid" class="grid items-stretch gap-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => <ProjectCard project={project} headingLevel="h2" />)}
    </div>
    <div id="project-empty" hidden class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <h2 class="text-xl">Không tìm thấy công trình phù hợp</h2>
      <p>Thử từ khóa khác hoặc bỏ bộ lọc để xem tất cả công trình.</p>
      <button id="project-reset" type="button" class="btn-primary-solid">Xem tất cả công trình</button>
    </div>
  </section>

  <section class="container pb-20">
    <div class="rounded-3xl bg-slate-900 px-6 py-14 text-center md:px-12">
      <h2 class="text-white">Bạn đang lên ý tưởng cho công trình mới?</h2>
      <p class="mx-auto mb-8 max-w-xl text-slate-300">Gửi hình ảnh và nhu cầu của bạn để iDecal tư vấn mẫu decal, phương án thi công và báo giá phù hợp.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:0866077040" class="btn-primary-solid">Gọi 0866.077.040</a>
        <a href="https://zalo.me/0866077040" class="rounded-brand border border-white/30 px-8 py-4 font-bold text-white hover:bg-white/10">Chat Zalo nhận báo giá</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const filters = document.querySelectorAll<HTMLButtonElement>('.project-filter');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .project-card');
  const count = document.getElementById('project-count');
  const empty = document.getElementById('project-empty');
  let category = 'Tất cả';

  const normalize = (value: string) => value.toLocaleLowerCase('vi-VN').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').trim();

  function updateProjects() {
    const query = normalize(search?.value ?? '');
    let visible = 0;
    cards.forEach(card => {
      const matches = (category === 'Tất cả' || card.dataset.category === category) && normalize(card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    filters.forEach(button => {
      const active = button.dataset.category === category;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('bg-primary', active);
      button.classList.toggle('text-white', active);
      button.classList.toggle('border-primary', active);
      button.classList.toggle('bg-white', !active);
      button.classList.toggle('text-slate-600', !active);
      button.classList.toggle('border-slate-200', !active);
    });
    if (count) count.textContent = `Hiển thị ${visible} / ${cards.length} công trình`;
    if (empty) empty.hidden = visible > 0;
  }
  search?.addEventListener('input', updateProjects);
  filters.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category ?? 'Tất cả';
    updateProjects();
  }));
  document.getElementById('project-reset')?.addEventListener('click', () => {
    category = 'Tất cả';
    if (search) search.value = '';
    updateProjects();
    search?.focus();
  });
</script>
