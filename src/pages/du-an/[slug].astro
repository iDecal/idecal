---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/project-detail.css';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const gallery = [...new Set(entry.data.gallery)].filter(image => image !== entry.data.image);
const related = (await getCollection('projects'))
  .filter(project => project.id !== entry.id)
  .sort((a,b) => Number(b.data.category === entry.data.category) - Number(a.data.category === entry.data.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0,4);
const bookingUrl = '/dat-dich-vu?dich-vu=dich-vu-tron-goi';
---
<Layout title={`${entry.data.title} | iDecal`} description={entry.data.description} image={entry.data.image}>
  <div class="project-detail">
    <section class="project-detail-hero"><div class="container project-detail-hero-grid">
      <div><p class="project-detail-badge">{entry.data.category}</p><h1 class="brand-heading">{entry.data.title}</h1><p class="project-detail-intro">{entry.data.description}</p><a href="#hinh-anh" class="project-detail-link">Xem hình ảnh thực tế <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a></div>
      <div class="project-detail-facts"><h2>Thông tin công trình</h2><dl><div><dt>Khách hàng</dt><dd>{entry.data.client}</dd></div><div><dt>Loại công trình</dt><dd>{entry.data.category}</dd></div>{entry.data.location && <div><dt>Khu vực</dt><dd>{entry.data.location}</dd></div>}{entry.data.service && <div><dt>Hạng mục</dt><dd>{entry.data.service}</dd></div>}</dl></div>
    </div></section>
    <section id="hinh-anh" class="container project-detail-visual" aria-label="Hình ảnh thực tế công trình"><figure><a class="project-detail-photo" href={entry.data.image} target="_blank" rel="noopener noreferrer" aria-label={`Mở ảnh lớn: ${entry.data.title}`}><img src={entry.data.image} alt={entry.data.title} width="1600" height="1000" fetchpriority="high" /><span class="project-detail-enlarge"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5" /></svg>Xem ảnh lớn</span></a><figcaption><span>Hình ảnh tại công trình</span><span>{entry.data.client}</span></figcaption></figure></section>
    <section class="container project-detail-body">
      <article class="project-detail-story"><p class="project-detail-kicker">Hồ sơ thực hiện</p><h2 class="project-detail-section-title">Về công trình</h2><div class="project-detail-content"><Content /></div>
        {gallery.length > 0 && <section class="project-detail-gallery" aria-label="Thư viện ảnh"><h2 class="project-detail-section-title">Các góc nhìn thực tế</h2><div>{gallery.map((image,index) => <a href={image} target="_blank" rel="noopener noreferrer" aria-label={`Mở ảnh công trình ${index + 2}`}><img src={image} alt={`${entry.data.title} – góc nhìn ${index + 2}`} width="900" height="700" loading="lazy" /></a>)}</div></section>}
      </article>
      <aside class="project-detail-aside" aria-label="Tư vấn công trình"><div class="project-detail-consult"><span class="project-detail-consult-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16v12H9l-5 4V4Zm4 4h8M8 12h5" /></svg></span><p class="project-detail-kicker">Ý tưởng cho không gian của bạn</p><h2>Bạn thích cách hoàn thiện này?</h2><p>Gửi hình ảnh không gian, kích thước và nhu cầu của bạn. iDecal sẽ tư vấn mẫu, vật liệu và phương án thực hiện phù hợp.</p><a class="btn-primary-solid" href={bookingUrl}>Trao đổi về công trình <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14" /></svg></a><a class="project-detail-link" href="https://zalo.me/0866077040">Tư vấn qua Zalo <span aria-hidden="true">→</span></a><p class="project-detail-consult-note">Mẫu và chi phí được xác nhận theo hiện trạng, vật liệu và khối lượng thực tế.</p></div></aside>
    </section>
    {related.length > 0 && <section class="project-detail-related"><div class="container"><div class="project-detail-related-heading"><div><p class="project-detail-kicker">Thêm ý tưởng tham khảo</p><h2 class="project-detail-section-title">Khám phá công trình khác</h2></div><a class="project-detail-link" href="/du-an">Tất cả công trình <span aria-hidden="true">→</span></a></div><div class="project-detail-related-grid">{related.map(project => <ProjectCard project={project} />)}</div></div></section>}
    <div class="container project-detail-back"><a href="/du-an" class="project-detail-link"><span aria-hidden="true">←</span>Trở lại danh sách công trình</a></div>
  </div>
</Layout>
