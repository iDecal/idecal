---
import Layout from '../../layouts/Layout.astro';
import materialData from '../../data/project-materials.json';
import { getCollection, render } from 'astro:content';
import '../../styles/project-detail.css';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const gallery = [...new Set([entry.data.image, ...entry.data.gallery])];
type Material={name:string;description:string;guide:string;guideLabel:string;service:string;serviceLabel:string};
const materials=(materialData as Record<string,Material[]>)[entry.id]??[];
const related = (await getCollection('projects')).filter(project => project.id !== entry.id)
 .sort((a,b) => Number(b.data.category === entry.data.category) - Number(a.data.category === entry.data.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
const optimizedImages:Record<string,string>={'/images/cong-trinh/Trang-tri-kinh-phong-kham-FDcare.png':'/images/thi-cong-thuc-te/fdcare-quan-9.webp','/images/cong-trinh/thi-cong-dan-decal-luoi-mat-tien-toyota-tan-binh.jpg':'/images/thi-cong-thuc-te/toyota-ly-thuong-kiet.webp'};
const displayImage=(source:string)=>optimizedImages[source]??source;
const bookingUrl = '/lien-he-idecal?dich-vu=thi-cong-decal#yeu-cau';
const orderedGallery=entry.id==='film-van-song-vach-kinh-van-phong'&&gallery.length>2?[gallery[2],...gallery.filter((_,index)=>index!==2)]:gallery;
const visibleDetails=orderedGallery.slice(1,3);
const remainingDetails=orderedGallery.slice(3);
const namedClient=entry.data.client!=='Khách hàng iDecal';
---
<Layout title={`${entry.data.title} | iDecal`} description={entry.data.description} image={entry.data.image}>
 <article class="project-case" data-case-gallery>
  <header class="container case-header"><a class="case-back" href="/du-an">← Công trình thực tế</a><div class="case-heading"><p class="case-category">{entry.data.category}</p><h1>{entry.data.title}</h1></div><dl class="case-facts">{namedClient&&<div><dt>Khách hàng</dt><dd>{entry.data.client}</dd></div>}{entry.data.location&&<div><dt>Khu vực</dt><dd>{entry.data.location}</dd></div>}<div><dt>Thực hiện</dt><dd>iDecal</dd></div></dl></header>
  <div class="container">
   <figure class="case-cover"><a href={orderedGallery[0]} target="_blank" rel="noopener" data-case-image="0" aria-label="Xem ảnh công trình kích thước đầy đủ"><img src={displayImage(orderedGallery[0])} alt={`${entry.data.title} – ảnh công trình`} width="1440" height="960" fetchpriority="high" /></a><figcaption><span>Ghi lại tại công trình</span><span>{String(orderedGallery.length).padStart(2,'0')} ảnh <span class="case-caption-divider">/</span> Bấm để xem lớn</span></figcaption></figure>
   <section class="case-project-notes" aria-label="Hạng mục và vật liệu công trình"><div class="case-work"><h2>Hạng mục thực hiện</h2><p>{entry.data.service??(materials.length?materials.map(item=>item.name).join(' · '):entry.data.category)}</p></div><div class="case-materials"><h2>Vật liệu sử dụng</h2>{materials.length?materials.map(material=><div class="case-material-row"><a class="case-material-name" href={material.guide} aria-label={material.guideLabel}>{material.name} →</a><a class="case-material-service" href={material.service}>{material.serviceLabel} →</a></div>):<a href="/lien-he-idecal">Trao đổi về vật liệu công trình →</a>}</div></section>
   {visibleDetails.length>0&&<section class="case-photo-details" aria-label="Các góc nhìn công trình">{visibleDetails.map((image,index)=><figure><a href={image} target="_blank" rel="noopener" data-case-image={index+1} aria-label={`Xem ảnh công trình ${index+2}`}><img src={displayImage(image)} alt={`${entry.data.title} – góc nhìn ${index+2}`} width="1000" height="750" loading="lazy"/></a><figcaption>Góc nhìn {String(index+2).padStart(2,'0')}</figcaption></figure>)}</section>}
   {remainingDetails.length>0&&<details class="case-more-photos"><summary>Xem thêm {remainingDetails.length} ảnh công trình<span aria-hidden="true">+</span></summary><div class="case-photo-details">{remainingDetails.map((image,index)=><figure><a href={image} target="_blank" rel="noopener" data-case-image={index+3} aria-label={`Xem ảnh công trình ${index+4}`}><img src={displayImage(image)} alt={`${entry.data.title} – góc nhìn ${index+4}`} width="1000" height="750" loading="lazy"/></a><figcaption>Góc nhìn {String(index+4).padStart(2,'0')}</figcaption></figure>)}</div></details>}
   <details class="case-story"><summary>Thông tin chi tiết công trình<span aria-hidden="true">+</span></summary><div class="case-story-content"><Content /></div></details>
   <section class="case-contact"><div><p>Công trình tiếp theo của bạn</p><h2>Cùng iDecal hoàn thiện không gian</h2></div><div class="case-contact-actions"><a class="case-consult" href={bookingUrl}>Trao đổi phương án →</a><a href="https://zalo.me/0866077040">Nhắn Zalo iDecal</a></div></section>
   {related.length>0&&<section class="case-related"><div class="case-related-heading"><h2>Khám phá thêm công trình</h2><a href="/du-an">Xem tất cả →</a></div><div class="case-related-grid">{related.map(project=><a href={`/du-an/${project.id}`}><img src={displayImage(project.data.image)} alt={project.data.title} width="720" height="480" loading="lazy"/><p>{project.data.category}</p><h3>{project.data.title}</h3></a>)}</div></section>}
  </div>
  <dialog class="case-viewer" aria-label="Thư viện ảnh công trình"><div class="case-viewer-toolbar"><span data-case-counter aria-live="polite"></span><button type="button" data-case-close>Đóng ×</button></div><img alt="Ảnh công trình phóng lớn"/><div class="case-viewer-controls">{orderedGallery.length>1&&<><button type="button" data-case-prev>← Ảnh trước</button><button type="button" data-case-next>Ảnh sau →</button></>}</div></dialog>
 </article>
</Layout>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-case-gallery]')){
 const links=[...root.querySelectorAll<HTMLAnchorElement>('[data-case-image]')].sort((a,b)=>Number(a.dataset.caseImage)-Number(b.dataset.caseImage));
 const viewer=root.querySelector<HTMLDialogElement>('.case-viewer')!;const image=viewer.querySelector('img')!;const counter=viewer.querySelector<HTMLElement>('[data-case-counter]')!;let current=0;
 const show=(index:number)=>{current=(index+links.length)%links.length;const link=links[current];image.src=link.href;image.alt=link.querySelector('img')?.alt??'';image.title=link.querySelector('img')?.title??image.alt;counter.textContent=`${String(current+1).padStart(2,'0')} / ${String(links.length).padStart(2,'0')}`;};
 for(const link of links)link.addEventListener('click',event=>{if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||typeof viewer.showModal!=='function')return;event.preventDefault();show(links.indexOf(link));viewer.showModal();});
 viewer.querySelector('[data-case-close]')?.addEventListener('click',()=>viewer.close());viewer.querySelector('[data-case-prev]')?.addEventListener('click',()=>show(current-1));viewer.querySelector('[data-case-next]')?.addEventListener('click',()=>show(current+1));viewer.addEventListener('keydown',event=>{if(event.key==='ArrowRight'){event.preventDefault();show(current+1);}if(event.key==='ArrowLeft'){event.preventDefault();show(current-1);}});viewer.addEventListener('click',event=>{if(event.target===viewer)viewer.close();});viewer.addEventListener('close',()=>image.removeAttribute('src'));
}
</script>
