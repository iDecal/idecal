---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/project-detail.css';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const gallery = [...new Set([entry.data.image, ...entry.data.gallery])];
const related = (await getCollection('projects'))
  .filter(project => project.id !== entry.id)
  .sort((a,b) => Number(b.data.category === entry.data.category) - Number(a.data.category === entry.data.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0,4);
const bookingUrl = '/dat-dich-vu?dich-vu=dich-vu-tron-goi';
---
<Layout title={`${entry.data.title} | iDecal`} description={entry.data.description} image={entry.data.image}>
  <div class="project-detail">
    <section class="project-detail-hero"><div class="container"><div class="project-detail-heading"><p class="project-detail-badge">{entry.data.category}</p><p class="project-detail-label">Hồ sơ công trình iDecal</p></div><h1 class="brand-heading">{entry.data.title}</h1><p class="project-detail-intro">{entry.data.description}</p><dl class="project-detail-facts"><div><dt>Khách hàng</dt><dd>{entry.data.client}</dd></div><div><dt>Loại công trình</dt><dd>{entry.data.category}</dd></div>{entry.data.location && <div><dt>Khu vực</dt><dd>{entry.data.location}</dd></div>}{entry.data.service && <div><dt>Hạng mục</dt><dd>{entry.data.service}</dd></div>}</dl></div></section>
    <section class="container project-detail-overview"><div><p class="project-detail-kicker">Từ yêu cầu đến hoàn thiện</p><h2 class="project-detail-section-title">Câu chuyện công trình</h2><a href="#hinh-anh" class="project-detail-link">Xem ảnh thực tế <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a></div><article class="project-detail-content" aria-label="Nội dung công trình"><Content /></article></section>
    <section id="hinh-anh" class="project-detail-gallery-section"><div class="container"><div class="project-detail-gallery-heading"><div><p class="project-detail-kicker">Ghi lại tại công trình</p><h2 class="project-detail-section-title">Hình ảnh thực tế</h2></div><p>Bấm vào ảnh để xem kích thước đầy đủ.</p></div><div class="project-detail-photo-grid">{gallery.map((image,index) => <figure><a class="project-detail-photo" href={image} target="_blank" rel="noopener noreferrer" aria-label={`Mở ảnh lớn ${index+1}: ${entry.data.title}`}><img src={image} alt={`${entry.data.title} – ảnh thực tế ${index+1}`} width="1000" height="800" loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} /><span class="project-detail-enlarge"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5" /></svg>Xem ảnh lớn</span></a><figcaption><span>Ảnh {String(index+1).padStart(2,'0')}</span><span>{entry.data.client}</span></figcaption></figure>)}</div></div></section>
    <section class="container project-detail-consult"><div><p class="project-detail-kicker">Ý tưởng cho không gian của bạn</p><h2 class="project-detail-section-title">Cùng hoàn thiện công trình tiếp theo</h2><p>Gửi hình ảnh không gian, kích thước và nhu cầu để iDecal tư vấn mẫu, vật liệu cùng phương án phù hợp.</p></div><div class="project-detail-consult-actions"><a class="btn-primary-solid" href={bookingUrl}>Trao đổi về công trình <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14" /></svg></a><a class="project-detail-link" href="https://zalo.me/0866077040">Tư vấn qua Zalo <span aria-hidden="true">→</span></a></div></section>
    {related.length > 0 && <section class="project-detail-related"><div class="container"><div class="project-detail-related-heading"><div><p class="project-detail-kicker">Thêm ý tưởng tham khảo</p><h2 class="project-detail-section-title">Khám phá công trình khác</h2></div><a class="project-detail-link" href="/du-an">Tất cả công trình <span aria-hidden="true">→</span></a></div><div class="project-detail-related-grid">{related.map(project => <ProjectCard project={project} />)}</div></div></section>}
    <div class="container project-detail-back"><a href="/du-an" class="project-detail-link"><span aria-hidden="true">←</span>Trở lại danh sách công trình</a></div>
  </div>
</Layout>
