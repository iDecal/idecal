---
import Layout from '../layouts/Layout.astro';
import { installationPhotos } from '../data/installation-photo-links';
---
<Layout title="Đối chiếu bộ ảnh thi công mới | iDecal" description="Bảng ảnh đánh số để đối chiếu công trình và địa điểm." noindex={true}>
<section class="container photo-review"><p class="review-label">Bảng đối chiếu dành cho chủ website</p><h1>42 ảnh vừa nhập</h1><p>Ảnh đã có URL, tiêu đề và ALT mô tả hạng mục. Để gắn đúng quận/tỉnh, bạn có thể gửi số ảnh hoặc nhóm ảnh kèm địa điểm, ví dụ: “18, 19, 21: công trình … tại …”.</p><p>Ảnh 03 là bảng mẫu họa tiết, được tách riêng khỏi ảnh thi công. Trang này chỉ để xem và đối chiếu, không có chức năng tải ảnh lên.</p><div class="review-grid">{installationPhotos.map(photo=><figure><a href={photo.src} target="_blank" rel="noopener"><img src={photo.src} alt={photo.alt} title={photo.title} width={photo.width} height={photo.height} loading="lazy" /></a><figcaption><strong>Ảnh {String(photo.number).padStart(2,'0')}</strong><p>{photo.caption}</p></figcaption></figure>)}</div></section>
</Layout>
<style>.photo-review{padding-top:45px;padding-bottom:45px;color:#244766}.review-label{font-size:12px;color:#718699}.photo-review h1{font-size:36px;margin:14px 0 24px}.photo-review>p{max-width:900px;line-height:1.9}.review-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 22px;margin-top:35px}.review-grid figure{margin:0;min-width:0}.review-grid a{display:block;background:#f0f5f8;border-radius:12px;overflow:hidden}.review-grid img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain}.review-grid figcaption{padding-top:14px;font-size:13px;line-height:1.8}.review-grid figcaption p{margin:8px 0 0;color:#657c8e}.review-grid strong{font-weight:600;color:#176b93}@media(max-width:767px){.review-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 16px}.photo-review h1{font-size:30px}}</style>
