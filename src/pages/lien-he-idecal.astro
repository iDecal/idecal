---
import Layout from '../layouts/Layout.astro';
import { regions } from '../data/regions';
import '../styles/contact.css';
const reasons = [
 {title:'Khảo sát & xem mẫu thực tế',text:'Trao đổi lịch đo đạc tại công trình và xem mẫu Decal để chọn phương án phù hợp với văn phòng hoặc không gian của bạn.',path:'M3 3h18v18H3zM7 3v4m5-4v4m5-4v4M3 12h4m-4 5h4'},
 {title:'Báo giá minh bạch',text:'Làm rõ vật liệu, khối lượng và phạm vi thi công trước khi thống nhất, giúp hạn chế các khoản ngoài thỏa thuận.',path:'M6 3h12v18l-3-2-3 2-3-2-3 2V3ZM9 7h6M9 11h6M9 15h3'},
 {title:'Hỗ trợ thiết kế mẫu',text:'Trao đổi demo cắt chữ, logo hoặc kẻ chỉ cho đơn hàng thi công. Nội dung hỗ trợ được thống nhất theo yêu cầu của từng mẫu.',path:'m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15v5Z'},
];
---
<Layout title="Liên hệ iDecal | Tư vấn Decal dán kính TP.HCM & Bình Dương" description="Liên hệ iDecal để tư vấn Decal mờ, cắt chữ logo, phim cách nhiệt và đặt lịch thi công. Hotline/Zalo 0866.077.040, email hi@idecal.vn. Làm việc thứ Hai–thứ Bảy, 08:00–18:00.">
  <div class="contact-page">
    <section class="contact-hero"><div class="container contact-hero-grid">
      <div class="contact-intro"><span class="contact-eyebrow">Kết nối cùng iDecal</span><h1 class="brand-heading">Liên hệ iDecal</h1><p class="contact-lead">Bạn cần tư vấn Decal mờ, cắt chữ logo hay phim cách nhiệt cho văn phòng?</p><p class="contact-description">Chia sẻ hiện trạng và nhu cầu để đội ngũ iDecal tư vấn vật liệu, mẫu thiết kế, khảo sát và báo giá phù hợp với không gian của bạn.</p><div class="contact-actions"><a href="https://zalo.me/0866077040" class="btn-primary-solid">Tư vấn qua Zalo<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a href="/dat-dich-vu" class="btn-idecal-bold">Đặt lịch thi công →</a></div><a href="/dich-vu#bang-gia-dich-vu" class="contact-price-link">Tham khảo bảng giá dịch vụ ↓</a></div>
      <aside class="contact-direct" aria-label="Thông tin liên hệ trực tiếp"><h2>Trao đổi trực tiếp</h2><div class="contact-channel"><span class="contact-channel-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m7 3 3 5-2 2a15 15 0 0 0 6 6l2-2 5 3-1 4C10 22 2 14 3 4l4-1Z"/></svg></span><div><p>Hotline / Zalo tư vấn</p><a href="tel:0866077040" class="contact-phone">0866.077.040</a><span>Gửi ảnh và kích thước để trao đổi phương án.</span></div></div><div class="contact-channel"><span class="contact-channel-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></span><div><p>Email báo giá dự án</p><a href="mailto:hi@idecal.vn" class="contact-email">hi@idecal.vn</a><span>Gửi hồ sơ, bản vẽ hoặc yêu cầu chi tiết.</span></div></div><div class="contact-websites"><p>Website iDecal</p><div><a href="/">idecal.vn</a><a href="https://filmnoithat.vn/" target="_blank" rel="noopener noreferrer">filmnoithat.vn<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a href="https://homedecal.vn/" target="_blank" rel="noopener noreferrer">homedecal.vn<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></aside>
    </div></section>
    <section class="container contact-section contact-planning-grid">
      <div class="contact-request"><p class="contact-kicker">Yêu cầu báo giá nhanh</p><h2 class="brand-heading">Bắt đầu từ công trình của bạn</h2><p>Chuẩn bị một vài thông tin để việc tư vấn mẫu và xác định chi phí rõ ràng hơn.</p><ul><li><span aria-hidden="true">✓</span>Tên, số điện thoại và địa chỉ công trình.</li><li><span aria-hidden="true">✓</span>Dịch vụ cần thực hiện: Decal mờ, phim cách nhiệt, in hoặc cắt Decal.</li><li><span aria-hidden="true">✓</span>Ảnh bề mặt, kích thước từng ô kính và mẫu hoặc file logo nếu có.</li><li><span aria-hidden="true">✓</span>Thời gian mong muốn, hiện trạng lớp Decal cũ và các ghi chú thi công.</li></ul><a href="/dat-dich-vu" class="btn-idecal-bold">Chuẩn bị yêu cầu đặt lịch →</a><p class="contact-request-note">Trang đặt lịch sẽ soạn nội dung để bạn gửi qua Zalo. iDecal sẽ trao đổi và xác nhận lịch sau khi tiếp nhận yêu cầu.</p></div>
      <aside class="contact-hours"><span class="contact-hours-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><h2>Thời gian làm việc</h2><dl><div><dt>Thứ Hai – Thứ Bảy</dt><dd>08:00 – 18:00</dd></div><div><dt>Chủ Nhật & ngày lễ</dt><dd>Khảo sát, thi công theo lịch hẹn trước.</dd></div></dl><p>Bạn có thể gửi ảnh và yêu cầu qua Zalo để đội ngũ iDecal tiếp nhận, trao đổi phương án phù hợp.</p></aside>
    </section>
    <section class="contact-soft"><div class="container contact-section"><div class="contact-section-heading"><p class="contact-kicker">Đồng hành từ tư vấn đến hoàn thiện</p><h2 class="brand-heading">Vì sao liên hệ với iDecal?</h2></div><div class="contact-reasons">{reasons.map(reason=><article><span class="contact-reason-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={reason.path}/></svg></span><h3>{reason.title}</h3><p>{reason.text}</p></article>)}</div></div></section>
    <section class="container contact-section contact-coverage"><div><p class="contact-kicker">Khu vực tư vấn & thi công</p><h2 class="brand-heading">Kết nối từ vị trí của bạn</h2><p>Chọn khu vực để xem dịch vụ và thông tin triển khai. Lịch khảo sát, thi công được thống nhất theo địa chỉ và khối lượng thực tế.</p></div><nav aria-label="Khu vực phục vụ">{regions.map(region=><a href={`/khu-vuc/${region.slug}`}>{region.slug==='vung-tau'?'Bà Rịa – Vũng Tàu':region.slug==='quy-nhon'?'Quy Nhơn / Bình Định':region.name}<span aria-hidden="true">→</span></a>)}</nav></section>
  </div>
</Layout>
