---
import Layout from '../../layouts/Layout.astro';
import PrintingLanding from '../../components/PrintingLanding.astro';
import printingSource from '../../data/printing-original.json';
import ServiceLanding from '../../components/ServiceLanding.astro';
import { serviceOfferings } from '../../data/site-offerings';
import evidence from '../../data/installation-evidence.json';
import { contactLocations } from '../../data/contact-locations';
export function getStaticPaths() { return serviceOfferings.filter(service => service.slug !== 'cat-decal').map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const isInstallation=service.slug==='thi-cong-decal';
const isPrinting=service.slug==='in-decal';
const structuredData:Record<string,unknown>[]=isInstallation?[{'@type':'Service','@id':'https://idecal.vn/dich-vu/thi-cong-decal/#service',name:service.headline,serviceType:'Thi công Decal dán kính, phim cách nhiệt và film nội thất',url:'https://idecal.vn/dich-vu/thi-cong-decal/',provider:{'@id':'https://idecal.vn/#organization'},areaServed:contactLocations.map(location=>({'@type':'Place',name:location.name})),image:evidence.photos.map(photo=>new URL(photo.image,Astro.site).href),description:'Dịch vụ thi công Decal theo hiện trạng công trình, có ảnh thực tế, hướng dẫn kiểm tra bề mặt và thông tin khu vực tiếp nhận yêu cầu.'}]:[];
if(isPrinting)structuredData.push({'@type':'Service',name:printingSource.hero.title,url:printingSource.canonical,description:printingSource.description,image:[new URL(printingSource.hero.image.src,Astro.site).href],provider:{'@id':'https://idecal.vn/#organization'}},{'@type':'FAQPage',mainEntity:printingSource.faq.items.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.blocks.map(block=>block.text).join(' ')}}))});
const description=isPrinting?printingSource.description:isInstallation?'Thi công Decal dán kính, phim cách nhiệt và film nội thất. Xem ảnh công trình iDecal, kinh nghiệm xử lý bề mặt và khu vực tiếp nhận thi công.':service.description;
---
<Layout title={isPrinting?printingSource.sourceTitle:`${service.name} | Dịch vụ iDecal`} description={description} image={isPrinting?printingSource.hero.image.src:service.image} structuredData={structuredData}>
  {isPrinting?<PrintingLanding />:<ServiceLanding service={service} />}
</Layout>
