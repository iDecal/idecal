---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { serviceOfferings } from '../../data/site-offerings';
import '../../styles/offering-landings.css';
export function getStaticPaths() { return serviceOfferings.filter(service => service.slug !== 'cat-decal').map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Layout title={`${service.name} | Dịch vụ iDecal`} description={service.description} image={service.image}>
  <div class="offering-landing">
    <PageBanner title={service.headline} eyebrow={`Dịch vụ ${service.name.toLocaleLowerCase('vi-VN')}`} image={service.image} imageAlt={service.name}>
      <p slot="description">{service.description}</p>
      <Fragment slot="actions"><a class="btn-primary-solid" href={`/dat-dich-vu?dich-vu=${service.slug}`}>Gửi yêu cầu dịch vụ</a><a class="btn-idecal-bold" href="#quy-trinh">Xem cách thực hiện ↓</a></Fragment>
    </PageBanner>
    <section class="offering-section container offering-advice"><div><p class="offering-kicker">Phạm vi thực hiện</p><h2>Bạn cần hỗ trợ phần việc nào?</h2><p>Có thể chọn riêng dịch vụ hoặc kết hợp với sản phẩm. iDecal trao đổi phạm vi và cách thực hiện trước khi xác nhận.</p></div><ul class="offering-deliverables">{service.deliverables.map(text => <li><span aria-hidden="true">✓</span>{text}</li>)}</ul></section>
    <section id="quy-trinh" class="offering-section offering-surface"><div class="container"><div class="offering-heading"><p class="offering-kicker">Từng bước rõ ràng</p><h2>Từ yêu cầu đến hoàn thiện</h2></div><div class="offering-cards">{service.steps.map((step,index) => <article><span class="offering-number">0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>
    <section class="offering-section offering-surface"><div class="container offering-advice"><div><p class="offering-kicker">Chuẩn bị yêu cầu</p><h2>Gửi đúng thông tin, tư vấn sát nhu cầu</h2><p>Gửi kích thước, ảnh vị trí dán, nội dung hoặc file thiết kế và thời gian dự kiến. Những phần đã bao gồm trong đơn giá sẽ được xác nhận khi báo giá.</p></div><div class="offering-service-links"><a href={`/dat-dich-vu?dich-vu=${service.slug}`}><span>Đặt dịch vụ {service.name.toLocaleLowerCase('vi-VN')}</span><span aria-hidden="true">↗</span></a><a href="/du-an"><span>Xem công trình thực tế</span><span aria-hidden="true">→</span></a></div></div></section>
  </div>
</Layout>
