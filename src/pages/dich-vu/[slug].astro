---
import Layout from '../../layouts/Layout.astro';
import ServiceLanding from '../../components/ServiceLanding.astro';
import { serviceOfferings } from '../../data/site-offerings';
export function getStaticPaths() { return serviceOfferings.filter(service => service.slug !== 'cat-decal').map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Layout title={`${service.name} | Dịch vụ iDecal`} description={service.description} image={service.image}>
  <ServiceLanding service={service} />
</Layout>
