---
import ServiceGallery from '../../components/ServiceGallery.astro';
import '../../styles/services.css';
import PageBanner from '../../components/PageBanner.astro';
import Layout from '../../layouts/Layout.astro';
import BlogHome from '../../components/BlogHome.astro';
const officeServices = [
  {
    title: "Decal Mờ Phun Cát",
    desc: "Giải pháp phổ biến nhất cho vách kính văn phòng, tạo không gian riêng tư nhưng vẫn giữ được sự thông thoáng.",
    features: ["Che mờ tầm nhìn", "Dễ dàng vệ sinh", "Chi phí tối ưu"],
    image: "/images/catalogue/decal-mo-trang-tron-van-phong.jpg"
  },
  {
    title: "Cắt Chữ & Logo Công Ty",
    desc: "Khẳng định thương hiệu ngay từ cửa ra vào. Cắt CNC chính xác logo và tên công ty trên nền decal mờ hoặc decal màu.",
    features: ["Độ chính xác cao", "Thiết kế theo yêu cầu", "Tăng tính chuyên nghiệp"],
    image: "/images/cong-trinh/Trang-tri-kinh-phong-kham-FDcare.png"
  },
  {
    title: "Decal Trang Trí & Chỉ Kẻ",
    desc: "Tạo điểm nhấn hiện đại với các đường kẻ chỉ (line) hoặc họa tiết hình học, giúp không gian bớt đơn điệu.",
    features: ["Thẩm mỹ cao", "Mẫu mã đa dạng", "Tạo cảm hứng làm việc"],
    image: "/images/catalogue/decal-mo-ke-soc-ngang.jpg"
  }
];
---

<Layout title="Decal Dán Kính Văn Phòng | Thiết Kế & Thi Công Trọn Gói">
<div class="services-redesign">

  <PageBanner title="Nâng Tầm Không Gian Làm Việc Với Decal Kính" eyebrow="Dịch vụ iDecal" image="/images/Banner/Dich-vu-dan-Decal-kinh-mo-van-phong-TP-HCM.png" imageAlt="Văn phòng dán decal kính mờ">
    <p slot="description">
          iDecal chuyên cung cấp giải pháp <strong>decal mờ, cắt logo, trang trí vách kính</strong> chuyên nghiệp cho văn phòng. Giúp tạo sự riêng tư, tăng tính thẩm mỹ và nhận diện thương hiệu cho không gian làm việc.
        </p>
    <Fragment slot="actions"><a class="btn-primary-solid" href="/lien-he-idecal">Nhận tư vấn mẫu &amp; Báo giá</a></Fragment>
  </PageBanner>
<ServiceGallery service="decal-dan-kinh-van-phong" />

  <section class="py-24 bg-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="brand-heading mb-4">Dịch vụ Decal văn phòng tiêu biểu</h2>
        <p class="text-text-muted">Chúng tôi thấu hiểu nhu cầu về một không gian làm việc vừa riêng tư vừa giữ được tính kết nối giữa các phòng ban.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {officeServices.map((service) => (
          <div class="service-card-brand group h-full">
            <div class="mb-6 overflow-hidden rounded-2xl h-48">
              <img src={service.image} alt={service.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
            </div>
            <h4 class="text-secondary !mb-3">{service.title}</h4>
            <p class="text-xs leading-relaxed mb-6">{service.desc}</p>
            <ul class="space-y-2 mt-auto">
              {service.features.map((f) => (
                <li class="text-[11px] font-bold text-text-muted flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-surface/30">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h6>Quy trình thực hiện</h6>
          <h2 class="brand-heading">Thi công nhanh gọn, không ảnh hưởng giờ làm việc</h2>
          <p class="mt-6 mb-10">iDecal cam kết quy trình thi công sạch sẽ, chuyên nghiệp, đảm bảo tiến độ cho doanh nghiệp.</p>
          
          <div class="space-y-6">
            <div class="flex gap-4 p-4 bg-white rounded-2xl shadow-sm border border-border">
              <span class="text-2xl font-black text-primary/20">01</span>
              <p class="text-sm font-medium text-secondary">Khảo sát, đo đạc thực tế và tư vấn mẫu tại công trình.</p>
            </div>
            <div class="flex gap-4 p-4 bg-white rounded-2xl shadow-sm border border-border">
              <span class="text-2xl font-black text-primary/20">02</span>
              <p class="text-sm font-medium text-secondary">Thiết kế file cắt logo, demo maket để khách duyệt.</p>
            </div>
            <div class="flex gap-4 p-4 bg-white rounded-2xl shadow-sm border border-border">
              <span class="text-2xl font-black text-primary/20">03</span>
              <p class="text-sm font-medium text-secondary">Thi công sạch sẽ, bàn giao và hướng dẫn bảo quản.</p>
            </div>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <img src="/images/cong-trinh/thi-cong-decal-dan-kinh-quan-9.jpg" class="rounded-3xl h-64 w-full object-cover shadow-lg" alt="Thi công 1" />
          <img src="/images/cong-trinh/Trang-tri-kinh-phong-kham-FDcare.png" class="rounded-3xl h-64 w-full object-cover shadow-lg mt-8" alt="Thi công 2" />
        </div>
      </div>
    </div>
  </section>

  <BlogHome />
</div>
</Layout>
