---
import ServiceGallery from '../../components/ServiceGallery.astro';
import '../../styles/services.css';
import PageBanner from '../../components/PageBanner.astro';
import Layout from '../../layouts/Layout.astro';

// 1. Khai báo tất cả biến và dữ liệu ở đây
const features = [
  { title: "Bề mặt nổi 3D", desc: "Họa tiết vân sóng được dập nổi tạo hiệu ứng chiều sâu và cảm giác cao cấp khi chạm tay vào." },
  { title: "Độ xuyên sáng", desc: "Giữ lại 20-30% ánh sáng tự nhiên, giúp không gian không bị tối mà vẫn đảm bảo tính riêng tư tương đối." },
  { title: "Chất liệu cao cấp", desc: "Decal dày dặn, độ bám dính cực tốt trên kính, không để lại keo khi bóc bỏ sau thời gian dài." }
];

const products = [
  {
    id: "clear",
    name: "Vân Sóng Trong Suốt",
    imgSmall: "/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-co-nho-3D.jpg",
    imgLarge: "/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-3D-song-to.webp",
    alt: "Decal vân sóng trong suốt"
  },
  {
    id: "bronze",
    name: "Vân Sóng Màu Trà",
    imgSmall: "/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-nho.webp",
    imgLarge: "/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-to.webp",
    alt: "Decal vân sóng màu trà"
  },

];
---

<Layout title="Decal Mờ 3D Vân Sóng | Giải Pháp Trang Trí Vách Kính Sang Trọng">
<div class="services-redesign">

  <PageBanner title="Decal Mờ 3D Vân Sóng - Nghệ Thuật Trên Kính" eyebrow="Dịch vụ iDecal" image="/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-3D-song-to.webp" imageAlt="Decal mờ 3d vân sóng">
    <p slot="description">
          Dòng sản phẩm decal cao cấp với họa tiết vân sóng dập nổi tinh tế. Giải pháp hoàn hảo cho <strong>vách kính văn phòng, phòng tắm và cửa ra vào</strong>, mang lại vẻ đẹp hiện đại và đẳng cấp cho không gian.
        </p>
    <Fragment slot="actions"><a class="btn-primary-solid" href="/lien-he-idecal">Nhận báo giá thi công</a><a class="btn-idecal-bold" href="/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-3D-song-to.webp">Xem mẫu thực tế</a></Fragment>
  </PageBanner>
<ServiceGallery service="decal-mo-3d-van-song" />

  <section class="py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-3 gap-8">
        {features.map(f => (
          <div class="p-10 bg-surface/30 rounded-[2.5rem] border border-border/50 hover:bg-white hover:shadow-card transition-all duration-500">
            <h4 class="text-secondary mb-4">{f.title}</h4>
            <p class="text-sm text-text-muted leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-surface">
    <div class="container">
      <div class="text-center mb-16">
        <h6 class="text-primary font-black uppercase tracking-widest text-[10px]">Premium Collection</h6>
        <h2 class="brand-heading mt-4">Bảng Giá & Quy Cách Decal 3D Vân Sóng</h2>
        <p class="text-text-muted max-w-2xl mx-auto mt-4 text-sm">
          Sản phẩm cao cấp có đầy đủ tùy chọn <strong>Sóng To / Sóng Nhỏ</strong> cho tất cả các màu. 
          Thi công trọn gói chuyên nghiệp tại TP.HCM & Bình Dương.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-16">
        {products.map((p) => (
          <div class="product-card bg-white rounded-[3rem] p-8 shadow-sm border border-border group hover:shadow-xl transition-all flex flex-col" data-id={p.id}>
            <div class="h-60 overflow-hidden rounded-[2rem] mb-6 bg-brand-pale">
              <img 
                id={`img-${p.id}`}
                src={p.imgSmall} 
                alt={p.alt} 
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" 
              />
            </div>

            <h3 class="text-xl font-bold text-secondary mb-2">{p.name}</h3>
            
            <div class="flex gap-2 mb-6">
              <button 
                class="wave-selector active px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-wider transition-all border border-border"
                data-type="small" 
                data-target={p.id}
                data-src={p.imgSmall}
              >
                Sóng Nhỏ
              </button>
              <button 
                class="wave-selector px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-wider transition-all border border-border text-text-muted"
                data-type="large" 
                data-target={p.id}
                data-src={p.imgLarge}
              >
                Sóng To
              </button>
            </div>
            
            <div class="mt-auto pt-6 border-t border-slate-50">
              <div class="flex items-baseline gap-1 mb-2">
                <span class="text-2xl font-black text-primary">280.000đ</span>
                <span class="text-xs text-text-muted">/m²</span>
              </div>
              <ul class="text-[11px] text-text-muted space-y-1">
                <li>• Khổ ngang: 1.52m</li>
                <li>• Quy cách: 1.52m x 30m (cuộn)</li>
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="max-w-2xl mx-auto p-6 bg-surface/50 rounded-2xl border border-border text-center">
        <p class="text-[12px] text-text-muted leading-relaxed">
          <strong>Lưu ý:</strong> Giá trên chưa bao gồm công thi công và thuế VAT. 
          Đối với khách hàng đại lý hoặc công trình số lượng lớn, vui lòng liên hệ trực tiếp để có chiết khấu tốt nhất.
        </p>
      </div>
    </div>
  </section>

<section class="py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="brand-heading mb-6">Sự khác biệt của Decal 3D Vân Sóng</h2>
          <p class="text-text-muted mb-8">
            Không giống như các loại decal mờ thông thường, dòng 3D vân sóng tập trung vào hiệu ứng thị giác. Khi có ánh sáng chiếu vào, các đường vân sẽ tạo ra những mảng sáng tối đan xen, làm cho vách kính không còn đơn điệu.
          </p>
          <ul class="space-y-4 mb-10 text-sm font-medium text-secondary">
            <li class="flex items-center gap-3"><span class="text-primary font-bold">✓</span> Phù hợp cho vách ngăn phòng họp, phòng khách.</li>
            <li class="flex items-center gap-3"><span class="text-primary font-bold">✓</span> Độ xuyên sáng 20-30% tạo không gian mờ ảo.</li>
            <li class="flex items-center gap-3"><span class="text-primary font-bold">✓</span> Khả năng chống trầy xước bề mặt kính tốt.</li>
          </ul>
          <div class="p-6 bg-amber-50 rounded-2xl border border-amber-100">
             <p class="text-xs text-amber-700 italic">
               <strong>Lưu ý:</strong> Đây là dòng sản phẩm tập trung vào tính thẩm mỹ trang trí. Do độ xuyên sáng đạt khoảng 30%, sản phẩm cung cấp sự riêng tư tương đối.
             </p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <img src="/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-3D-song-to.webp" class="rounded-3xl h-full w-full object-cover shadow-lg" alt="Thi công vân sóng 1" />
          <div class="space-y-4">
            <img src="/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-nho.webp" class="rounded-3xl h-48 w-full object-cover shadow-lg" alt="Thi công vân sóng 2" />
            <img src="/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-to.webp" class="rounded-3xl h-48 w-full object-cover shadow-lg" alt="Thi công vân sóng 3" />
          </div>
        </div>
      </div>
    </div>
  </section>


</div>
</Layout>

<style>
  .wave-selector.active {
    background-image: theme('backgroundImage.brand-gradient');
    color: white;
    border-color: theme('colors.brand.middle');
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.wave-selector').forEach(button => {
    button.setAttribute('aria-pressed', String(button.classList.contains('active')));
    button.addEventListener('click', () => {
      const card = button.closest('.product-card');
      const image = card?.querySelector('img');
      const src = button.dataset.src;
      if (!image || !src) return;
      image.src = src;
      card?.querySelectorAll('.wave-selector').forEach(selector => {
        const active = selector === button;
        selector.classList.toggle('active', active);
        selector.setAttribute('aria-pressed', String(active));
      });
    });
  });
</script>
