---
import Layout from '../../layouts/Layout.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import ServiceSupport from '../../components/ServiceSupport.astro';
import { getServiceCta } from '../../data/service-cta';
import { getServicePath } from '../../data/service-routes';
import { serviceOfferings } from '../../data/site-offerings';

const services = serviceOfferings.map(service => ({
  ...service,
  href: getServicePath(service.slug),
  consultation: getServiceCta(service.slug),
}));
---
<Layout title="Dịch vụ thiết kế, in ấn & thi công Decal | iDecal" description="Khám phá dịch vụ thiết kế, in Decal, cắt Decal và thi công Decal tại iDecal.">
  <section class="services-intro" aria-labelledby="services-title">
    <div class="container services-intro-grid">
      <div>
        <p data-heading-label>Dịch vụ iDecal</p>
        <h1 id="services-title">Dịch vụ thiết kế, in ấn & thi công Decal</h1>
        <p class="services-lead">Chọn thiết kế, in, cắt hoặc thi công Decal theo nhu cầu của bạn. Tìm vật liệu và mẫu cụ thể tại menu Sản phẩm.</p>
        <div class="services-actions">
          <a href="/lien-he-idecal" class="btn-primary-solid">Đặt lịch thi công</a>
          <a href="#bang-gia-dich-vu" class="services-heading-link">Xem bảng giá</a>
        </div>
      </div>
      <figure class="services-intro-image">
        <img src="/images/Banner/decal-cat-chu-trang-tri-quang-cao.jpg" alt="Gia công cắt chữ và logo Decal" width="1100" height="900" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section id="cac-dich-vu" class="container services-offerings" aria-labelledby="services-offerings-title">
    <header class="services-section-header">
      <h2 id="services-offerings-title">Chọn dịch vụ bạn cần</h2>
      <a href="/san-pham/" class="services-heading-link">Xem vật liệu và sản phẩm</a>
    </header>
    <div class="services-card-grid">
      {services.map(service => (
        <article class="services-card">
          <a href={service.href} class="services-card-photo" aria-label={`Xem dịch vụ ${service.name}`}>
            <img src={service.image} alt={service.name} width="800" height="500" loading="lazy" decoding="async" />
          </a>
          <div class="services-card-copy">
            <h3><a href={service.href}>{service.name}</a></h3>
            <p>{service.deliverables[0]}</p>
            <div class="services-card-links">
              <a href={service.href} aria-label={`Xem chi tiết dịch vụ ${service.name}`}>Xem chi tiết</a>
              <a href={service.consultation.href} aria-label={`${service.consultation.action} – ${service.name}`}>{service.consultation.action}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <ServicePricing />
  <ServiceSupport />
</Layout>

<style>
  .services-intro {
    padding-block: clamp(32px, 5vw, 64px);
    background: radial-gradient(ellipse at 90% 0%, #eae9ff, transparent 60%), #f4f8fd;
    border-bottom: 1px solid #e0e9f3;
  }
  .services-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(24px, 5vw, 68px);
  }
  .services-intro h1 { max-width: 24ch; margin: 0 0 16px; text-wrap: balance; }
  .services-lead { max-width: 52ch; margin: 0; line-height: 1.75; }
  .services-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; margin-top: 22px; }
  .services-heading-link { display: inline-flex; align-items: center; min-height: 48px; font-weight: 600; }
  .services-heading-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .services-intro-image { height: clamp(240px, 28vw, 360px); margin: 0; overflow: hidden; border-radius: 18px; }
  .services-intro-image img, .services-card-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .services-offerings { padding-block: clamp(34px, 5vw, 70px); scroll-margin-top: 100px; }
  .services-section-header { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 4px 20px; margin-bottom: 20px; }
  .services-section-header h2 { margin: 0; }
  .services-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .services-card { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); overflow: hidden; border: 1px solid #dce7f2; border-radius: 16px; background: #fff; }
  .services-card-photo { display: block; min-height: 214px; overflow: hidden; }
  .services-card-photo:focus-visible { outline: 2px solid #006edc; outline-offset: -3px; }
  .services-card-copy { display: flex; flex-direction: column; min-width: 0; padding: clamp(16px, 2vw, 26px); }
  .services-card-copy h3 { margin: 0 0 10px; }
  .services-card-copy p { margin: 0 0 16px; font-size: 15px; line-height: 1.65; }
  .services-card-links { display: flex; align-items: center; flex-wrap: wrap; gap: 0 14px; margin-top: auto; padding-top: 4px; border-top: 1px solid #e0e9f3; font-size: 14px; }
  .services-card-links a { display: inline-flex; align-items: center; min-height: 48px; font-weight: 600; }
  .services-card-links a:hover, .services-card-copy h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1023px) {
    .services-card { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .services-card-photo { min-height: 0; aspect-ratio: 3 / 2; }
  }
  @media (max-width: 767px) {
    .services-intro-grid { grid-template-columns: minmax(0, 1fr); }
    .services-intro-image { height: clamp(180px, 55vw, 260px); border-radius: 14px; }
    .services-section-header { align-items: start; flex-direction: column; }
  }
  @media (max-width: 559px) {
    .services-card-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
</style>
