---
import Layout from '../../layouts/Layout.astro';
import CuttingLanding from '../../components/CuttingLanding.astro';
import source from '../../data/cutting-original.json';
import {cuttingFaqs} from '../../data/cutting-presentation';
const structuredData=[{'@type':'Service',name:source.hero.title,url:source.canonical,description:source.description,image:[new URL(source.hero.image.src,Astro.site).href],provider:{'@id':'https://idecal.vn/#organization'}},{'@type':'FAQPage',mainEntity:cuttingFaqs.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:[...item.blocks.map(block=>block.text),item.clarification].filter(Boolean).join(' ')}}))}];
---
<Layout title={source.sourceTitle} description={source.description} image={source.hero.image.src} structuredData={structuredData}><CuttingLanding /></Layout>
