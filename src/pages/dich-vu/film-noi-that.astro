---
import ServiceGallery from '../../components/ServiceGallery.astro';
import '../../styles/services.css';
import ProductImage from '../../components/ProductImage.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import '../../styles/service-landing.css';
import Layout from '../../layouts/Layout.astro';

const interiorFilms = [
  { title: "Vân Gỗ Cao Cấp", desc: "Tái tạo bề mặt tủ bếp, bàn ghế với đường vân sồi, óc chó chân thực.", brands: "Infeel, Octki", image: "/images/film-noi-that/Corance-CAB742.jpg" },
  { title: "Vân Đá Cẩm Thạch", desc: "Biến mặt bàn, quầy bar thành đá Marble sang trọng, chịu nhiệt tốt.", brands: "GYMak, Infeel", image: "https://idecal.vn/wp-content/uploads/2025/08/Phim-Dan-Noi-That-Van-Da-Cam-Thach-924-04-e1757256689856.png" },
  { title: "Vân Đơn Sắc (Solid)", desc: "Phong cách Minimalist với các tông màu trung tính nhám mờ hiện đại.", brands: "Octki", image: "/images/film-noi-that/DEN001.jpg" },
  { title: "Vân Bê Tông & Xi Măng", desc: "Hiệu ứng Industrial mạnh mẽ cho vách tường và kệ trang trí.", brands: "Infeel", image: "/images/film-noi-that/dan-film-noi-that-nha-pho-hien-dai-mau-be-tong.webp" },
  { title: "Vân Kim Loại & Xước", desc: "Làm mới thang máy, tủ lạnh với bề mặt xước kim loại đẳng cấp.", brands: "Octki", image: "/images/film-noi-that/CORANCE-CAM001-cuon.jpg" },
  { title: "Vân Tráng Gương", desc: "Bề mặt bóng gương sâu, phù hợp cho các điểm nhấn decor sang trọng.", brands: "GYMak", image: "" },
  { title: "Vân Vải & Da", desc: "Tạo cảm giác ấm cúng, mềm mại cho tủ quần áo và tab đầu giường.", brands: "Infeel", image: "/images/film-noi-that/Van-vai-CAN034-CUON.jpg" },
  { title: "Vân Bóng Mờ (Satin)", desc: "Độ bóng vừa phải, chống bám vân tay, dễ dàng vệ sinh lau chùi.", brands: "Octki", image: "/images/film-noi-that/DEN001.jpg" }
];

const applications = [
  { area: "Tủ Bếp & Mặt Bàn", detail: "Chống thấm nước, chịu nhiệt độ cao, bảo vệ cốt gỗ bên trong khỏi ẩm mốc." },
  { area: "Cửa & Thang Máy", detail: "Thay đổi màu sắc cửa ra vào, cửa phòng ngủ nhanh chóng không cần thay mới." },
  { area: "Tủ Áo & Kệ Tivi", detail: "Làm mới nội thất phòng ngủ, phòng khách đồng bộ theo phong cách thiết kế." },
  { area: "Vách Tường & Cột", detail: "Giải pháp thay thế sơn hoặc ốp đá nội thất với chi phí tiết kiệm." }
];

const faqs = [
  { q: "Dán Film nội thất có bền không?", a: "Sản phẩm có độ bền trung bình từ 5-10 năm. iDecal bảo hành bong tróc 2 năm cho mọi công trình." },
  { q: "Có dán được trên bề mặt cũ, bong tróc không?", a: "Được. Kỹ thuật viên của chúng tôi sẽ xử lý bề mặt (xả nhám, trám trét) phẳng mịn trước khi dán." },
  { q: "Film có chịu được nước và nhiệt không?", a: "Hoàn toàn có. Film nội thất cao cấp có lớp phủ chống xước, chịu được nước và nhiệt độ phòng bếp thông thường." }
];
---

<Layout title="Film Nội Thất - Furniture Wrap | Làm Mới Không Gian Không Cần Thay Đồ">
<div class="services-redesign service-lp service-lp-legacy">

  <ServiceHero title={"Film Nội Thất - Giải Pháp \"Refresh\" Không Gian Đẳng Cấp"} eyebrow="Dịch vụ iDecal" image="/images/film-noi-that/Phim-dan-noi-that-cao-cap.jpg" imageAlt="Dán film nội thất tủ bếp">
    <p slot="description">
          Thay đổi diện mạo <strong>tủ bếp, cửa, thang máy</strong> bằng Film cao cấp Octki, Infeel. Thi công sạch sẽ, không bụi bẩn, không mùi sơn, hoàn thiện ngay trong ngày.
        </p>
    <Fragment slot="actions"><a class="btn-primary-solid" href="#samples">Xem bảng màu thực tế</a><a class="btn-idecal-bold" href="https://zalo.me/0866077040">Báo giá qua Zalo</a></Fragment>
  </ServiceHero>
<ServiceGallery service="film-noi-that" />

  <section id="samples" class="py-24 bg-surface">
    <div class="container">
      <div class="text-center mb-16">
        <h6 class="text-primary font-black uppercase tracking-widest text-[10px]">Premium Catalog</h6>
        <h2 class="brand-heading mt-4">Bộ Sưu Tập Film Nội Thất 2026</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        {interiorFilms.map((film) => (
          <div class="bg-white rounded-[2rem] overflow-hidden group shadow-sm hover:shadow-xl transition-all border border-border">
            <div class="h-48 overflow-hidden">
              {film.image ? <ProductImage src={film.image} alt={film.title} /> : <div class="service-mirror-preview" role="img" aria-label="Minh họa hiệu ứng bề mặt gương"><span>Hiệu ứng bề mặt · minh họa</span></div>}
            </div>
            <div class="p-6">
              <p class="text-[9px] font-black text-primary uppercase mb-2">{film.brands}</p>
              <h4 class="text-sm font-bold text-secondary mb-2">{film.title}</h4>
              <p class="text-[11px] text-text-muted leading-relaxed">{film.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="grid grid-cols-2 gap-4">
          <img src="/images/film-noi-that/dan-film-noi-that-mat-ban.jpg" class="rounded-3xl h-64 w-full object-cover" alt="Dán tủ bếp" />
          <img src="/images/film-noi-that/dan-film-noi-that-thang-may.jpg" class="rounded-3xl h-64 mt-8 w-full object-cover" alt="Dán thang máy" />
        </div>
        <div>
          <h2 class="brand-heading mb-8">Ứng dụng đa dạng trong nội thất</h2>
          <div class="space-y-6">
            {applications.map(app => (
              <div class="flex gap-4 p-4 rounded-2xl hover:bg-surface transition-colors border border-transparent hover:border-border">
                <div class="text-primary font-bold">✨</div>
                <div>
                  <h4 class="text-base font-bold text-secondary">{app.area}</h4>
                  <p class="text-xs text-text-muted mt-1">{app.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

<section class="py-24 bg-surface">
    <div class="container max-w-4xl">
      <div class="text-center mb-16">
        <h2 class="brand-heading mb-4">Câu hỏi thường gặp</h2>
        <p class="text-text-muted">Giải đáp các thắc mắc về kỹ thuật và bảo hành dán Film nội thất.</p>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-white p-6 rounded-2xl border border-border shadow-sm">
            <h4 class="text-sm font-bold text-secondary mb-2">Q: {faq.q}</h4>
            <p class="text-xs text-text-muted leading-relaxed">A: {faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


</div>
</Layout>
