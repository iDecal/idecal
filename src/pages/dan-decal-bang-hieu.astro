---
import Layout from '../layouts/Layout.astro';
import SignageLanding from '../components/SignageLanding.astro';
import source from '../data/signage-original.json';
const structuredData=[
  {'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'Trang chủ',item:'https://idecal.vn/'},
    {'@type':'ListItem',position:2,name:source.parent.name,item:new URL(source.parent.href,'https://idecal.vn').href},
    {'@type':'ListItem',position:3,name:'Dán decal bảng hiệu',item:source.sourceCanonical},
  ]},
  {'@type':'Service',name:source.hero.title,url:source.sourceCanonical,description:source.description,serviceType:'Dán decal bảng hiệu',image:source.images.map(image=>image.src),provider:{'@id':'https://idecal.vn/#organization'}},
];
---
<Layout title={source.sourceTitle} description={source.description} canonicalURL={source.sourceCanonical} image={source.hero.image.src} structuredData={structuredData}><SignageLanding /></Layout>
