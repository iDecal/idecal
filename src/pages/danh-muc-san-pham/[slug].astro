---
import '../../styles/catalogue.css';
import BannerBenefits from '../../components/BannerBenefits.astro';
import PageBanner from '../../components/PageBanner.astro';
import Layout from '../../layouts/Layout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import { productCategories, productsInCategory, type ProductCategory } from '../../data/catalogue';
export function getStaticPaths() { return productCategories.map(category => ({ params: { slug: category.slug }, props: { category } })); }
interface Props { category: ProductCategory; }
const { category } = Astro.props;
const items = productsInCategory(category.slug);
const bannerImage = category.image.startsWith('/') ? category.image : '/images/Banner/decal-cat-chu-trang-tri-quang-cao.jpg';
---
<Layout title={`${category.name} | Mẫu & giá tham khảo iDecal`} description={category.description}>
  <PageBanner title={category.headline} eyebrow={category.name} image={bannerImage} imageAlt={category.image.startsWith('/') ? category.name : 'Cắt chữ Decal theo thiết kế'}>
    <p slot="description">{category.description}</p>
    <Fragment slot="actions"><a href="#mau-san-pham" class="btn-primary-solid">Xem {items.length} mẫu trong catalogue</a><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Nhận tư vấn qua Zalo</a></Fragment>
    <BannerBenefits slot="meta" benefits={category.benefits} />
  </PageBanner>
  <ProductCatalog items={items} category={category} />
</Layout>
