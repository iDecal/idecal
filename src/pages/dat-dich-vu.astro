---
import Layout from '../layouts/Layout.astro';
import { regions } from '../data/regions';
import { products } from '../data/catalogue';
import { isPVCProduct, pvcFinishes } from '../data/pvc-options';
import { serviceOfferings as services } from '../data/site-offerings';
import '../styles/booking.css';
import '../styles/pvc-options.css';
const productOptions = products.map(product=>({slug:product.slug,name:product.name,code:product.code,service:isPVCProduct(product.slug)?'cat-decal':'thi-cong-decal',pvc:isPVCProduct(product.slug)}));
---
<Layout title="Đặt lịch thi công Decal & phim cách nhiệt | iDecal" description="Chuẩn bị yêu cầu thi công Decal: chọn dịch vụ, khu vực, ngày mong muốn và mẫu sản phẩm. Gửi thông tin qua Zalo để iDecal tư vấn, xác nhận lịch.">
  <section class="booking-hero"><div class="container"><p class="booking-kicker">Cùng iDecal chuẩn bị công trình</p><h1 class="brand-heading">Đặt dịch vụ iDecal</h1><p>Chọn thiết kế, in, cắt, thi công hoặc trọn gói. Gửi yêu cầu qua Zalo để iDecal tư vấn phương án, báo giá và xác nhận lịch phù hợp.</p></div></section>
  <section class="container booking-layout">
    <div class="booking-form-card">
      <div class="booking-form-heading"><h2>Thông tin công trình</h2><p>Các mục có dấu <span aria-hidden="true">*</span> cần được điền.</p></div>
      <div id="booking-product-info" class="booking-product" hidden><span>Mẫu bạn quan tâm</span><strong id="booking-product-name"></strong><a id="booking-product-link" href="/san-pham">Xem lại sản phẩm →</a></div>
      <noscript><p>Để đặt dịch vụ, vui lòng <a href="https://zalo.me/0866077040">nhắn Zalo iDecal</a> và gửi tên, số điện thoại, địa chỉ cùng nhu cầu thi công.</p></noscript>
      <form id="booking-form" class="booking-form" hidden>
        <div class="booking-form-grid">
          <div><label for="booking-name">Họ và tên <span aria-hidden="true">*</span></label><input id="booking-name" name="name" autocomplete="name" required maxlength="80" placeholder="Tên người liên hệ" /></div>
          <div><label for="booking-phone">Số điện thoại <span aria-hidden="true">*</span></label><input id="booking-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required minlength="9" maxlength="20" placeholder="Số điện thoại liên hệ" /></div>
          <div><label for="booking-service">Dịch vụ <span aria-hidden="true">*</span></label><select id="booking-service" name="service" required><option value="">Chọn dịch vụ</option>{services.map(service=><option value={service.slug}>{service.name}</option>)}</select></div>
          <div><label for="booking-region">Khu vực thi công <span aria-hidden="true">*</span></label><select id="booking-region" name="region" required><option value="">Chọn khu vực</option>{regions.map(region=><option value={region.slug}>{region.name}</option>)}<option value="other">Khu vực khác</option></select></div>
          <div class="booking-full"><label for="booking-address">Địa chỉ công trình <span aria-hidden="true">*</span></label><input id="booking-address" name="address" autocomplete="street-address" required maxlength="250" placeholder="Số nhà, đường, phường/xã…" /></div>
          <div><label for="booking-date">Ngày mong muốn</label><input id="booking-date" name="date" type="date" /><p class="booking-field-note">Ngày đề xuất; iDecal sẽ trao đổi để xác nhận lịch.</p></div>
          <div><label for="booking-time">Khung giờ phù hợp</label><select id="booking-time" name="time"><option value="">Linh hoạt, cần trao đổi</option><option>Buổi sáng</option><option>Buổi chiều</option><option>Sau giờ làm việc</option></select></div>
          <div id="booking-pvc-options" class="booking-full booking-pvc-options" hidden><div><label for="booking-finish">Bề mặt Decal PVC <span aria-hidden="true">*</span></label><select id="booking-finish" name="finish" disabled><option value="">Chọn bề mặt</option>{pvcFinishes.map(finish => <option value={finish.value}>{finish.label}</option>)}</select></div><div><label for="booking-pvc-type">Hình thức mua</label><select id="booking-pvc-type" name="pvc-type" disabled><option value="cuon">Nguyên cuộn · 1,2 × 50 m</option><option value="cat-le">Cắt lẻ theo yêu cầu</option></select></div><p>Quy cách cuộn 1,2 × 50 m, cắt lẻ theo yêu cầu.</p></div>
          <div class="booking-full"><label for="booking-size">Kích thước / khối lượng dự kiến</label><input id="booking-size" name="size" maxlength="160" placeholder="Ví dụ: 4 ô kính, mỗi ô 1m × 2m; hoặc cần khảo sát" /></div>
          <div class="booking-full"><label for="booking-notes">Nhu cầu & ghi chú</label><textarea id="booking-notes" name="notes" rows="4" maxlength="1500" placeholder="Mẫu mong muốn, tình trạng kính, có lớp Decal cũ, yêu cầu về giờ thi công…"></textarea></div>
        </div>
        <p class="booking-send-note">Sau khi soạn yêu cầu, sao chép nội dung và gửi qua Zalo. Lịch thi công được xác nhận sau khi iDecal tiếp nhận và trao đổi với bạn.</p>
        <div class="booking-form-actions"><button type="submit" class="btn-primary-solid">Soạn yêu cầu đặt lịch <span aria-hidden="true">→</span></button><button type="reset" class="booking-reset">Điền lại</button></div>
      </form>
      <section id="booking-preview" class="booking-preview" hidden aria-labelledby="booking-preview-title"><h2 id="booking-preview-title" tabindex="-1">Yêu cầu đã được soạn</h2><p>Kiểm tra nội dung bên dưới, sao chép rồi mở Zalo để gửi cho iDecal.</p><label for="booking-message" class="sr-only">Nội dung yêu cầu đặt lịch</label><textarea id="booking-message" rows="11" readonly></textarea><div class="booking-preview-actions"><button id="booking-copy" type="button">1. Sao chép yêu cầu</button><a href="https://zalo.me/0866077040" target="_blank" rel="noopener noreferrer" class="btn-primary-solid">2. Mở Zalo gửi yêu cầu</a></div><p id="booking-copy-status" role="status" aria-live="polite"></p></section>
    </div>
    <aside class="booking-aside"><div><h2>iDecal sẽ hỗ trợ bạn</h2><ol><li><span aria-hidden="true">01</span><p>Tư vấn vật liệu và mẫu phù hợp với không gian.</p></li><li><span aria-hidden="true">02</span><p>Làm rõ kích thước, hiện trạng và phạm vi báo giá.</p></li><li><span aria-hidden="true">03</span><p>Thống nhất lịch khảo sát hoặc thi công trước khi thực hiện.</p></li></ol></div><div><h2>Chuẩn bị thêm khi trao đổi</h2><p>Ảnh toàn cảnh, ảnh cận bề mặt và file logo hoặc mẫu tham khảo giúp việc tư vấn nhanh hơn. Bạn có thể gửi các ảnh, file này trực tiếp qua Zalo.</p><a href="/dich-vu#bang-gia-dich-vu">Tham khảo bảng giá dịch vụ →</a></div></aside>
  </section>
  <script type="application/json" id="booking-product-data" set:html={JSON.stringify(productOptions).replaceAll('<', '\\u003c')} />
</Layout>
<script>import '../scripts/booking';</script>
