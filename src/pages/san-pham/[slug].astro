---
import '../../styles/catalogue.css';
import filmSpecifications from '../../data/film-specifications.json';
import RelatedGuides from '../../components/RelatedGuides.astro';
import Layout from '../../layouts/Layout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import '../../styles/product-extras.css';
import { isPVCProduct, pvcRollSize, pvcFinishes, pvcFinishImages } from '../../data/pvc-options';
import '../../styles/pvc-options.css';
import { products, productCategories, formatPrice, productSpecs, type Product } from '../../data/catalogue';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
interface Props { product: Product; }
const { product } = Astro.props;
const category = productCategories.find(group => group.slug === product.category)!;
const isPVC = isPVCProduct(product.slug);
const finishImages = pvcFinishImages(product.slug);
const collectionModels = (product.variantSlugs ?? []).map(slug => products.find(item => item.slug === slug)).filter((item): item is Product => Boolean(item));
const related = products.filter(other => other.slug !== product.slug && (
  product.catalogue ? other.catalogue?.collection === product.catalogue.collection && Boolean(product.catalogue.collection) : isPVC ? isPVCProduct(other.slug) : !isPVCProduct(other.slug) && other.category === product.category
)).slice(0,4);
const relatedCategoryUrl = `/danh-muc-san-pham/${isPVC ? 'decal-pvc' : category.slug}`;
const galleryImages = isPVC ? [
  ...pvcFinishes.map(finish => ({ src: finishImages[finish.value as keyof typeof finishImages], label: `${product.name} – minh họa bề mặt ${finish.label.toLocaleLowerCase('vi-VN')}`, finish: finish.value })),
  ...product.images.filter(src => !src.startsWith('/images/pvc-colors/')).map((src,index) => ({ src, label: product.catalogue?.label?.startsWith("SOLAR") ? `Bảng thông số catalogue: ${product.name}` : `${product.name} – ảnh ${index+1}`, finish: '' })),
] : product.images.map((src,index) => ({ src, label: product.catalogue?.label?.startsWith("SOLAR") ? `Bảng thông số catalogue: ${product.name}` : `${product.name} – ảnh ${index+1}`, finish: '' }));
const specs = productSpecs(product).filter(spec => spec.label !== 'Thương hiệu');
const normalizeText = (text: string) => text.replace(/\s+/g, ' ').trim();
const descriptionParagraphs = [...new Set([product.description, ...product.paragraphs].map(normalizeText))].filter(Boolean);
type FilmSpecs = Record<string, number | string | null>;
const filmSpecs = (filmSpecifications as Record<string, FilmSpecs>)[product.slug];
const filmFields = [
  { key: 'vlt', label: 'Độ truyền sáng (VLT)', unit: '%' },
  { key: 'irr', label: 'Cản tia hồng ngoại (IRR)', unit: '%' },
  { key: 'uvr', label: 'Cản tia UV (UVR)', unit: '%' },
  { key: 'tser', label: 'Tổng năng lượng mặt trời bị loại bỏ (TSER)', unit: '%' },
  { key: 'vlr', label: 'Độ phản gương (VLR)', unit: '%' },
  { key: 'thicknessMil', label: 'Độ dày phim', unit: 'mil' },
  { key: 'warrantyYears', label: 'Bảo hành', unit: 'năm' },
];
const shortDescription = product.description.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() || product.description;
const schema = { '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.description, image: galleryImages.map(image => new URL(image.src, Astro.site).href), category: category.name, ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}) };
---
<Layout title={`${product.name} | iDecal`} description={product.description.slice(0,170)} image={galleryImages[0].src}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', String.fromCharCode(92) + 'u003c')} />
  <section class="catalogue-detail py-10 md:py-14" data-product-detail data-pov={product.catalogue ? true : undefined}>
    <div class="container">

    <div class="product-detail-layout grid min-w-0 items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="product-gallery min-w-0"><div class="aspect-square overflow-hidden" data-main-gallery><ProductImage src={galleryImages[0].src} alt={galleryImages[0].label} eager /></div>{isPVC && <p class="pvc-gallery-note" data-pvc-gallery-status aria-live="polite">Bề mặt bóng · Hình minh họa, đối chiếu mẫu thật khi chọn màu.</p>}{galleryImages.length > 1 && <div class="mt-4 flex gap-3 overflow-x-auto pb-2" role="group" aria-label="Chọn ảnh sản phẩm">{galleryImages.map((image,index) => <button type="button" data-gallery-source={image.src} data-gallery-label={image.label} data-gallery-finish={image.finish || undefined} aria-pressed={index===0} aria-label={image.finish ? `Xem minh họa bề mặt ${image.finish === 'bong' ? 'bóng' : 'nhám (mờ)'}` : `Ảnh ${index+1}`} class="product-thumbnail h-20 w-20 shrink-0 overflow-hidden"><ProductImage src={image.src} alt={image.label} /></button>)}</div>}</div>
      <div class="product-summary min-w-0">
        <span class="product-code">Mã mẫu: {product.code}</span>
        <h1 class="product-detail-title brand-heading">{product.name}</h1>
        {product.price != null && <div class="mb-6"><p class="!mb-1 text-lg font-semibold text-brand-navy">{formatPrice(product.price)}</p><p class="!mb-0 text-xs">Giá tham khảo, xác nhận theo quy cách và khối lượng thực tế.</p></div>}
        <p class="product-short-description">{shortDescription}</p>
        {isPVC ? <form class="pvc-product-options" action="/lien-he-idecal" method="get"><input type="hidden" name="san-pham" value={product.slug} /><input type="hidden" name="dich-vu" value="cat-decal" /><p class="pvc-options-size">Quy cách cuộn <strong>{pvcRollSize}</strong><span>Cắt lẻ theo yêu cầu</span></p><fieldset><legend>Chọn bề mặt</legend><div class="pvc-finish-options">{pvcFinishes.map((finish,index) => <label><input type="radio" name="be-mat" value={finish.value} checked={index===0} required /><span>{finish.label}</span></label>)}</div></fieldset><div class="product-actions"><button type="submit" class="btn-primary-solid">Gửi yêu cầu mẫu <span aria-hidden="true">→</span></button><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Tư vấn qua Zalo</a></div></form> : <div class="product-actions"><a href="https://zalo.me/0866077040" class="btn-primary-solid">Tư vấn qua Zalo</a><a href={`/lien-he-idecal?san-pham=${encodeURIComponent(product.slug)}&dich-vu=${encodeURIComponent(category.service)}`} class="btn-idecal-bold">Đặt lịch thi công</a></div>}
        {product.catalogue && <div class="pov-source">{product.catalogue.note && <p class="pov-stock-note">{product.catalogue.note}</p>}<p>{product.catalogue.imageNote ?? "Ảnh mẫu từ catalogue POV 2025 · Đối chiếu mẫu thật trước khi đặt."}</p><a href={`${product.catalogue.pdf}#page=${product.catalogue.page}`} target="_blank" rel="noopener">Xem catalogue gốc · trang {product.catalogue.page} →</a>{product.catalogue.collection && <a href={`/san-pham/${product.catalogue.collection}`}>{product.catalogue.collectionLabel ?? "Xem đủ 23 mẫu POV"} →</a>}</div>}
        <div class="product-information" aria-label="Thông tin sản phẩm">
          <details class="product-information-item">
            <summary><h2>Mô tả sản phẩm</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content">{descriptionParagraphs.map(paragraph => <p>{paragraph}</p>)}</div>
          </details>
          <details class="product-information-item">
            <summary><h2>Ứng dụng</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content">{product.uses.length > 0 ? <ul class="list-disc space-y-2 pl-5">{product.uses.map(use => <li>{use}</li>)}</ul> : <p>Ứng dụng được tư vấn theo nhu cầu thực tế.</p>}</div>
          </details>
          <details class="product-information-item">
            <summary><h2>Quy cách &amp; thông tin</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content"><dl class="product-specs">{specs.map(spec => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl><p class="product-spec-note">Quy cách và vật liệu được xác nhận theo mẫu khi tư vấn.</p></div>
          </details>
          {filmSpecs && <details class="product-information-item" data-film-specifications>
            <summary><h2>Thông số phim cách nhiệt</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content"><dl class="product-specs">{filmFields.map(field => <div><dt>{field.label}</dt><dd>{filmSpecs[field.key] != null && filmSpecs[field.key] !== '' ? `${filmSpecs[field.key]} ${field.unit}` : 'Chưa cập nhật'}</dd></div>)}</dl>{product.catalogue && <p class="product-spec-note">Thông số theo catalogue nhà sản xuất, không phải mức giảm nhiệt độ hoặc tỷ lệ tiết kiệm điện. Hiệu quả phụ thuộc kính và điều kiện thi công.</p>}</div>
          </details>}
        </div>
        <a href={`/dich-vu/${category.service}`} class="product-service-link">Xem dịch vụ thi công liên quan →</a>
      </div>
    </div>
    </div>
  </section>
  {collectionModels.length > 0 && <section class="product-related" aria-labelledby="pov-models-title"><div class="container"><div class="product-extras-heading"><div><p>Catalogue {product.catalogue?.label ?? "POV 2025"}</p><h2 id="pov-models-title" class="brand-heading">{product.catalogue?.modelsTitle ?? "23 mẫu film trang trí kính"}</h2></div></div><div class="product-related-grid">{collectionModels.map(model => <ProductCard product={model} />)}</div></div></section>}
  {collectionModels.length === 0 && related.length > 0 && <section class="product-related" aria-labelledby="product-related-title"><div class="container"><div class="product-extras-heading"><div><p>Tham khảo thêm mẫu</p><h2 id="product-related-title" class="brand-heading">Sản phẩm cùng danh mục</h2></div><a href={relatedCategoryUrl}>Xem danh mục <span aria-hidden="true">→</span></a></div><div class="product-related-grid">{related.map(other => <ProductCard product={other} />)}</div></div></section>}
<RelatedGuides context={product.category+' '+product.slug} />
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-detail]').forEach(root => {
    const image = root.querySelector<HTMLImageElement>('[data-main-gallery] [data-product-photo]');
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-gallery-source]');
    const finishes = root.querySelectorAll<HTMLInputElement>('input[name="be-mat"]');
    const status = root.querySelector<HTMLElement>('[data-pvc-gallery-status]');
    const selectImage = (button: HTMLButtonElement) => {
      const src = button.dataset.gallerySource;
      if (!image || !src) return;
      image.hidden = false;
      image.alt = button.dataset.galleryLabel ?? image.alt;
      image.src = src;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      const finish = button.dataset.galleryFinish;
      if (finish) finishes.forEach(radio => { radio.checked = radio.value === finish; });
      if (status) status.textContent = finish
        ? `Bề mặt ${finish === 'bong' ? 'bóng' : 'nhám (mờ)'} · Hình minh họa, đối chiếu mẫu thật khi chọn màu.`
        : 'Ảnh sản phẩm tham khảo.';
    };
    buttons.forEach(button => button.addEventListener('click', () => selectImage(button)));
    const syncFinish = () => {
      const selected = Array.from(finishes).find(radio => radio.checked);
      const button = Array.from(buttons).find(item => item.dataset.galleryFinish === selected?.value);
      if (button) selectImage(button);
    };
    finishes.forEach(radio => radio.addEventListener('change', syncFinish));
    if (finishes.length) {
      syncFinish();
      window.addEventListener('pageshow', syncFinish);
    }
  });
</script>

<style>
:global([data-pov] [data-main-gallery] img){object-fit:contain}.pov-stock-note{color:#87602c!important;font-weight:500}.pov-source{margin:24px 0;font-size:13px;line-height:1.8;color:#5b7084}.pov-source p{font-size:12px;margin:0 0 8px}.pov-source a{display:block;color:#17668f;margin:6px 0;text-decoration:underline;text-underline-offset:3px}
</style>
