---
import '../../styles/catalogue.css';
import filmSpecifications from '../../data/film-specifications.json';
import Layout from '../../layouts/Layout.astro';
import ProductImage from '../../components/ProductImage.astro';
import { isPVCProduct, pvcRollSize, pvcFinishes } from '../../data/pvc-options';
import '../../styles/pvc-options.css';
import { products, productCategories, formatPrice, productSpecs, type Product } from '../../data/catalogue';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
interface Props { product: Product; }
const { product } = Astro.props;
const category = productCategories.find(group => group.slug === product.category)!;
const isPVC = isPVCProduct(product.slug);
const specs = productSpecs(product).filter(spec => spec.label !== 'Thương hiệu');
const normalizeText = (text: string) => text.replace(/\s+/g, ' ').trim();
const descriptionParagraphs = [...new Set([product.description, ...product.paragraphs].map(normalizeText))].filter(Boolean);
type FilmSpecs = Record<string, number | string | null>;
const filmSpecs = (filmSpecifications as Record<string, FilmSpecs>)[product.slug];
const filmFields = [
  { key: 'vlt', label: 'Độ truyền sáng (VLT)', unit: '%' },
  { key: 'irr', label: 'Cản tia hồng ngoại (IRR)', unit: '%' },
  { key: 'uvr', label: 'Cản tia UV (UVR)', unit: '%' },
  { key: 'tser', label: 'Tổng năng lượng mặt trời bị loại bỏ (TSER)', unit: '%' },
  { key: 'vlr', label: 'Độ phản gương (VLR)', unit: '%' },
  { key: 'thicknessMil', label: 'Độ dày phim', unit: 'mil' },
  { key: 'warrantyYears', label: 'Bảo hành', unit: 'năm' },
];
const shortDescription = product.description.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() || product.description;
const schema = { '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.description, image: product.images.map(image => new URL(image, Astro.site).href), category: category.name, ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}) };
---
<Layout title={`${product.name} | iDecal`} description={product.description.slice(0,170)} image={product.images[0]}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', String.fromCharCode(92) + 'u003c')} />
  <section class="catalogue-detail py-10 md:py-14" data-product-detail>
    <div class="container">

    <div class="product-detail-layout grid min-w-0 items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="product-gallery min-w-0"><div class="aspect-square overflow-hidden" data-main-gallery><ProductImage src={product.images[0]} alt={product.name} eager /></div>{product.images.length > 1 && <div class="mt-4 flex gap-3 overflow-x-auto pb-2" role="group" aria-label="Chọn ảnh sản phẩm">{product.images.map((image,index) => <button type="button" data-gallery-source={image} data-gallery-label={`${product.name} – ảnh ${index+1}`} aria-pressed={index===0} aria-label={`Ảnh ${index+1}`} class="product-thumbnail h-20 w-20 shrink-0 overflow-hidden"><ProductImage src={image} alt={`${product.name} – ảnh ${index+1}`} /></button>)}</div>}</div>
      <div class="product-summary min-w-0">
        <span class="product-code">Mã mẫu: {product.code}</span>
        <h1 class="product-detail-title brand-heading">{product.name}</h1>
        {product.price != null && <div class="mb-6"><p class="!mb-1 text-lg font-semibold text-brand-navy">{formatPrice(product.price)}</p><p class="!mb-0 text-xs">Giá tham khảo, xác nhận theo quy cách và khối lượng thực tế.</p></div>}
        <p class="product-short-description">{shortDescription}</p>
        {isPVC ? <form class="pvc-product-options" action="/dat-dich-vu" method="get"><input type="hidden" name="san-pham" value={product.slug} /><input type="hidden" name="dich-vu" value="cat-decal" /><p class="pvc-options-size">Quy cách cuộn <strong>{pvcRollSize}</strong><span>Cắt lẻ theo yêu cầu</span></p><fieldset><legend>Chọn bề mặt</legend><div class="pvc-finish-options">{pvcFinishes.map((finish,index) => <label><input type="radio" name="be-mat" value={finish.value} checked={index===0} required /><span>{finish.label}</span></label>)}</div></fieldset><div class="pvc-order-fields"><div><label for="pvc-order-type">Hình thức mua</label><select id="pvc-order-type" name="hinh-thuc"><option value="cuon">Nguyên cuộn · 1,2 × 50 m</option><option value="cat-le">Cắt lẻ theo yêu cầu</option></select></div><div><label for="pvc-cut-size">Kích thước cắt lẻ (nếu cần)</label><input id="pvc-cut-size" name="kich-thuoc" maxlength="160" placeholder="Ví dụ: rộng 1,2 m × dài 3 m" /></div></div><div class="product-actions"><button type="submit" class="btn-primary-solid">Gửi yêu cầu mẫu <span aria-hidden="true">→</span></button><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Tư vấn qua Zalo</a></div></form> : <div class="product-actions"><a href="https://zalo.me/0866077040" class="btn-primary-solid">Tư vấn qua Zalo</a><a href={`/dat-dich-vu?san-pham=${encodeURIComponent(product.slug)}&dich-vu=${encodeURIComponent(category.service)}`} class="btn-idecal-bold">Đặt lịch thi công</a></div>}
        <div class="product-information" aria-label="Thông tin sản phẩm">
          <details class="product-information-item">
            <summary><h2>Mô tả sản phẩm</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content">{descriptionParagraphs.map(paragraph => <p>{paragraph}</p>)}</div>
          </details>
          <details class="product-information-item">
            <summary><h2>Ứng dụng</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content">{product.uses.length > 0 ? <ul class="list-disc space-y-2 pl-5">{product.uses.map(use => <li>{use}</li>)}</ul> : <p>Ứng dụng được tư vấn theo nhu cầu thực tế.</p>}</div>
          </details>
          <details class="product-information-item">
            <summary><h2>Quy cách &amp; thông tin</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content"><dl class="product-specs">{specs.map(spec => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl><p class="product-spec-note">Quy cách và vật liệu được xác nhận theo mẫu khi tư vấn.</p></div>
          </details>
          {filmSpecs && <details class="product-information-item" data-film-specifications>
            <summary><h2>Thông số phim cách nhiệt</h2><span aria-hidden="true">+</span></summary>
            <div class="product-information-content"><dl class="product-specs">{filmFields.map(field => <div><dt>{field.label}</dt><dd>{filmSpecs[field.key] != null && filmSpecs[field.key] !== '' ? `${filmSpecs[field.key]} ${field.unit}` : 'Chưa cập nhật'}</dd></div>)}</dl></div>
          </details>}
        </div>
        <a href={`/dich-vu/${category.service}`} class="product-service-link">Xem dịch vụ thi công liên quan →</a>
      </div>
    </div>
    </div>
  </section>
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-detail]').forEach(root => {
    const image = root.querySelector<HTMLImageElement>('[data-main-gallery] [data-product-photo]');
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-gallery-source]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const src = button.dataset.gallerySource;
      if (!image || !src) return;
      image.hidden = false;
      image.alt = button.dataset.galleryLabel ?? image.alt;
      image.src = src;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    }));
  });
</script>
