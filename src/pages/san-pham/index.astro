---
import Layout from '../../layouts/Layout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import { products, productCategories, productsInCategory } from '../../data/catalogue';
---
<Layout title="Sản phẩm decal dán kính, phim cách nhiệt & film nội thất | iDecal" description="Khám phá 74 mẫu trong 6 nhóm sản phẩm iDecal: decal mờ dán kính, phim cách nhiệt, film nội thất, cắt in logo, open time và quảng cáo. Xem mẫu, so sánh và tư vấn báo giá.">
  <section class="brand-dark bg-brand-navy bg-brand-pattern py-14 md:py-20">
    <div class="container">
      <nav aria-label="Đường dẫn" class="mb-8 flex gap-2 text-sm text-brand-inverse"><a href="/" class="text-brand-highlight">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Sản phẩm</span></nav>
      <div class="grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="!mb-4 text-xs uppercase tracking-widest text-brand-highlight">Sản phẩm iDecal</p>
          <h1 class="text-3xl font-semibold !text-white md:text-5xl">Decal dán kính, phim cách nhiệt & film nội thất</h1>
          <p class="mb-8 max-w-2xl text-brand-inverse">6 nhóm sản phẩm cho văn phòng, showroom, cửa hàng và nhà ở. Chọn nhóm để xem mẫu, thông tin vật liệu và giá tham khảo, hoặc tìm nhanh mẫu bạn cần trong catalogue.</p>
          <div class="flex flex-wrap items-center gap-5"><a href="#danh-muc" class="btn-primary-solid">Khám phá nhóm sản phẩm <span aria-hidden="true">↓</span></a><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Nhận tư vấn qua Zalo</a></div>
          <div class="mt-8 flex gap-8 border-t border-white/15 pt-6"><div><span class="block text-3xl font-semibold text-white">{products.length}</span><span class="text-xs text-brand-inverse">mẫu trong catalogue</span></div><div><span class="block text-3xl font-semibold text-white">{productCategories.length}</span><span class="text-xs text-brand-inverse">nhóm sản phẩm</span></div></div>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-white/20"><ProductImage src={productCategories[0].image} alt="Decal mờ chuyển màu cho vách kính văn phòng" eager /></div>
      </div>
    </div>
  </section>
  <section id="danh-muc" class="container scroll-mt-24 py-14 md:py-20">
    <p class="!mb-3 text-xs uppercase tracking-widest text-primary">Danh mục</p><h2 class="brand-heading">Chọn nhóm sản phẩm của bạn</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {productCategories.map((category,index) => <article class="category-card group overflow-hidden rounded-2xl border border-border bg-white transition-shadow hover:shadow-brand">
        <a href={`/danh-muc-san-pham/${category.slug}`} class="flex h-full flex-col">
          <div class="relative aspect-[16/10]"><ProductImage src={category.image} alt={category.name} /><span class="absolute left-4 top-4 rounded bg-white/95 px-3 py-1 text-xs font-medium text-primary">{String(index+1).padStart(2,'0')}</span></div>
          <div class="flex flex-1 flex-col p-6"><h3 class="text-xl font-semibold">{category.name}</h3><p class="mb-6 text-sm">{category.description}</p><div class="mt-auto flex items-center justify-between gap-3 text-sm"><span class="text-text-muted">{productsInCategory(category.slug).length} mẫu</span><span class="font-medium text-primary">Xem nhóm sản phẩm →</span></div></div>
        </a>
      </article>)}
    </div>
  </section>
  <div class="bg-surface"><ProductCatalog items={products} /></div>
  <section class="container py-14 md:py-20"><div class="brand-dark rounded-3xl bg-brand-navy bg-brand-pattern px-6 py-12 text-center md:px-12"><h2 class="text-white">Chưa biết chọn loại nào?</h2><p class="mx-auto mb-8 max-w-2xl text-brand-inverse">Gửi ảnh kính, kích thước và nhu cầu sử dụng. iDecal sẽ tư vấn vật liệu, mẫu phù hợp và phạm vi báo giá cho công trình của bạn.</p><div class="flex flex-wrap justify-center gap-5"><a href="tel:0866077040" class="btn-primary-solid">Gọi 0866.077.040</a><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Nhắn Zalo</a></div></div></section>
</Layout>
