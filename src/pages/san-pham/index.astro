---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductImage from '../../components/ProductImage.astro';
import { products, productsInCategory } from '../../data/catalogue';
import { landingProducts } from '../../data/site-offerings';
import { catalogueGroups } from '../../data/catalogue-groups';

const groups = catalogueGroups.map(category => ({
  ...category,
  products: 'select' in category ? landingProducts(category) : productsInCategory(category.slug),
}));
const totalGroups = groups.length;
// Show locally hosted images first so the initial grid can load without an external image host.
const hasLocalImage = (src = '') => src.startsWith('/') && !src.startsWith('//');
const displayProducts = [...products].sort((a, b) =>
  Number(hasLocalImage(b.images[0])) - Number(hasLocalImage(a.images[0]))
);
const labels = new Intl.Collator('vi');
const brandKey = (brand: string) => brand.trim().toLocaleLowerCase('vi');
const brands = new Map<string, string>();
const groupsByProduct = new Map<string, string[]>();
for (const product of products) {
  const key = brandKey(product.brand ?? '');
  if (key && !brands.has(key)) brands.set(key, product.brand.trim());
}
for (const group of groups) {
  for (const product of group.products) {
    const memberships = groupsByProduct.get(product.slug) ?? [];
    memberships.push(group.slug);
    groupsByProduct.set(product.slug, memberships);
  }
}
const sortedBrands = [...brands].sort((a, b) => labels.compare(a[1], b[1]));
---
<Layout
  title="Sản phẩm decal dán kính, phim cách nhiệt & film nội thất | iDecal"
  description={`Khám phá ${totalGroups} nhóm sản phẩm iDecal: Decal mờ, Decal PVC, phim cách nhiệt, film nội thất và các vật liệu trang trí, bảo vệ.`}
>
  <section class="shop-intro" aria-labelledby="materials-title">
    <div class="container shop-intro-copy">
      <nav aria-label="Đường dẫn trang"><a href="/">Trang chủ</a><span aria-hidden="true"> / </span><span aria-current="page">Sản phẩm</span></nav>
      <h1 id="materials-title">Decal dán kính, phim cách nhiệt &amp; film nội thất</h1>
      <p>Chọn vật liệu cho văn phòng, showroom, cửa hàng và nhà ở. Mỗi nhóm có mẫu, thông tin vật liệu và giá tham khảo.</p>
    </div>
    <figure class="shop-intro-photo">
      <ProductImage src="/images/van-phong/office-glass-01.webp" alt="Vách kính văn phòng dán Decal mờ" eager />
    </figure>
  </section>

  <section id="danh-muc" class="container shop-layout" data-shop aria-label="Catalogue sản phẩm">
    <aside class="shop-sidebar">
      <details class="shop-filters" data-shop-filters open hidden>
        <summary>Bộ lọc sản phẩm</summary>
        <form data-shop-form>
          <label>Tìm sản phẩm
            <input name="q" type="search" placeholder="Tên hoặc mã mẫu" />
          </label>
          <label>Danh mục
            <select name="danh-muc">
              <option value="">Tất cả danh mục</option>
              {groups.filter(group => group.products.length).map(group => <option value={group.slug}>{group.name} ({group.products.length})</option>)}
            </select>
          </label>
          <label>Thương hiệu
            <select name="thuong-hieu">
              <option value="">Tất cả thương hiệu</option>
              {sortedBrands.map(([key, label]) => <option value={key}>{label}</option>)}
            </select>
          </label>
          <label>Giá tham khảo
            <select name="gia">
              <option value="">Tất cả mức giá</option>
              <option value="under-100">Dưới 100.000 ₫</option>
              <option value="100-300">100.000–300.000 ₫</option>
              <option value="over-300">Trên 300.000 ₫</option>
              <option value="quote">Liên hệ báo giá</option>
            </select>
          </label>
          <button type="reset">Xóa bộ lọc</button>
        </form>
      </details>
      <details class="shop-categories">
        <summary>Xem trang danh mục</summary>
        <ul>{groups.map(group => <li><a href={`/${group.slug}/`}>{group.name}</a></li>)}</ul>
      </details>
    </aside>

    <div class="shop-results">
      <div class="shop-toolbar">
        <h2>Tất cả sản phẩm</h2>
        <label class="shop-sort" data-shop-sort hidden>Sắp xếp
          <select name="sap-xep">
            <option value="">Mặc định</option>
            <option value="price-asc">Giá thấp đến cao</option>
            <option value="price-desc">Giá cao đến thấp</option>
            <option value="name">Tên A–Z</option>
          </select>
        </label>
      </div>
      <p class="shop-count" data-shop-count role="status">{products.length} sản phẩm</p>
      <div class="shop-grid" data-shop-grid>
        {displayProducts.map(product => (
          <div data-shop-item data-groups={groupsByProduct.get(product.slug)?.join(' ')} data-brand={brandKey(product.brand ?? '')} data-code={product.code}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>
      <div class="shop-empty" data-shop-empty hidden>
        <p>Không tìm thấy sản phẩm phù hợp.</p>
        <button type="button" data-shop-clear>Xóa bộ lọc</button>
      </div>
      <button type="button" class="shop-more" data-shop-more hidden>Xem thêm sản phẩm</button>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/catalogue-filter';
</script>

<style>
  .shop-intro { position: relative; isolation: isolate; overflow: hidden; background: #f1f6f7; border-bottom: 1px solid #dce7ef; }
  .shop-intro-copy { padding-block: clamp(28px, 4.5vw, 64px); }
  .shop-intro-copy nav { margin-bottom: 16px; color: #405875; font-size: .875rem; }
  .shop-intro-copy h1 { max-width: 28ch; margin: 0 0 12px; }
  .shop-intro-copy p { max-width: 60ch; margin: 0; }
  .shop-intro-photo { display: none; }
  .shop-layout { display: grid; grid-template-columns: minmax(210px, 245px) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); padding-block: 36px 64px; scroll-margin-top: 108px; }
  .shop-sidebar { min-width: 0; }
  .shop-filters, .shop-categories { border: 1px solid #dce7ef; border-radius: 14px; background: #fff; }
  .shop-categories { margin-top: 12px; }
  .shop-sidebar summary { padding: 14px 16px; cursor: pointer; font-weight: 700; color: #10293f; }
  .shop-sidebar form, .shop-categories ul { display: grid; gap: 14px; margin: 0; padding: 0 16px 16px; }
  .shop-categories ul { list-style: none; gap: 4px; }
  .shop-categories a { display: flex; min-height: 48px; align-items: center; }
  .shop-layout label { display: grid; gap: 6px; font-size: .875rem; font-weight: 650; color: #10293f; }
  .shop-layout :is(input,select,button) { min-height: 48px; border: 1px solid #a8bed2; border-radius: 8px; padding: 8px 10px; color: #10293f; background: #fff; }
  .shop-layout :is(input,select) { width: 100%; min-width: 0; font-size: 1rem; }
  .shop-layout button:hover { border-color: #006edc; color: #0056b3; }
  .shop-layout :is(input,select,button,summary):focus-visible { outline: 2px solid #006edc; outline-offset: 3px; }
  .shop-toolbar { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .shop-toolbar h2 { margin: 0; }
  .shop-count { margin: 8px 0 20px; font-size: .9375rem; }
  .shop-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .shop-grid > div { min-width: 0; }
  .shop-grid :global(.product-card-footer) { flex-wrap: wrap; }
  .shop-more { display: block; margin: 24px auto 0; }
  .shop-empty { padding: 24px; border: 1px solid #dce7ef; border-radius: 12px; background: #f1f6f7; }
  .shop-layout [hidden] { display: none !important; }

  @media (min-width: 1024px) {
    .shop-intro-copy { min-height: 230px; }
    .shop-intro-photo { display: block; position: absolute; z-index: -1; inset: 0 0 0 auto; width: 44%; margin: 0; clip-path: ellipse(68% 78% at 68% 18%); mask-image: linear-gradient(to right, transparent, #000 35%); }
    .shop-intro-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  }
  @media (max-width: 1023px) { .shop-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .shop-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 24px 40px; }
    .shop-grid { gap: 12px; }
  }
</style>
