---
import Layout from '../../layouts/Layout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
import { products } from '../../data/catalogue';
import { catalogueGroups } from '../../data/catalogue-groups';
---
<Layout
  title="Sản phẩm decal dán kính, phim cách nhiệt & film nội thất | iDecal"
  description={`Khám phá ${catalogueGroups.length} nhóm sản phẩm iDecal: Decal mờ, Decal PVC, phim cách nhiệt, film nội thất và các vật liệu trang trí, bảo vệ.`}
>
  <ProductCatalog items={products} heading="Tất cả sản phẩm" showGroups />
</Layout>
