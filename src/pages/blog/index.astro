---
import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getCollection } from 'astro:content';
const posts=await getCollection('blog');
const description='Hướng dẫn, so sánh vật liệu, mẫu thiết kế, thông tin báo giá và cập nhật ưu đãi Decal, film tại iDecal.';
---
<Layout title="Blog iDecal | Kiến thức, mẫu thiết kế & báo giá" description={description}><BlogListing posts={posts} title="Blog iDecal" description={description} /></Layout>
