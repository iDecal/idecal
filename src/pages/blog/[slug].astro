---
import BlogPostCard from '../../components/BlogPostCard.astro';
import { parseFragment } from 'parse5';
import {presentBlogImages} from '../../data/blog-image-presentation';
import { relatedGuides } from '../../data/content-topics';
import { expandSeoTemplate } from '../../data/seo';
import Layout from '../../layouts/Layout.astro';
import InstallationPhotoGallery from '../../components/InstallationPhotoGallery.astro';
import { uploadedBlogPhotos, getInstallationPhotos } from '../../data/installation-photo-links';
import '../../styles/blog.css';
import { getCollection, render } from 'astro:content';
import { blogCategories, postCategory } from '../../data/blog-categories';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const category = postCategory(entry);
const additionalPhotoNumbers=uploadedBlogPhotos[entry.id]??[];
const additionalPhotos=getInstallationPhotos(additionalPhotoNumbers);

// Render nội dung từ Content Layer
const { Content, headings } = await render(entry);
// Keep the original first paragraph in place, and insert the TOC after it.
// Posts that begin directly with a heading use their existing summary as the intro.
const articleHtml=presentBlogImages(entry.rendered?.html,entry.id);
let introEnd=0;
if(articleHtml){
  const fragment=parseFragment(articleHtml,{sourceCodeLocationInfo:true});
  for(const node of fragment.childNodes){
    if(!('tagName' in node))continue;
    if(/^h[1-6]$/.test(node.tagName))break;
    const location=node.sourceCodeLocation;
    if(node.tagName==='p'&&location&&articleHtml.slice(location.startOffset,location.endOffset).replace(/<[^>]+>/g,'').replace(/&nbsp;/g,' ').trim()){
      introEnd=location.endOffset;break;
    }
  }
}
const introHtml=introEnd?articleHtml?.slice(0,introEnd):undefined;
const remainingHtml=introEnd?articleHtml?.slice(introEnd):articleHtml;

// Lấy bài viết liên quan
const allPosts = await getCollection('blog');
const relatedPosts = relatedGuides(allPosts,{topics:entry.data.contentTopics,context:entry.data.focusKeyword??entry.data.title,exclude:entry.id});

const seoTitle=expandSeoTemplate(entry.data.seoTitle ?? entry.data.title,{title:entry.data.title,description:entry.data.description});
const seoDescription=expandSeoTemplate(entry.data.seoDescription ?? entry.data.description,{title:entry.data.title,description:entry.data.description});
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const articleSchema={'@type':'BlogPosting','@id':canonical+'#article',headline:entry.data.title,description:seoDescription,datePublished:entry.data.pubDate.toISOString(),...(entry.data.updatedDate?{dateModified:entry.data.updatedDate.toISOString()}:{}),image:[new URL(entry.data.image,Astro.site).href,...additionalPhotos.map(photo=>new URL(photo.src,Astro.site).href)],author:{'@type':entry.data.author && entry.data.author!=='iDecal'?'Person':'Organization',name:entry.data.author ?? 'iDecal'},publisher:{'@id':new URL('/#organization',Astro.site).href},mainEntityOfPage:{'@type':'WebPage','@id':canonical},inLanguage:'vi-VN',articleSection:category.name};

---

<Layout title={seoTitle} description={seoDescription} image={entry.data.image} type="article" publishedTime={entry.data.pubDate.toISOString()} modifiedTime={entry.data.updatedDate?.toISOString()} structuredData={[articleSchema]}>
  <div class="blog-detail container">
    <a class="blog-back" href="/blog">← Trở lại Blog</a>
    <div class="blog-article-layout">
      <article class="blog-article">
        <header class="blog-article-header">
          <div class="blog-card-meta"><a href={`/blog/chuyen-muc/${category.slug}`}>{category.name}</a><time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</time>{entry.data.updatedDate&&<span>Cập nhật {entry.data.updatedDate.toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</span>}</div>
          <h1>{entry.data.title}</h1>
        </header>
        <img class="blog-article-cover" src={entry.data.image} alt={entry.data.title} width="1000" height="625" fetchpriority="high" />
        <div class="blog-article-body">
          {introHtml?<Fragment set:html={introHtml} />:<p class="blog-article-intro">{entry.data.description}</p>}
          {headings.length>0&&<details class="blog-toc" data-heading-theme="dark"><summary><span class="blog-toc-label"><svg class="blog-toc-icon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01" stroke-width="3"/></svg><span>Mục lục bài viết</span></span><svg class="blog-toc-toggle" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></summary><nav aria-label="Mục lục bài viết">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} class={h.depth===3?'blog-toc-child':'blog-toc-section'} data-toc-depth={h.depth}>{h.depth===2&&<svg class="blog-toc-section-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12v14H4zM7 7h6M7 10h6M7 13h3"/></svg>}<span>{h.text}</span></a>)}{additionalPhotos.length>0&&<a href="#anh-thi-cong-bo-sung" class="blog-toc-section" data-toc-depth="2"><svg class="blog-toc-section-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h12v14H4zM7 7h6M7 10h6M7 13h3"/></svg><span>Ảnh công trình cùng chủ đề</span></a>}</nav></details>}
          {remainingHtml!==undefined?<Fragment set:html={remainingHtml} />:<Content />}
        </div>
        <InstallationPhotoGallery numbers={additionalPhotoNumbers} heading="Ảnh công trình iDecal cùng chủ đề" />
        <div class="blog-contact"><div><h2>Cần tư vấn cho không gian của bạn?</h2><p>Gửi hình ảnh và kích thước để iDecal tư vấn vật liệu, thiết kế và thi công.</p></div><a class="btn-primary-solid" href="/lien-he-idecal">Liên hệ iDecal →</a></div>
      </article>
      <aside class="blog-sidebar">
        <nav class="blog-sidebar-categories" aria-label="Chuyên mục bài viết"><h2>Khám phá chuyên mục</h2>{blogCategories.map(item=><a href={`/blog/chuyen-muc/${item.slug}`} aria-current={category.slug===item.slug?'page':undefined}>{item.name}<span aria-hidden="true">→</span></a>)}</nav>
      </aside>
    </div>
    {relatedPosts.length>0&&<section class="blog-related"><div class="blog-section-title"><h2>Bài cùng chủ đề</h2><a href={`/blog/chuyen-muc/${category.slug}`}>Xem thêm →</a></div><div class="blog-post-grid">{relatedPosts.map(post=><BlogPostCard post={post} heading="h3" />)}</div></section>}
  </div>
</Layout>
