---
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.css';
import { getCollection, render } from 'astro:content';
import { blogCategories, postCategory } from '../../data/blog-categories';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const category = postCategory(entry);

// Render nội dung từ Content Layer
const { Content, headings } = await render(entry);

// Lấy bài viết liên quan
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => postCategory(p).slug === category.slug && p.id !== entry.id)
  .slice(0, 3);
---

<Layout title={entry.data.title} description={entry.data.description} image={entry.data.image}>
  <div class="blog-detail container">
    <a class="blog-back" href="/blog">← Trở lại Blog</a>
    <div class="blog-article-layout">
      <article class="blog-article">
        <header class="blog-article-header">
          <div class="blog-card-meta"><a href={`/blog/chuyen-muc/${category.slug}`}>{category.name}</a><time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</time></div>
          <h1>{entry.data.title}</h1><p class="blog-article-intro">{entry.data.description}</p>
        </header>
        <img class="blog-article-cover" src={entry.data.image} alt={entry.data.title} width="1000" height="625" fetchpriority="high" />
        <div class="blog-article-body"><Content /></div>
        <div class="blog-contact"><div><h2>Cần tư vấn cho không gian của bạn?</h2><p>Gửi hình ảnh và kích thước để iDecal tư vấn vật liệu, thiết kế và thi công.</p></div><a class="btn-primary-solid" href="/lien-he-idecal">Liên hệ iDecal →</a></div>
      </article>
      <aside class="blog-sidebar">
        {headings.length>0&&<details class="blog-toc" open><summary>Mục lục bài viết</summary><nav aria-label="Mục lục bài viết">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} class={h.depth===3?'blog-toc-child':undefined}>{h.text}</a>)}</nav></details>}
        <nav class="blog-sidebar-categories" aria-label="Chuyên mục bài viết"><h2>Khám phá chuyên mục</h2>{blogCategories.map(item=><a href={`/blog/chuyen-muc/${item.slug}`} aria-current={category.slug===item.slug?'page':undefined}>{item.name}<span aria-hidden="true">→</span></a>)}</nav>
      </aside>
    </div>
    {relatedPosts.length>0&&<section class="blog-related"><div class="blog-section-title"><h2>Cùng chuyên mục</h2><a href={`/blog/chuyen-muc/${category.slug}`}>Xem thêm →</a></div><div class="blog-post-grid">{relatedPosts.map(post=><article class="post-card"><a class="blog-card-image" href={`/blog/${post.id}`}><img src={post.data.image} alt={post.data.title} width="800" height="500" loading="lazy" /></a><div class="blog-card-content"><h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3><a class="blog-read-link" href={`/blog/${post.id}`}>Đọc bài viết <span aria-hidden="true">→</span></a></div></article>)}</div></section>}
  </div>
</Layout>
