---
import Layout from '../layouts/Layout.astro';
import SiteSearchForm from '../components/SiteSearchForm.astro';
import RecoveryLinks from '../components/RecoveryLinks.astro';
import '../styles/site-search.css';
import '../styles/recovery-404.css';
---
<Layout title="404 – Không tìm thấy trang | iDecal" description="Tìm lại sản phẩm, dịch vụ hoặc bài viết bạn cần trên iDecal." canonicalURL="https://idecal.vn/404.html" noindex>
  <div class="recovery-scene">
    <section class="container recovery-page">
      <div class="recovery-hero">
        <div class="recovery-copy">
          <p class="recovery-badge" data-heading-label><span aria-hidden="true"></span>404 · Đường dẫn không tồn tại</p>
          <h1>Không tìm thấy trang này</h1>
          <p class="recovery-lead">Đường dẫn có thể đã thay đổi. Tìm sản phẩm, dịch vụ hoặc khám phá thêm ý tưởng cho không gian của bạn.</p>
          <SiteSearchForm inputId="not-found-search" />
          <div class="search-suggestions"><span>Gợi ý:</span><a href="/tim-kiem/?q=decal+mo">Decal mờ</a><a href="/tim-kiem/?q=phim+cach+nhiet">Phim cách nhiệt</a><a href="/tim-kiem/?q=thang+may">Dán decal thang máy</a></div>
          <div class="recovery-actions"><a href="/" class="btn-idecal-bold">← Về trang chủ</a><a href="/lien-he-idecal/" class="btn-idecal-bold">Liên hệ iDecal →</a></div>
        </div>
        <div class="recovery-visual" aria-label="Gợi ý decal và film cho không gian">
          <p class="recovery-code" aria-hidden="true">404</p>
          <span class="recovery-orbit" aria-hidden="true"></span>
          <span class="recovery-dots" aria-hidden="true"></span>
          <a class="recovery-photo recovery-photo-primary" href="/film-trang-tri-kinh/" aria-label="Khám phá decal và film trang trí kính">
            <img src="/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-to.webp" alt="Decal vân sóng 3D màu trà trang trí kính" width="768" height="768" fetchpriority="high" decoding="async" />
            <span class="recovery-photo-caption"><span>Decal trang trí kính</span><span aria-hidden="true">→</span></span>
          </a>
          <a class="recovery-photo recovery-photo-secondary" href="/film-dan-noi-that/" aria-label="Khám phá film dán nội thất">
            <img src="/images/film-noi-that/dan-film-noi-that-mat-ban.jpg" alt="Không gian nội thất với bề mặt bàn màu gỗ" width="1280" height="820" decoding="async" />
            <span class="recovery-photo-caption"><span>Film nội thất</span><span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
      <div class="recovery-discover"><p>Hoặc khám phá nhanh</p><RecoveryLinks /></div>
    </section>
  </div>
</Layout>
