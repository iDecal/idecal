---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import '@fontsource-variable/lexend';
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interVietnamese from '@fontsource-variable/inter/files/inter-vietnamese-wght-normal.woff2?url';
import interExtended from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import '../styles/homepage/source.css';
import '../styles/homepage/compat.css';
import publicHomepage from '../content/homepage/public.html?raw';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVietnamese} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interExtended} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/idecal-logo.png" />
    <link rel="preload" href="/fonts/google-sans-flex/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans-flex/google-sans-flex-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    <SEO title="Dịch vụ Decal dán kính cách nhiệt & Decal mờ trang trí | iDecal©" description="Chúng tôi cung cấp giải pháp trang trí kính & Dịch vụ decal dán kính cách nhiệt toàn diện. iDecal chuyên giải pháp Decal trang trí & Chống nóng toàn diện." image="/images/Banner/Dich-vu-decal-dan-kinh-cach-nhiet.webp" />
  </head>
  <body class="bg-background font-body text-secondary">
    <Header />
    <div class="homepage-original home gspbody gspb-bodyfront greenshift-theme"><div class="wp-site-blocks">
    <Fragment set:html={publicHomepage} />
    </div></div>
    <Footer />
    <script>import '../scripts/homepage';</script>
  </body>
</html>
