---
import SubmenuIcon from './SubmenuIcon.astro';
import { regions } from '../data/regions';
import { blogCategories } from '../data/blog-categories';
const megaGroups = [
  { title: 'Giải pháp & Vật liệu', all: '/san-pham', allLabel: 'Xem tất cả vật liệu', items: [
    { name: 'Decal mờ văn phòng', href: '/danh-muc-san-pham/decal-mo-dan-kinh', description: 'Riêng tư cho phòng họp, kết hợp logo và họa tiết.' },
    { name: 'Phim cách nhiệt nhà kính', href: '/danh-muc-san-pham/phim-cach-nhiet-nha-kinh', description: 'Chọn phim theo hướng nắng và độ sáng mong muốn.' },
    { name: 'Film dán nội thất', href: '/danh-muc-san-pham/film-dan-noi-that', description: 'Làm mới tủ, cửa, bàn với nhiều vân bề mặt.' },
    { name: 'Film bảo vệ nội thất', href: '/danh-muc-san-pham/film-bao-ve-noi-that', description: 'Bảo vệ bề mặt; tư vấn theo vật liệu nền.' },
    { name: 'Decal 3D & film trang trí kính', href: '/danh-muc-san-pham/film-trang-tri-kinh', description: 'Vân sóng, họa tiết và hiệu ứng trang trí ô kính.' },
    { name: 'Decal quảng cáo', href: '/danh-muc-san-pham/decal-quang-cao', description: 'Logo, thông điệp và hình ảnh cho cửa hàng.' },
  ] },
  { title: 'Kỹ thuật & Gia công', all: '/dich-vu', allLabel: 'Xem tất cả dịch vụ', items: [
    { name: 'Thiết kế file & phối mẫu', href: '/dich-vu/thiet-ke', description: 'Dàn logo, họa tiết theo kích thước thực tế.' },
    { name: 'In decal khổ lớn', href: '/dich-vu/in-decal', description: 'In theo thiết kế, chọn cách hoàn thiện phù hợp.' },
    { name: 'Cắt bế decal vector', href: '/dich-vu/cat-decal', description: 'Gia công chữ, logo và họa tiết theo đường cắt.' },
    { name: 'Thi công dán tận nơi', href: '/dich-vu/thi-cong-decal', description: 'Khảo sát, xử lý bề mặt và kiểm tra bàn giao.' },
  ] },
];

interface NavLink {
  name: string;
  href: string;
  mega?: boolean;
  dropdown?: { name: string; href: string; highlight?: boolean; showIcon?: boolean }[];
}
const navLinks: NavLink[] = [
  { name: 'Giới thiệu', href: '/gioi-thieu-idecal' },
  { name: 'Dịch vụ & Giải pháp', href: '/dich-vu', mega: true, dropdown: [] },
  { name: 'Công trình thực tế', href: '/du-an' },
  { name: 'Blog', href: '/blog', dropdown: blogCategories.map(category => ({ name: category.name, href: `/blog/chuyen-muc/${category.slug}`, showIcon: false })) },
  { name: 'Khu vực', href: '/khu-vuc', dropdown: [
    ...regions.map(region => ({ name: region.name, href: `/khu-vuc/${region.slug}` })),
  ] },
  { name: 'Liên hệ', href: '/lien-he-idecal' },
];
---

<nav class="sticky top-0 w-full z-[100] bg-white border-b border-border">
  <div class="container mx-auto px-4 relative">
    <div class="flex justify-between items-center gap-4 h-[80px] xl:h-[96px]">
      
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center group">
          <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-12 w-auto object-contain" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex flex-1 justify-center items-center gap-3 xl:gap-6">
        {navLinks.map((link) => (
          <div class={`${link.mega ? 'mega-root' : 'relative group'} py-6`}>
            {link.mega ? (
              <>
                <button id="mega-trigger" type="button" aria-expanded="false" aria-controls="desktop-mega" class="mega-trigger text-[13px] xl:text-base font-medium text-brand-navy hover:text-primary flex items-center gap-1.5 whitespace-nowrap">
                  {link.name}<svg aria-hidden="true" class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg>
                </button>
                <div id="desktop-mega" hidden inert class="desktop-mega">
                  <div class="mega-columns">
                    {megaGroups.map(group => (
                      <section class="mega-column" aria-label={group.title}>
                        <p class="mega-heading">{group.title}</p>
                        <div class="mega-items">{group.items.map(item => (
                          <a href={item.href} class="mega-item"><span>{item.name}</span><small>{item.description}</small></a>
                        ))}</div>
                        <a class="mega-all" href={group.all}>{group.allLabel} →</a>
                      </section>
                    ))}
                  </div>
                  <div class="mega-cta"><div><p>Chưa biết chọn vật liệu nào?</p><small>Gửi ảnh hiện trạng và kích thước để được tư vấn.</small></div><a href="/lien-he-idecal">Nhận tư vấn & báo giá →</a></div>
                </div>
              </>
            ) : (<>
            <a 
              href={link.href} 
              class="text-[13px] xl:text-base font-medium text-brand-navy hover:text-primary transition-colors flex items-center gap-1.5 whitespace-nowrap"
            >
              {link.name}
              {link.dropdown && <svg aria-hidden="true" class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg>}
            </a>
            {link.dropdown && (
              <div class="absolute top-[90%] left-0 w-72 bg-white shadow-2xl rounded-2xl border border-border p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all transform translate-y-2 group-hover:translate-y-0">
                {link.dropdown.map((sub) => (
                  <a href={sub.href} class={`flex items-center gap-3 px-3 py-2.5 text-sm rounded-xl transition-all font-medium ${sub.highlight ? 'bg-brand-navy/5 text-brand-navy font-bold mb-2' : 'text-secondary hover:bg-surface hover:text-brand-navy'}`}>
                    {sub.showIcon !== false && <SubmenuIcon href={sub.href} />}<span>{sub.name}</span>
                  </a>
                ))}
              </div>
            )}
            </>)}
          </div>
        ))}
      </div>

      <a href="tel:0866077040" aria-label="Gọi iDecal: 0866 077 040" class="hidden shrink-0 items-center gap-3 rounded-none bg-[#2563eb] px-4 xl:px-6 py-3 text-sm xl:text-base font-medium text-white transition-colors hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary lg:inline-flex">
        0866-077-040
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m-6-6 6 6-6 6" /></svg>
      </a>

      <button id="menu-toggle" class="lg:hidden p-2 text-brand-navy" aria-label="Mở menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" hidden inert aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu điều hướng" class="fixed inset-0 bg-white z-[110] lg:hidden flex flex-col h-[100dvh] overflow-hidden">
    <div class="shrink-0 px-5 py-4 flex justify-between items-center border-b border-border">
      <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-10 w-auto" />
      <button id="menu-close" aria-label="Đóng menu" class="w-12 h-12 bg-brand-pale rounded-full flex items-center justify-center text-brand-navy text-3xl">&times;</button>
    </div>
    
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-4">
      <div class="flex flex-col gap-1">
        {navLinks.map((link, index) => (
          <div class="flex flex-col border-b border-slate-50 pb-2">
            {link.dropdown ? (
              <>
                <button aria-expanded="false" aria-controls={`mobile-submenu-${index}`} class="mobile-dropdown-btn text-lg font-medium text-secondary flex justify-between items-center text-left py-3">
                  {link.name}
                  <span class="text-brand-navy font-light">＋</span>
                </button>
                <div id={`mobile-submenu-${index}`} hidden class="mobile-dropdown-content flex flex-col bg-surface rounded-xl px-3 py-2 mb-2">
                  {link.mega ? megaGroups.map(group => (
                    <details class="mobile-mega-group">
                      <summary>{group.title}<span aria-hidden="true">＋</span></summary>
                      <div class="mobile-mega-items">{group.items.map(item => <a href={item.href}>{item.name}</a>)}<a class="mega-all" href={group.all}>{group.allLabel} →</a></div>
                    </details>
                  )) : link.dropdown.map((sub) => (
                    <a href={sub.href} class={`flex items-center gap-3 text-sm leading-relaxed font-medium py-2.5 ${sub.highlight ? 'text-brand-navy font-bold' : 'text-secondary'}`}>
                      {sub.showIcon !== false && <SubmenuIcon href={sub.href} />}<span>{sub.name}</span>
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a href={link.href} class="text-lg font-medium text-secondary py-3 hover:text-brand-navy">{link.name}</a>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="shrink-0 p-5 border-t border-border bg-white mobile-menu-footer">
      <a href="tel:0866077040" class="block w-full rounded bg-brand-gradient px-4 py-3 text-center text-sm font-medium text-white transition-colors hover:brightness-110">
        Gọi 0866.077.040
      </a>
    </div>
  </div>
</nav>

<script>
  const megaRoot = document.querySelector<HTMLElement>('.mega-root');
  const megaTrigger = document.getElementById('mega-trigger');
  const megaPanel = document.getElementById('desktop-mega');
  let megaTimer: ReturnType<typeof setTimeout>;
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  function setMega(open: boolean) {
    clearTimeout(megaTimer);
    if (!megaPanel || !megaTrigger) return;
    megaPanel.hidden = !open; megaPanel.inert = !open;
    megaTrigger.setAttribute('aria-expanded', String(open));
  }
  megaRoot?.addEventListener('mouseenter', () => {
    if (desktopQuery.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) setMega(true);
  });
  megaRoot?.addEventListener('mouseleave', () => {
    if (!megaRoot.contains(document.activeElement)) megaTimer = setTimeout(() => setMega(false), 180);
  });
  megaTrigger?.addEventListener('click', () => setMega(megaTrigger.getAttribute('aria-expanded') !== 'true'));
  megaRoot?.addEventListener('focusout', event => {
    if (!megaRoot.contains(event.relatedTarget as Node | null)) setMega(false);
  });
  document.addEventListener('pointerdown', event => { if (!megaRoot?.contains(event.target as Node)) setMega(false); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && megaTrigger?.getAttribute('aria-expanded') === 'true') { setMega(false); megaTrigger.focus(); }
  });
  desktopQuery.addEventListener('change', () => setMega(false));
  document.querySelectorAll<HTMLDetailsElement>('.mobile-mega-group').forEach(group => {
    group.addEventListener('toggle', () => {
      if (group.open) document.querySelectorAll<HTMLDetailsElement>('.mobile-mega-group').forEach(other => { if (other !== group) other.open = false; });
    });
  });

  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  let previousOverflow = '';

  function setMenu(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    const wasOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    if (wasOpen === open) return;
    mobileMenu.hidden = !open;
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    } else {
      mobileMenu.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        const panel = button.nextElementSibling as HTMLElement | null;
        if (panel) { panel.hidden = true; panel.inert = true; }
        const indicator = button.querySelector('span');
        if (indicator) indicator.textContent = '＋';
      });
      mobileMenu.querySelectorAll<HTMLDetailsElement>('.mobile-mega-group').forEach(group => group.open = false);
      document.body.style.overflow = previousOverflow;
      menuToggle.focus();
    }
  }
  menuToggle?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
  document.addEventListener('keydown', event => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') setMenu(false);
    if (event.key === 'Tab') {
      const controls = Array.from(mobileMenu?.querySelectorAll<HTMLElement>('a, button, summary') ?? [])
        .filter(element => element.getClientRects().length > 0 && element.offsetHeight > 0 && !element.closest('[inert]'));
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first && last) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey && document.activeElement === last && first) {
        event.preventDefault(); first.focus();
      }
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
    if (event.matches) setMenu(false);
  });
  document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement | null;
      if (!content) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(other => {
        if (other === button) return;
        other.setAttribute('aria-expanded', 'false');
        const panel = other.nextElementSibling as HTMLElement | null;
        if (panel) { panel.hidden = true; panel.inert = true; }
        const indicator = other.querySelector('span');
        if (indicator) indicator.textContent = '＋';
      });
      content.hidden = !open;
      content.inert = !open;
      const icon = button.querySelector('span');
      if (icon) icon.textContent = open ? '－' : '＋';
    });
    const content = button.nextElementSibling as HTMLElement | null;
    if (content) content.inert = true;
  });
</script>

<style>
  .desktop-mega { position:absolute; top:100%; left:50%; transform:translateX(-50%); width:860px; max-width:calc(100vw - 32px); max-height:calc(100dvh - 112px); overflow-y:auto; overscroll-behavior:contain; background:white; border:1px solid #e2e8f0; border-radius:18px; box-shadow:0 18px 50px #0b174018; }
  .desktop-mega[hidden] { display:none!important; }
  .mega-columns { display:grid; grid-template-columns:1.1fr 1fr; }
  .mega-column { padding:22px; }
  .mega-column + .mega-column { border-left:1px solid #eef2f7; background:#f8fafb; }
  .mega-heading { margin:0 10px 12px; font-size:12px; font-weight:600; color:#64748b; letter-spacing:.05em; text-transform:uppercase; }
  .mega-item { display:block; padding:10px; border-radius:10px; transition:background .15s; }
  .mega-item:hover { background:#edf4fe; }
  .mega-item span { display:block; font-size:14px; font-weight:600; color:#163d60; }
  .mega-item small { display:block; margin-top:3px; font-size:12px; line-height:1.6; color:#536579; }
  .mega-all { display:inline-flex; align-items:center; min-height:44px; margin:8px 10px 0; font-size:13px; font-weight:500; color:#16649b; }
  .mega-all:hover { text-decoration:underline; }
  .mega-cta { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 32px; border-top:1px solid #edf0f6; background:linear-gradient(110deg,#f0f7ff,#f6f3ff); }
  .mega-cta p { font-size:14px; font-weight:600; color:#163d60; }
  .mega-cta small { font-size:12px; line-height:1.6; color:#536579; }
  .mega-cta a { flex-shrink:0; padding:13px 18px; background:#2563eb; border-radius:8px; font-size:13px; font-weight:600; color:white; }
  .mega-cta a:hover { background:#1d4ed8; }
  .mega-root a:focus-visible,.mega-trigger:focus-visible,.mobile-mega-group summary:focus-visible { outline:2px solid #2563eb; outline-offset:3px; }
  .mega-trigger[aria-expanded="true"] { color:#16649b; }
  .mega-trigger[aria-expanded="true"] svg { transform:rotate(180deg); }
  .mobile-mega-group + .mobile-mega-group { border-top:1px solid #e2e8f0; }
  .mobile-mega-group summary { display:flex; justify-content:space-between; align-items:center; min-height:48px; cursor:pointer; list-style:none; font-size:14px; font-weight:600; color:#163d60; }
  .mobile-mega-group summary::-webkit-details-marker { display:none; }
  .mobile-mega-group[open] summary span { transform:rotate(45deg); }
  .mobile-mega-items { padding:0 0 10px 10px; }
  .mobile-mega-items a { display:flex; align-items:center; min-height:44px; padding:8px 0; font-size:14px; line-height:1.5; color:#315574; }
  .mobile-mega-items .mega-all { margin:4px 0 0; color:#16649b; }
  @media (prefers-reduced-motion:reduce) { .mega-item { transition:none; } }

  #mobile-menu[hidden], .mobile-dropdown-content[hidden] { display: none !important; }
  .mobile-menu-footer { padding-bottom: max(20px, env(safe-area-inset-bottom)); }
</style>
