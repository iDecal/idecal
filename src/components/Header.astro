---
import { aboutHref, contactHref, navLinks } from '../data/header-navigation';
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => !/[?#]/.test(href) && currentPath === href.replace(/\/$/, '');
const current = (href: string) => isCurrent(href) ? 'page' : undefined;
---

<header class="site-header sticky top-0 w-full z-[100] bg-white border-b border-border">
  <div class="header-topbar">
    <div class="container header-topbar-inner">
      <div><a href="tel:0866077040">Hotline: 0866-077-040</a><a href="https://zalo.me/0866077040">Zalo</a></div>
      <div><a href={aboutHref} aria-current={current(aboutHref)}>Giới thiệu</a><a href={contactHref} aria-current={current(contactHref)}>Liên hệ</a></div>
    </div>
  </div>
  <nav aria-label="Điều hướng chính">
  <div class="container mx-auto px-4 relative">
    <div class="header-row flex justify-between items-center gap-4">
      
      <div class="flex-shrink-0">
        <a href="/" class="header-brand flex items-center group" aria-label="iDecal – Trang chủ">
          <img src="/images/idecal-logo.png" alt="Logo iDecal" class="h-12 w-auto object-contain" /><span class="header-brand-name">iDecal</span>
        </a>
      </div>

      <div class="header-main-links hidden lg:flex flex-1 justify-center items-center">
        {navLinks.map(link => (
          <div class:list={['mega-root', { 'mega-wide': link.groups.length > 1 }]}>
            <a class="header-nav-link" href={link.href} aria-current={current(link.href)}>{link.name}</a>
            <button id={`mega-trigger-${link.id}`} type="button" aria-label={`Mở mục ${link.name}`} aria-expanded="false" aria-controls={`desktop-mega-${link.id}`} class="mega-trigger">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg>
            </button>
            <div id={`desktop-mega-${link.id}`} hidden inert class="desktop-mega">
              <div class="mega-columns" style={`--menu-columns: ${link.groups.length}`}>
                {link.groups.map(group => (
                  <div class="mega-column">
                    {group.title && <p class="mega-heading">{group.href ? <a href={group.href} aria-current={current(group.href)}>{group.title}</a> : group.title}</p>}
                    <ul class="mega-items">{group.items.map(item => <li><a href={item.href} aria-current={current(item.href)}>{item.name}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="hidden shrink-0 lg:block">
        <a class="btn-primary-solid" href={contactHref} aria-current={current(contactHref)}>Liên hệ / Báo giá</a>
      </div>

      <button id="menu-toggle" class="lg:hidden p-2 text-brand-navy" aria-label="Mở menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" hidden inert aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu điều hướng" class="fixed inset-0 bg-white z-[110] lg:hidden flex flex-col h-[100dvh] overflow-hidden">
    <div class="shrink-0 px-5 py-4 flex justify-between items-center border-b border-border">
      <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-10 w-auto" />
      <button id="menu-close" aria-label="Đóng menu" class="w-12 h-12 bg-brand-pale rounded-full flex items-center justify-center text-brand-navy text-3xl">&times;</button>
    </div>
    
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-4">
      <div class="mobile-offerings">
        {navLinks.map(link => (
          <details class="mobile-offering-group" open={isCurrent(link.href) || link.groups.some(group => (group.href && isCurrent(group.href)) || group.items.some(item => isCurrent(item.href)))}>
            <summary class="mobile-offering-heading">{link.name}</summary>
            <div class="mobile-offering-items"><a class="mobile-overview-link" href={link.href} aria-current={current(link.href)}>Xem tất cả {link.name.toLocaleLowerCase('vi')}</a></div>
            {link.groups.map(group => (
              <div class="mobile-offering-items">
                {group.title && <p class="mega-heading">{group.href ? <a href={group.href} aria-current={current(group.href)}>{group.title}</a> : group.title}</p>}
                <ul class="mega-items">{group.items.map(item => <li><a href={item.href} aria-current={current(item.href)}>{item.name}</a></li>)}</ul>
              </div>
            ))}
          </details>
        ))}
      </div>
    </div>

    <div class="shrink-0 p-5 border-t border-border bg-white mobile-menu-footer">
      <a class="btn-primary-solid w-full justify-center" href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>Liên hệ / Báo giá</a>
      <div class="mobile-menu-contact"><a class="mobile-zalo-contact" href="https://zalo.me/0866077040" aria-label="Chat Zalo với iDecal: 0866.077.040"><svg aria-hidden="true" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0068ff"/><path d="M6 7h20v15H13l-5 4v-4H6Z" fill="#fff"/><text x="16" y="17" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="8" fill="#0068ff">Zalo</text></svg><span>0866.077.040</span></a><a class="mobile-call-contact" href="tel:0866077040" aria-label="Gọi iDecal: 0866.077.040">Gọi ngay</a></div>
    </div>
  </div>
  </nav>
</header>

<script>
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
  let activeMenu: HTMLElement | undefined;
  let pinned = false;
  let closeTimer: ReturnType<typeof setTimeout>;

  function setMega(root?: HTMLElement, pin = false) {
    clearTimeout(closeTimer);
    if (activeMenu && activeMenu !== root) toggleMega(activeMenu, false);
    if (root) toggleMega(root, true);
    activeMenu = root;
    pinned = pin;
  }

  function toggleMega(root: HTMLElement, open: boolean) {
    const trigger = root.querySelector<HTMLButtonElement>('.mega-trigger')!;
    const panel = root.querySelector<HTMLElement>('.desktop-mega')!;
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    panel.inert = !open;
  }

  document.querySelectorAll<HTMLElement>('.mega-root').forEach(root => {
    const trigger = root.querySelector<HTMLButtonElement>('.mega-trigger')!;
    root.addEventListener('mouseenter', () => {
      if (desktopQuery.matches && hoverQuery.matches && (!pinned || root === activeMenu)) setMega(root, pinned);
    });
    root.addEventListener('mouseleave', () => {
      if (activeMenu === root && !pinned && !root.contains(document.activeElement)) {
        closeTimer = setTimeout(() => setMega(), 160);
      }
    });
    trigger.addEventListener('click', event => {
      if (activeMenu === root && (pinned || event.detail === 0)) setMega();
      else setMega(root, true);
    });
    root.addEventListener('focusout', event => {
      if (root === activeMenu && !root.contains(event.relatedTarget as Node | null)) setMega();
    });
  });

  document.addEventListener('pointerdown', event => {
    if (!activeMenu?.contains(event.target as Node)) setMega();
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape' || !activeMenu) return;
    const trigger = activeMenu.querySelector<HTMLButtonElement>('.mega-trigger');
    setMega();
    trigger?.focus();
  });
  desktopQuery.addEventListener('change', () => setMega());

  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  let previousOverflow = '';

  function setMenu(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    const wasOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    if (wasOpen === open) return;
    mobileMenu.hidden = !open;
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      setMega();
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    } else {
      document.body.style.overflow = previousOverflow;
      menuToggle.focus();
    }
  }
  menuToggle?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
  document.addEventListener('keydown', event => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') setMenu(false);
    if (event.key === 'Tab') {
      const controls = Array.from(mobileMenu?.querySelectorAll<HTMLElement>('a, button, summary') ?? [])
        .filter(element => element.getClientRects().length > 0 && element.offsetHeight > 0 && !element.closest('[inert]'));
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first && last) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey && document.activeElement === last && first) {
        event.preventDefault(); first.focus();
      }
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .header-brand { gap:10px; }
  .header-brand-name { color:#031245; font-size:23px; font-weight:600; letter-spacing:-.03em; }
  .header-topbar { background:#f1f6fb; border-bottom:1px solid #dce7f1; }
  .header-topbar-inner, .header-topbar-inner > div { display:flex; align-items:center; gap:12px; }
  .header-topbar-inner { justify-content:space-between; min-height:32px; }
  .header-topbar a { display:inline-flex; align-items:center; min-height:32px; color:#102e57; font-size:13px; white-space:nowrap; }
  .header-topbar a:hover { color:#0056b3; }
  .header-row { height:64px; }
  .header-main-links { gap:clamp(12px, 2vw, 30px); }
  .mega-root { display:flex; align-items:center; height:64px; }
  .mega-root:not(.mega-wide) { position:relative; }
  .header-nav-link { display:flex; align-items:center; min-height:48px; font-weight:650; white-space:nowrap; }
  .header-main-links > div > :is(a,button) { font-size:clamp(15px, 1.25vw, 18px); }
  @media(max-width:1279px) and (min-width:1024px) { .header-brand-name { font-size:20px; } .header-brand { gap:8px; } }
  @media(max-width:1023px) { .header-row { height:56px; gap:10px; } }
  @media(max-width:399px) {
    .header-topbar-inner, .header-topbar-inner > div { gap:7px; }
    .header-topbar a { font-size:11px; }
  }
  @media(max-width:639px) { .header-brand-name { display:none; } .header-brand img { height:40px; } }

  .mobile-menu-footer {max-height:60dvh;overflow-y:auto;overscroll-behavior:contain;}
  .mobile-menu-contact {display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;}
  .mobile-zalo-contact {display:inline-flex;align-items:center;gap:10px;min-height:44px;color:#125b91;font-size:16px;font-weight:600;}
  .mobile-zalo-contact svg {flex:0 0 30px;width:30px;height:30px;}
  .mobile-call-contact {display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;border-radius:8px;background:#edf4fd;color:#125b91;font-size:13px;font-weight:500;}
  .mobile-zalo-contact:focus-visible,.mobile-call-contact:focus-visible {outline:2px solid #168ac0;outline-offset:3px;}
  .desktop-mega { position:absolute; top:100%; inset-inline:0; max-height:calc(100dvh - 98px); overflow-y:auto; overscroll-behavior:contain; background:#fff; border:1px solid #e3ebf4; box-shadow:0 16px 30px #102e5714; }
  .desktop-mega[hidden] { display:none!important; }
  .mega-columns { display:grid; grid-template-columns:repeat(var(--menu-columns),minmax(0,1fr)); gap:clamp(16px,2.4vw,36px); padding:24px; }
  .mega-root:not(.mega-wide) .desktop-mega { width:290px; inset-inline:auto 0; border-radius:0 0 12px 12px; }
  .mega-root:not(.mega-wide) .mega-columns { padding:12px 18px; }
  .mega-heading { margin:0 0 10px; padding:0 0 12px; border-bottom:1px solid #e1eaf4; color:#102e57; font-size:16px; font-weight:700; }
  .mega-items { margin:0; padding:0; list-style:none; }
  .mega-items a { display:flex; align-items:center; min-height:42px; padding:6px 0; font-size:15px; line-height:1.45; }
  .mega-items a:hover,.mega-items a[aria-current="page"] { text-decoration:underline!important; text-underline-offset:4px; }
  .mega-root a:focus-visible,.mega-trigger:focus-visible,.mobile-offering-items a:focus-visible { outline:2px solid #006edc; outline-offset:3px; }
  .mega-trigger { display:grid; place-items:center; width:28px; min-height:48px; position:relative; }
  .mega-trigger[aria-expanded="true"]::after { content:""; position:absolute; inset:auto 0 -7px; height:2px; background:#006edc; }
  .mega-trigger[aria-expanded="true"] svg { transform:rotate(180deg); }
  .mobile-offerings { display:grid; gap:10px; }
  .mobile-offering-group { border:1px solid #e1eaf4; border-radius:12px; background:#f7faff; }
  .mobile-offering-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:48px; padding:10px 14px; border-radius:12px; cursor:pointer; list-style:none; color:#102e57; font-size:16px; font-weight:650; }
  .mobile-offering-heading::-webkit-details-marker { display:none; }
  .mobile-offering-heading::after { content:""; width:8px; height:8px; flex-shrink:0; margin-right:3px; border:solid currentColor; border-width:0 2px 2px 0; transform:rotate(45deg); }
  .mobile-offering-group[open] > .mobile-offering-heading::after { transform:rotate(225deg); }
  .mobile-offering-heading:focus-visible { outline:2px solid #2563eb; outline-offset:2px; }
  .mobile-offering-items { margin:0 14px; padding:10px 0 12px; }
  .mobile-overview-link { display:inline-flex; align-items:center; min-height:48px; font-weight:650; }
  .mobile-offering-items + .mobile-offering-items { border-top:1px solid #e1eaf4; }

  #mobile-menu[hidden] { display: none !important; }
  .mobile-menu-footer { padding-bottom: max(20px, env(safe-area-inset-bottom)); }
</style>
