---
import SubmenuIcon from './SubmenuIcon.astro';
import MenuOffering from './MenuOffering.astro';
import { regions } from '../data/regions';
import { blogCategories } from '../data/blog-categories';
interface MenuItem { name: string; href: string; description: string; image?: string; }
const megaGroups: { title: string; all: string; allLabel: string; items: MenuItem[] }[] = [
  { title: 'Giải pháp & Vật liệu', all: '/san-pham', allLabel: 'Xem tất cả vật liệu', items: [
    { name: 'Decal dán kính văn phòng', image: '/images/menu/decal-mo.webp', href: '/decal-dan-kinh-van-phong', description: 'Riêng tư cho phòng họp, kết hợp logo và họa tiết.' },
    { name: 'Phim cách nhiệt nhà kính', image: '/images/menu/phim-cach-nhiet.webp', href: '/phim-cach-nhiet-nha-kinh', description: 'Chọn phim theo hướng nắng và độ sáng mong muốn.' },
    { name: 'Film dán nội thất', image: '/images/menu/film-noi-that.webp', href: '/dich-vu-film-dan-noi-that/', description: 'Làm mới tủ, cửa, bàn với nhiều vân bề mặt.' },
    { name: 'Film bảo vệ', image: '/images/menu/film-bao-ve.webp', href: '/film-bao-ve-noi-that', description: 'PPF cho nội thất, phim an toàn cho kính.' },
    { name: 'Decal 3D & film trang trí kính', image: '/images/menu/film-trang-tri.webp', href: '/film-trang-tri-kinh', description: 'Vân sóng, họa tiết và hiệu ứng trang trí ô kính.' },
    { name: 'Decal quảng cáo', image: '/images/menu/decal-quang-cao.webp', href: '/decal-quang-cao', description: 'Logo, thông điệp và hình ảnh cho cửa hàng.' },
  ] },
  { title: 'Kỹ thuật & Gia công', all: '/dich-vu', allLabel: 'Xem tất cả dịch vụ', items: [
    { name: 'Thiết kế file & phối mẫu', href: '/dich-vu/thiet-ke', description: 'Dàn logo, họa tiết theo kích thước thực tế.' },
    { name: 'In decal khổ lớn', href: '/dich-vu/in-decal', description: 'In theo thiết kế, chọn cách hoàn thiện phù hợp.' },
    { name: 'Cắt bế decal vector', href: '/dich-vu/cat-decal', description: 'Gia công chữ, logo và họa tiết theo đường cắt.' },
    { name: 'Thi công dán tận nơi', href: '/dich-vu/thi-cong-decal', description: 'Khảo sát, xử lý bề mặt và kiểm tra bàn giao.' },
  ] },
];

interface NavLink {
  name: string;
  href: string;
  mega?: boolean;
  dropdown?: { name: string; href: string; highlight?: boolean; showIcon?: boolean }[];
}
const activeRegion = regions.find(region => Astro.url.pathname.split('/')[1] === 'khu-vuc' && Astro.url.pathname.split('/')[2] === region.slug) ?? regions[0];
const navLinks: NavLink[] = [
  { name: 'Giới thiệu', href: '/gioi-thieu-idecal' },
  { name: 'Dịch vụ', href: '/dich-vu', mega: true, dropdown: [] },
  { name: 'Công trình thực tế', href: '/du-an' },
  { name: 'Blog', href: '/blog', dropdown: blogCategories.map(category => ({ name: category.name, href: `/blog/chuyen-muc/${category.slug}`, showIcon: false })) },
  { name: 'Liên hệ', href: '/lien-he-idecal' },
];
---

<nav aria-label="Điều hướng chính" class="site-header sticky top-0 w-full z-[100] bg-white border-b border-border">
  <div class="container mx-auto px-4 relative">
    <div class="header-row flex justify-between items-center gap-4 h-[80px] xl:h-[96px]">
      
      <div class="flex-shrink-0">
        <a href="/" class="header-brand flex items-center group" aria-label="iDecal – Trang chủ">
          <img src="/images/idecal-logo.png" alt="Logo iDecal" class="h-12 w-auto object-contain" /><span class="header-brand-name">iDecal</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="header-main-links hidden lg:flex flex-1 justify-center items-center">
        {navLinks.map((link) => (
          <div class={`${link.mega ? 'mega-root' : 'relative group'} py-6`}>
            {link.mega ? (
              <>
                <button id="mega-trigger" type="button" aria-expanded="false" aria-controls="desktop-mega" class="mega-trigger text-[13px] xl:text-base font-medium text-brand-navy hover:text-primary flex items-center gap-1.5 whitespace-nowrap">
                  {link.name}<svg aria-hidden="true" class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg>
                </button>
                <div id="desktop-mega" hidden inert class="desktop-mega">
                  <div class="mega-columns">
                    {megaGroups.map(group => (
                      <section class="mega-column" aria-label={group.title}>
                        <p class="mega-heading">{group.title}</p>
                        <div class="mega-items">{group.items.map(item => (
                          <MenuOffering {...item} />
                        ))}</div>
                        <a class="mega-all" href={group.all}>{group.allLabel} →</a>
                      </section>
                    ))}
                  </div>
                  <div class="mega-cta"><div><p>Chưa biết chọn vật liệu nào?</p><small>Gửi ảnh hiện trạng và kích thước để được tư vấn.</small></div><a href="/lien-he-idecal">Nhận tư vấn & báo giá →</a></div>
                </div>
              </>
            ) : (<>
            <a 
              href={link.href} 
              class="text-[13px] xl:text-base font-medium text-brand-navy hover:text-primary transition-colors flex items-center gap-1.5 whitespace-nowrap"
            >
              {link.name}
              {link.dropdown && <svg aria-hidden="true" class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg>}
            </a>
            {link.dropdown && (
              <div class="absolute top-[90%] left-0 w-72 bg-white shadow-2xl rounded-2xl border border-border p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all transform translate-y-2 group-hover:translate-y-0">
                {link.dropdown.map((sub) => (
                  <a href={sub.href} class={`flex items-center gap-3 px-3 py-2.5 text-sm rounded-xl transition-all font-medium ${sub.highlight ? 'bg-brand-navy/5 text-brand-navy font-bold mb-2' : 'text-secondary hover:bg-surface hover:text-brand-navy'}`}>
                    {sub.showIcon !== false && <SubmenuIcon href={sub.href} />}<span>{sub.name}</span>
                  </a>
                ))}
              </div>
            )}
            </>)}
          </div>
        ))}
      </div>

      <div class="region-switcher">
        <button id="region-trigger" type="button" class="region-trigger" aria-expanded="false" aria-controls="header-regions" aria-label={`Khu vực: ${activeRegion.name}. Chọn khu vực phục vụ`}>
          <svg class="region-pin" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{activeRegion.name}</span>
          <svg class="region-chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4"/></svg>
        </button>
        <div id="header-regions" class="region-panel" hidden inert>
          <p>Chọn khu vực phục vụ</p>
          <ul>{regions.map(region => <li><a href={`/khu-vuc/${region.slug}`} data-selected={region.slug === activeRegion.slug ? 'true' : undefined} aria-current={Astro.url.pathname.startsWith(`/khu-vuc/${region.slug}`) ? 'location' : undefined}><span>{region.name}</span>{region.slug === activeRegion.slug && <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg>}</a></li>)}</ul>
        </div>
      </div>

      <button id="menu-toggle" class="lg:hidden p-2 text-brand-navy" aria-label="Mở menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" hidden inert aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu điều hướng" class="fixed inset-0 bg-white z-[110] lg:hidden flex flex-col h-[100dvh] overflow-hidden">
    <div class="shrink-0 px-5 py-4 flex justify-between items-center border-b border-border">
      <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-10 w-auto" />
      <button id="menu-close" aria-label="Đóng menu" class="w-12 h-12 bg-brand-pale rounded-full flex items-center justify-center text-brand-navy text-3xl">&times;</button>
    </div>
    
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-4">
      <div class="mobile-offerings" aria-label="Dịch vụ">
        {megaGroups.map(group => (
          <section class="mobile-offering-group" aria-label={group.title}>
            <p class="mobile-offering-heading">{group.title}</p>
            {group.items.map(item => <MenuOffering {...item} compact />)}
            <a class="mega-all" href={group.all}>{group.allLabel} →</a>
          </section>
        ))}
      </div>
      <div class="mobile-other-links flex flex-col gap-1">
        {navLinks.filter(link => !link.mega).map((link, index) => (
          <div class="flex flex-col border-b border-slate-50 pb-2">
            {link.dropdown ? (
              <>
                <button aria-expanded="false" aria-controls={`mobile-submenu-${index}`} class="mobile-dropdown-btn text-lg font-medium text-secondary flex justify-between items-center text-left py-3">
                  {link.name}
                  <span class="text-brand-navy font-light">＋</span>
                </button>
                <div id={`mobile-submenu-${index}`} hidden class="mobile-dropdown-content flex flex-col bg-surface rounded-xl px-3 py-2 mb-2">
                  {link.dropdown.map((sub) => (
                    <a href={sub.href} class={`flex items-center gap-3 text-sm leading-relaxed font-medium py-2.5 ${sub.highlight ? 'text-brand-navy font-bold' : 'text-secondary'}`}>
                      {sub.showIcon !== false && <SubmenuIcon href={sub.href} />}<span>{sub.name}</span>
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a href={link.href} class="text-lg font-medium text-secondary py-3 hover:text-brand-navy">{link.name}</a>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="shrink-0 p-5 border-t border-border bg-white mobile-menu-footer">
      <button id="mobile-region-shortcut" type="button" aria-expanded="false" aria-controls="mobile-regions" class="mobile-region-shortcut"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>Khu vực: {activeRegion.name}</span><span aria-hidden="true">⌄</span></button>
      <div id="mobile-regions" class="mobile-regions" hidden inert><ul>{regions.map(region=><li><a href={`/khu-vuc/${region.slug}`} data-selected={region.slug === activeRegion.slug ? 'true' : undefined}>{region.name}</a></li>)}</ul></div>
      <div class="mobile-menu-contact"><a class="mobile-zalo-contact" href="https://zalo.me/0866077040" aria-label="Chat Zalo với iDecal: 0866.077.040"><svg aria-hidden="true" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0068ff"/><path d="M6 7h20v15H13l-5 4v-4H6Z" fill="#fff"/><text x="16" y="17" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="8" fill="#0068ff">Zalo</text></svg><span>0866.077.040</span></a><a class="mobile-call-contact" href="tel:0866077040" aria-label="Gọi iDecal: 0866.077.040">Gọi ngay</a></div>
    </div>
  </div>
</nav>

<script>
  const regionRoot = document.querySelector<HTMLElement>('.region-switcher');
  const regionTrigger = document.getElementById('region-trigger');
  const regionPanel = document.getElementById('header-regions');
  function setRegion(open: boolean) {
    if (!regionTrigger || !regionPanel) return;
    regionTrigger.setAttribute('aria-expanded', String(open));
    regionPanel.hidden = !open; regionPanel.inert = !open;
    if (open) setMega(false);
  }
  regionTrigger?.addEventListener('click', () => setRegion(regionTrigger.getAttribute('aria-expanded') !== 'true'));
  regionTrigger?.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown') { event.preventDefault(); setRegion(true); regionPanel?.querySelector<HTMLAnchorElement>('a')?.focus(); }
  });
  regionRoot?.addEventListener('focusout', event => { if (!regionRoot.contains(event.relatedTarget as Node | null)) setRegion(false); });
  document.addEventListener('pointerdown', event => { if (!regionRoot?.contains(event.target as Node)) setRegion(false); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && regionTrigger?.getAttribute('aria-expanded') === 'true') { setRegion(false); regionTrigger.focus(); }
  });

  const megaRoot = document.querySelector<HTMLElement>('.mega-root');
  const megaTrigger = document.getElementById('mega-trigger');
  const megaPanel = document.getElementById('desktop-mega');
  let megaTimer: ReturnType<typeof setTimeout>;
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  function setMega(open: boolean) {
    clearTimeout(megaTimer);
    if (open) setRegion(false);
    if (!megaPanel || !megaTrigger) return;
    megaPanel.hidden = !open; megaPanel.inert = !open;
    megaTrigger.setAttribute('aria-expanded', String(open));
  }
  megaRoot?.addEventListener('mouseenter', () => {
    if (desktopQuery.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) setMega(true);
  });
  megaRoot?.addEventListener('mouseleave', () => {
    if (!megaRoot.contains(document.activeElement)) megaTimer = setTimeout(() => setMega(false), 180);
  });
  megaTrigger?.addEventListener('click', () => setMega(megaTrigger.getAttribute('aria-expanded') !== 'true'));
  megaRoot?.addEventListener('focusout', event => {
    if (!megaRoot.contains(event.relatedTarget as Node | null)) setMega(false);
  });
  document.addEventListener('pointerdown', event => { if (!megaRoot?.contains(event.target as Node)) setMega(false); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && megaTrigger?.getAttribute('aria-expanded') === 'true') { setMega(false); megaTrigger.focus(); }
  });
  desktopQuery.addEventListener('change', () => { setMega(false); setRegion(false); });
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  let previousOverflow = '';

  function setMenu(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    const wasOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    if (wasOpen === open) return;
    mobileMenu.hidden = !open;
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      setRegion(false); setMega(false);
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    } else {
      mobileMenu.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        const panel = button.nextElementSibling as HTMLElement | null;
        if (panel) { panel.hidden = true; panel.inert = true; }
        const indicator = button.querySelector('span');
        if (indicator) indicator.textContent = '＋';
      });
      setMobileRegions(false);
      document.body.style.overflow = previousOverflow;
      menuToggle.focus();
    }
  }
  const mobileRegionButton = document.getElementById('mobile-region-shortcut');
  const mobileRegionPanel = document.getElementById('mobile-regions');
  function setMobileRegions(open: boolean) {
    if (!mobileRegionButton || !mobileRegionPanel) return;
    mobileRegionButton.setAttribute('aria-expanded', String(open));
    mobileRegionPanel.hidden = !open; mobileRegionPanel.inert = !open;
  }
  mobileRegionButton?.addEventListener('click', () => setMobileRegions(mobileRegionButton.getAttribute('aria-expanded') !== 'true'));
  menuToggle?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
  document.addEventListener('keydown', event => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') setMenu(false);
    if (event.key === 'Tab') {
      const controls = Array.from(mobileMenu?.querySelectorAll<HTMLElement>('a, button, summary') ?? [])
        .filter(element => element.getClientRects().length > 0 && element.offsetHeight > 0 && !element.closest('[inert]'));
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first && last) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey && document.activeElement === last && first) {
        event.preventDefault(); first.focus();
      }
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
    if (event.matches) setMenu(false);
  });
  document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement | null;
      if (!content) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(other => {
        if (other === button) return;
        other.setAttribute('aria-expanded', 'false');
        const panel = other.nextElementSibling as HTMLElement | null;
        if (panel) { panel.hidden = true; panel.inert = true; }
        const indicator = other.querySelector('span');
        if (indicator) indicator.textContent = '＋';
      });
      content.hidden = !open;
      content.inert = !open;
      const icon = button.querySelector('span');
      if (icon) icon.textContent = open ? '－' : '＋';
    });
    const content = button.nextElementSibling as HTMLElement | null;
    if (content) content.inert = true;
  });
</script>

<style>
  .header-brand { gap:10px; }
  .header-brand-name { color:#031245; font-size:23px; font-weight:600; letter-spacing:-.03em; }
  .header-main-links { gap:clamp(24px,2.6vw,40px); }
  .region-switcher { position:relative; flex-shrink:0; }
  .region-trigger { display:flex; align-items:center; gap:10px; min-height:48px; min-width:212px; padding:12px 16px; border:1px solid transparent; border-radius:999px; background:linear-gradient(100deg,#0878bd 0%,#4f46e5 55%,#7d12f7 100%); color:#fff; font-size:14px; font-weight:500; box-shadow:0 6px 18px #4f46e526; transition:filter .2s,box-shadow .2s; }
  .region-trigger:hover,.region-trigger[aria-expanded="true"] { filter:brightness(1.06); box-shadow:0 8px 22px #4f46e538; }
  .region-trigger>span { flex:1; text-align:left; white-space:nowrap; }
  .region-pin { width:19px; height:19px; flex:0 0 19px; color:currentColor; }
  .region-chevron { width:13px; height:13px; flex:0 0 13px; }
  .region-trigger[aria-expanded="true"] .region-chevron { transform:rotate(180deg); }
  .region-panel { position:absolute; top:calc(100% + 14px); right:0; width:280px; max-height:calc(100dvh - 130px); overflow-y:auto; overscroll-behavior:contain; padding:12px; border:1px solid #e0e8f1; border-radius:16px; background:#fff; box-shadow:0 14px 40px #0b174018; }
  .region-panel[hidden] { display:none!important; }
  .region-panel>p { margin:4px 10px 10px; font-size:12px; color:#64748b; }
  .region-panel ul { list-style:none; margin:0; padding:0; }
  .region-panel a { display:flex; align-items:center; justify-content:space-between; gap:14px; min-height:44px; padding:11px 12px; border-radius:9px; color:#244766; font-size:14px; }
  .region-panel a:hover { background:#f3f7fc; }
  .region-panel a[data-selected="true"] { background:#edf4fd; color:#125b91; font-weight:500; }
  .region-panel a svg { flex:0 0 17px; width:17px; height:17px; }
  .region-trigger:focus-visible,.region-panel a:focus-visible,.mobile-region-shortcut:focus-visible { outline:2px solid #168ac0; outline-offset:3px; }
  .mobile-region-shortcut { display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%; min-height:48px; padding:12px 16px; border:1px solid transparent; border-radius:12px; background:linear-gradient(100deg,#0878bd 0%,#4f46e5 55%,#7d12f7 100%); color:#fff; font-size:14px; font-weight:500; box-shadow:0 6px 18px #4f46e526; }
  .mobile-region-shortcut>svg { flex:0 0 19px; width:19px; height:19px; color:currentColor; }
  .mobile-region-shortcut>span:first-of-type { flex:1; text-align:left; }
  @media(max-width:1279px) and (min-width:1024px) { .header-brand-name { font-size:20px; } .header-brand { gap:8px; } .region-trigger { min-width:190px; padding:11px 13px; font-size:13px; } }
  @media(max-width:1023px) { .region-switcher { display:none; } .header-row { gap:10px; } .region-panel { position:fixed; top:76px; left:16px; right:16px; width:auto; max-height:calc(100dvh - 100px); } }
  @media(max-width:639px) { .header-brand-name { display:none; } .header-brand img { height:40px; } .region-trigger { min-width:0; min-height:44px; padding:10px 12px; gap:7px; font-size:13px; } }

  .mobile-region-shortcut:hover {filter:brightness(1.06);}
  .mobile-menu-footer {max-height:60dvh;overflow-y:auto;overscroll-behavior:contain;}
  .mobile-menu-contact {display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;}
  .mobile-zalo-contact {display:inline-flex;align-items:center;gap:10px;min-height:44px;color:#125b91;font-size:16px;font-weight:600;}
  .mobile-zalo-contact svg {flex:0 0 30px;width:30px;height:30px;}
  .mobile-call-contact {display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;border-radius:8px;background:#edf4fd;color:#125b91;font-size:13px;font-weight:500;}
  .mobile-zalo-contact:focus-visible,.mobile-call-contact:focus-visible {outline:2px solid #168ac0;outline-offset:3px;}
  .mobile-regions { max-height:32dvh; overflow-y:auto; overscroll-behavior:contain; margin-top:10px; }
  .mobile-regions[hidden] { display:none!important; }
