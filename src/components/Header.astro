---
// Navbar.astro - iDecal Navigation (Deep Blue Edition #031246)
interface NavLink {
  name: string;
  href: string;
  dropdown?: { name: string; href: string; highlight?: boolean }[];
}
const navLinks: NavLink[] = [
  { name: 'Giới thiệu', href: '/gioi-thieu-idecal' },
  { name: 'Dịch vụ', href: '/#dich-vu', dropdown: [
    { name: 'Thiết kế - In ấn - Thi công Decal', href: '/dich-vu/decal-quang-cao', highlight: true },
    { name: 'Phim Cách Nhiệt', href: '/dich-vu/phim-cach-nhiet' },
    { name: 'Decal 3D Vân Sóng', href: '/dich-vu/decal-mo-3d-van-song' },
    { name: 'Decal Cắt Chữ', href: '/dich-vu/cat-decal' },
    { name: 'Film Dán Nội Thất', href: '/dich-vu/film-noi-that' },
    { name: 'Decal Dán Kính Văn Phòng', href: '/dich-vu/decal-dan-kinh-van-phong' },
  ] },
  { name: 'Công trình thực tế', href: '/du-an' },
  { name: 'Blog', href: '/blog' },
  { name: 'Khu vực', href: '/khu-vuc' },
  { name: 'Liên hệ', href: '/lien-he-idecal' },
];
---

<nav class="sticky top-0 w-full z-[100] bg-white border-b border-slate-100 shadow-sm">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-20">
      
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center group">
          <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-12 w-auto object-contain" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <div class="relative group py-8">
            <a 
              href={link.href} 
              class="text-[13px] font-semibold text-slate-600 hover:text-[#031246] uppercase tracking-[0.1em] transition-colors flex items-center gap-1"
            >
              {link.name}
              {link.dropdown && <span class="text-[10px] opacity-50">▼</span>}
            </a>
            {link.dropdown && (
              <div class="absolute top-[90%] left-0 w-72 bg-white shadow-2xl rounded-2xl border border-slate-100 p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all transform translate-y-2 group-hover:translate-y-0">
                {link.dropdown.map((sub) => (
                  <a href={sub.href} class={`block px-4 py-3 text-sm rounded-xl transition-all font-medium ${sub.highlight ? 'bg-[#031246]/5 text-[#031246] font-bold mb-2' : 'text-slate-600 hover:bg-slate-50 hover:text-[#031246]'}`}>
                    {sub.name}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a href="tel:0866077040" class="flex items-center gap-4 bg-[#031246] text-white px-7 py-3.5 rounded-full hover:bg-[#0a1d5a] transition-all shadow-lg shadow-[#031246]/20 active:scale-95 group">
          <div class="flex flex-col border-r border-white/20 pr-4">
             <span class="text-[9px] font-medium uppercase tracking-[0.2em] leading-none mb-1.5 opacity-80">Hotline 24/7</span>
             <span class="text-sm font-bold font-mono leading-none tracking-wider">0866.077.040</span>
          </div>
          <span class="text-xs font-semibold uppercase tracking-[0.15em]">Tư vấn miễn phí</span>
        </a>
      </div>

      <button id="menu-toggle" class="lg:hidden p-2 text-[#031246]" aria-label="Mở menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" inert role="dialog" aria-modal="true" aria-label="Menu điều hướng" class="fixed inset-0 bg-white z-[110] transform translate-x-full transition-transform duration-500 lg:hidden flex flex-col h-screen">
    <div class="p-6 flex justify-between items-center border-b border-slate-100">
      <img src="/images/idecal-logo.png" alt="iDecal Logo" class="h-10 w-auto" />
      <button id="menu-close" aria-label="Đóng menu" class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-[#031246] text-3xl">&times;</button>
    </div>
    
    <div class="flex-1 overflow-y-auto px-8 py-6">
      <div class="flex flex-col gap-4">
        {navLinks.map((link) => (
          <div class="flex flex-col border-b border-slate-50 pb-2">
            {link.dropdown ? (
              <>
                <button aria-expanded="false" class="mobile-dropdown-btn text-xl font-bold text-slate-900 flex justify-between items-center text-left py-4 uppercase tracking-[0.1em]">
                  {link.name}
                  <span class="text-[#031246] font-light">＋</span>
                </button>
                <div class="mobile-dropdown-content max-h-0 overflow-hidden transition-all duration-500 flex flex-col gap-2 bg-slate-50 rounded-xl px-4">
                  {link.dropdown.map((sub) => (
                    <a href={sub.href} class={`text-base font-medium py-3 tracking-wide ${sub.highlight ? 'text-[#031246] font-bold' : 'text-slate-500'}`}>
                      {sub.name}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a href={link.href} class="text-xl font-bold text-slate-900 py-4 uppercase tracking-[0.1em] hover:text-[#031246]">{link.name}</a>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="p-6 border-t border-slate-100 bg-white">
      <a href="tel:0866077040" class="w-full block bg-[#031246] text-white text-center py-5 rounded-2xl font-bold uppercase tracking-[0.2em] text-lg shadow-xl shadow-[#031246]/20">
        Tư vấn: 0866.077.040
      </a>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  let previousOverflow = '';

  function setMenu(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    const wasOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    if (wasOpen === open) return;
    mobileMenu.classList.toggle('translate-x-full', !open);
    mobileMenu.inert = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    } else {
      document.body.style.overflow = previousOverflow;
      menuToggle.focus();
    }
  }
  menuToggle?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
  document.addEventListener('keydown', event => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') setMenu(false);
    if (event.key === 'Tab') {
      const controls = Array.from(mobileMenu?.querySelectorAll<HTMLElement>('a, button') ?? [])
        .filter(element => element.getClientRects().length > 0 && element.offsetHeight > 0 && !element.closest('[inert]'));
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first && last) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey && document.activeElement === last && first) {
        event.preventDefault(); first.focus();
      }
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
    if (event.matches) setMenu(false);
  });
  document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement | null;
      if (!content) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      content.style.maxHeight = open ? `${content.scrollHeight}px` : '0px';
      content.inert = !open;
      const icon = button.querySelector('span');
      if (icon) icon.textContent = open ? '－' : '＋';
    });
    const content = button.nextElementSibling as HTMLElement | null;
    if (content) content.inert = true;
  });
</script>
