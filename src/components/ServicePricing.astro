---
import pricing from '../data/service-pricing.json';
---
<section id="bang-gia-dich-vu" class="service-pricing-section scroll-mt-28">
  <div class="container">
    <div class="service-pricing-heading"><span class="service-pricing-eyebrow">Bảng giá tham khảo · 2026</span><h2 class="brand-heading">{pricing.title}</h2><p>{pricing.intro}</p></div>
    <div class="service-pricing-groups">{pricing.groups.map((group,index)=><details class="service-pricing-group" open={index===0} id={`gia-${group.id}`}>
      <summary><span class="service-price-number" aria-hidden="true">0{index+1}</span><span class="service-price-title"><h3>{group.title}</h3><span>{group.scope}</span></span><svg class="service-price-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 9 6 6 6-6" /></svg></summary>
      <div class="service-price-content"><p class="service-price-description">{group.description}</p><div class:list={['service-price-scroll',{'service-price-wide':group.columns.length===3}]} tabindex="0" role="region" aria-label={`Bảng giá ${group.title}`}><table><caption class="sr-only">Bảng giá tham khảo {group.title}</caption><thead><tr>{group.columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{group.rows.map(row=><tr>{row.map((value,cell)=>cell===0?<th scope="row">{value}</th>:<td class:list={{'price-not-updated':value==='Chưa cập nhật'}}>{value}</td>)}</tr>)}</tbody></table></div><ul class="service-price-notes">{group.notes.map(note=><li>{note}</li>)}</ul><a href={`/dich-vu/${group.service}`} class="service-price-related">{group.linkText}<span aria-hidden="true">→</span></a></div>
    </details>)}</div>
    <details class="service-price-factors"><summary>Những yếu tố làm thay đổi giá thi công<span aria-hidden="true">+</span></summary><ul>{pricing.factors.map(factor=><li><strong>{factor.title}</strong><p>{factor.text}</p></li>)}</ul></details>
  </div>
</section>
<style>
.service-pricing-section { padding: 56px 0; background: #eef4fc; border-top: 1px solid #d6e1ef; }
.service-pricing-heading { max-width: 800px; margin-bottom: 28px; }
.service-pricing-eyebrow { display: inline-block; padding: 6px 12px; border: 1px solid #dce6f4; border-radius: 999px; background: #fff; color: #006edc; font-size: 12px; margin-bottom: 14px; }
.service-pricing-heading h2 { font-size: clamp(26px,2.5vw,34px); margin: 0 0 16px; line-height: 1.35; }
.service-pricing-heading p { font-size: 14px; margin: 0; color: #44566b; }
.service-pricing-groups { display: grid; gap: 14px; }
.service-pricing-group { background: #fff; border: 1px solid #ccdced; border-radius: 14px; overflow: hidden; scroll-margin-top: 112px; }
.service-pricing-group > summary { display: flex; gap: 16px; align-items: center; padding: 20px 24px; cursor: pointer; list-style: none; transition: background .18s; }
.service-pricing-group > summary::-webkit-details-marker, .service-price-factors > summary::-webkit-details-marker { display: none; }
.service-pricing-group > summary:hover { background: #f7faff; }
.service-pricing-group[open] > summary { background: #f8fbff; border-bottom: 1px solid #e0e8f3; }
.service-price-number { display: flex; align-items: center; justify-content: center; flex: 0 0 38px; height: 38px; color: #006edc; background: #edf4ff; border-radius: 10px; font-size: 12px; }
.service-price-title { flex: 1; min-width: 0; }
.service-price-title h3 { font-size: 18px; font-weight: 500; line-height: 1.5; margin: 0 0 3px; color: #173a61; }
.service-price-title > span { display: block; color: #52657c; font-size: 12px; line-height: 1.6; }
.service-price-chevron { flex: 0 0 20px; width: 20px; height: 20px; color: #006edc; transition: transform .18s; }
.service-pricing-group[open] .service-price-chevron { transform: rotate(180deg); }
.service-price-content { padding: 22px 24px 24px; }
.service-price-description { font-size: 14px; margin: 0 0 18px; color: #44566b; }
.service-price-scroll { overflow-x: auto; border: 1px solid #dbe3ef; border-radius: 10px; }
.service-price-scroll table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
.service-price-wide table { min-width: 620px; }
.service-price-scroll thead { background: #183960; color: #fff; }
.service-price-scroll th, .service-price-scroll td { padding: 15px 18px; border-bottom: 1px solid #e0e8f3; vertical-align: top; }
.service-price-scroll th { font-weight: 500; }
.service-price-scroll td { color: #173a61; }
.service-price-scroll tr:nth-child(even) { background: #f5f8fd; }
.service-price-scroll thead tr { background: #183960; }
.service-price-scroll tbody tr:last-child > * { border-bottom: 0; }
.service-price-scroll td.price-not-updated { color: #68778c; font-size: 12px; }
.service-price-notes { margin: 18px 0; padding-left: 18px; display: grid; gap: 6px; color: #52657c; font-size: 12px; line-height: 1.7; }
.service-price-related { display: inline-flex; align-items: center; gap: 16px; font-size: 13px; font-weight: 500; padding: 6px 0; }
.service-price-factors { margin-top: 24px; padding: 0 20px; border: 1px solid #d6e1ef; border-radius: 12px; background: #fff9; }
.service-price-factors > summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; cursor: pointer; font-size: 14px; font-weight: 500; list-style: none; }
.service-price-factors > summary span { color: #006edc; font-size: 20px; }
.service-price-factors[open] > summary span { transform: rotate(45deg); }
.service-price-factors ul { list-style: none; margin: 0; padding: 0 0 20px; display: grid; gap: 18px; grid-template-columns: repeat(2,minmax(0,1fr)); }
.service-price-factors strong { font-size: 13px; color: #173a61; font-weight: 600; }
.service-price-factors p { margin: 5px 0 0; font-size: 13px; color: #52657c; }
.service-pricing-section summary:focus-visible, .service-price-scroll:focus-visible { outline: 2px solid #006edc; outline-offset: -3px; }
@media(max-width:767px) {
 .service-pricing-section { padding: 36px 0; }
 .service-pricing-section .container { padding-left: 20px; padding-right: 20px; }
 .service-pricing-group > summary { gap: 12px; padding: 17px 16px; }
 .service-price-number { flex-basis: 32px; height: 32px; }
 .service-price-title h3 { font-size: 16px; }
 .service-price-content { padding: 18px 16px 20px; }
 .service-price-description { font-size: 13px; }
 .service-price-scroll table { font-size: 13px; }
 .service-price-scroll th, .service-price-scroll td { padding: 12px; }
 .service-price-factors { padding: 0 16px; }
 .service-price-factors ul { grid-template-columns: 1fr; }
}
</style>
