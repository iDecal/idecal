---
import {serviceHeroReview as review} from '../data/service-hero-review';
const rated=typeof review.score==='number' && Number.isFinite(review.score) && review.score>=0 && review.score<=5;
const counted=typeof review.count==='number' && Number.isInteger(review.count) && review.count>0;
const stars=Array.from({length:5},(_,index)=>Math.min(1,Math.max(0,(review.score??0)-index))*100);
const starPath='m12 2.8 2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.5 6.3-.9Z';
---
<a data-hero-review href={review.url} target="_blank" rel="noopener noreferrer" aria-label={`Xem đánh giá ${review.businessName} trên ${review.platform}${rated?`, ${review.score!.toLocaleString('vi-VN')} trên 5 sao`:''} (mở tab mới)`}>
  {rated ? <div data-review-score><strong>{review.score!.toLocaleString('vi-VN',{minimumFractionDigits:1,maximumFractionDigits:1})}</strong><span>{counted?`(${review.count!.toLocaleString('vi-VN')} đánh giá)`:'/ 5'}</span></div> : <div data-review-heading><span>Khách hàng nói gì?</span><strong>Đánh giá iDecal</strong></div>}
  <span data-review-source><span data-review-platform data-platform={review.platform} aria-hidden="true">{review.platform==='Google'?<svg viewBox="0 0 24 24" width="24" height="24"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4.2h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.3 3-7.5Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.3L15.4 17c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 13.8a6 6 0 0 1 0-3.6V7.6H3.1a10 10 0 0 0 0 8.8l3.3-2.6Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5L18.6 4A9.7 9.7 0 0 0 12 2a10 10 0 0 0-8.9 5.6l3.3 2.6C7.2 7.8 9.4 6 12 6Z"/></svg>:'f'}</span>{rated ? <span data-review-stars aria-hidden="true">{stars.map(fill=><span data-review-star><svg viewBox="0 0 24 24"><path d={starPath}/></svg><svg viewBox="0 0 24 24" style={`clip-path:inset(0 ${100-fill}% 0 0)`}><path d={starPath}/></svg></span>)}</span> : <span>Xem phản hồi</span>}</span>
  <span data-review-location>{review.platform} · {review.location}</span>
</a>
