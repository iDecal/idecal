---
import ContactLocations from './ContactLocations.astro';
import regionContext from '../data/region-context.json';
import LocalInstallationPhotos from './LocalInstallationPhotos.astro';
import LocalAreaFaq from './LocalAreaFaq.astro';
import LocalNearbyAreas from './LocalNearbyAreas.astro';
import {getAreaFaqs,areaFaqSchema} from '../data/local-area-content';

import Layout from '../layouts/Layout.astro';
import HcmWardDirectory from './HcmWardDirectory.astro';
import { districtServiceTypes } from '../data/districts';
import '../styles/hcm-landing.css';
const title='Dán Decal & film tại TP.HCM — theo phường, xã mới';
const description='iDecal tư vấn Decal mờ, in logo, phim cách nhiệt và film nội thất tại TP.HCM. Tìm phường/xã mới, đối chiếu địa danh cũ và gửi hiện trạng để trao đổi phương án.';
const services=Object.values(districtServiceTypes);
const areas=[{title:'Kính văn phòng & nhận diện trung tâm',text:'Tại các phường Sài Gòn, Bến Thành, Tân Định, Cầu Ông Lãnh — khu vực Quận 1 trước đây — có thể phối logo, dải mờ và chỉ dẫn theo từng ô kính. Với tòa nhà đang hoạt động, cần trao đổi quy định tiếp cận và giờ thi công.',link:'/dich-vu/decal-dan-kinh-van-phong'},
{title:'Nhà ở & văn phòng phía Đông',text:'Hiệp Bình, Linh Xuân, Tăng Nhơn Phú, Bình Trưng, An Khánh… là những tên phường mới trong khu vực TP. Thủ Đức trước đây, nơi khách vẫn thường tìm theo Quận 2, Quận 9 hoặc Thủ Đức. Chọn vật liệu theo hướng nắng, loại kính và nhu cầu riêng tư.',link:'/dich-vu/phim-cach-nhiet'},
{title:'Cửa hàng & không gian sống phía Nam',text:'Ở các phường Tân Thuận, Tân Mỹ, Tân Hưng, Phú Thuận — khu vực Quận 7 cũ — hay các xã Nhà Bè, Hiệp Phước, hãy gửi ảnh mặt tiền và kích thước theo từng vị trí. Nội dung quảng cáo, khoảng lấy sáng và phần nội thất cần làm mới được đánh giá riêng.',link:'/dich-vu/decal-quang-cao'}];
const faq=[{q:'Địa chỉ cũ ghi quận/huyện thì gửi yêu cầu thế nào?',a:'Bạn có thể kèm tên quận/huyện cũ để dễ nhận ra vị trí, nhưng nên ghi số nhà, đường và phường/xã hiện tại. Nếu chưa rõ tên mới, gửi thêm vị trí bản đồ để cùng đối chiếu trước khi hẹn.'},{q:'Trang này giới thiệu những khu vực nào?',a:'Trang tập trung vào địa bàn TP.HCM trước sáp nhập: các quận, huyện và TP. Thủ Đức cũ. Tên phường/xã hiện tại được lồng với địa danh quen thuộc để bạn dễ tìm đúng khu vực. Bạn có thể mở trang quận/huyện cũ từ các liên kết bên dưới.'},{q:'Báo giá có bao gồm thiết kế và công thi công không?',a:'Tùy phần việc bạn chọn. Báo giá cần làm rõ vật liệu, thiết kế, in/gia công và thi công, cùng tháo lớp cũ hoặc di chuyển nếu có. Phần nào đã gồm trong đơn giá sẽ được ghi rõ.'}];
const localFaq=getAreaFaqs('tp-hcm',faq.map(item=>({question:item.q,answer:item.a})));
const schema=[{'@type':'Service',name:'Tư vấn và thi công Decal, film tại TP.HCM',serviceType:'Decal dán kính, phim cách nhiệt và film nội thất',provider:{'@id':'https://idecal.vn/#organization'},areaServed:{'@type':'City',name:'Thành phố Hồ Chí Minh'}},areaFaqSchema(localFaq.items)];
---
<Layout title={title} description={description} image="/images/Banner/dich-vu-thiet-ke-decal.webp" structuredData={schema}><div class="hcm-page">
<section class="hcm-hero"><div class="container hcm-hero-grid"><div><p class="hcm-kicker">iDecal · Tư vấn theo vị trí công trình</p><h1>Giải pháp Decal & film<br />cho không gian tại TP.HCM</h1><p>Từ vách kính văn phòng, mặt tiền cửa hàng đến cửa sổ nhà ở. Gửi địa chỉ phường/xã hiện tại và ảnh thực tế để chọn đúng vật liệu, bố cục và cách hoàn thiện.</p><div class="hcm-actions"><a href="/lien-he-idecal?khu-vuc=tp-hcm#yeu-cau" class="btn-primary-solid">Trao đổi công trình →</a><a href="#phuong-xa" class="btn-idecal-bold">Tìm phường/xã của bạn ↓</a></div></div><figure><img src="/images/Banner/dich-vu-thiet-ke-decal.webp" alt="Minh họa trao đổi mẫu màu và thiết kế Decal" width="960" height="640" fetchpriority="high" /><figcaption>Từ nhu cầu thực tế đến phương án phù hợp</figcaption></figure></div></section>
<section id="dich-vu" class="container hcm-section"><div class="hcm-section-heading"><div><p class="hcm-kicker">Vật liệu & cách ứng dụng</p><h2>Bạn muốn thay đổi điều gì?</h2></div><a href="/dich-vu">Xem các dịch vụ →</a></div><div class="hcm-services">{services.map(item=><article><a href={`/dich-vu/${item.service}`}><img src={item.image} alt={`Minh họa ${item.title.toLocaleLowerCase('vi-VN')}`} width="800" height="600" loading="lazy" /><h3>{item.title}</h3></a><p>{item.text}</p><a href={`/danh-muc-san-pham/${item.product}`}>Vật liệu & mẫu tham khảo →</a></article>)}</div></section>
<section class="hcm-soft"><div class="container hcm-section"><div class="hcm-section-heading"><div><p class="hcm-kicker">Địa chỉ mới, khu vực vẫn quen</p><h2>Chọn giải pháp theo cách sử dụng</h2></div></div><p>{regionContext['tp-hcm']}</p><div class="hcm-contexts">{areas.map(area=><article><h3>{area.title}</h3><p>{area.text}</p><a href={area.link}>Tìm hiểu giải pháp →</a></article>)}</div></div></section>
<ContactLocations area="tp-hcm" />
<HcmWardDirectory />
<LocalInstallationPhotos areaKey="tp-hcm" areaName="TP.HCM" />
<LocalAreaFaq title={localFaq.title} items={localFaq.items} />
<section id="bao-gia" class="container hcm-contact"><div><h2>Bắt đầu từ ảnh và địa chỉ của bạn</h2><p>Chuẩn bị kích thước dự kiến, vị trí dán, mẫu hoặc file logo nếu có. iDecal trao đổi phương án, phạm vi chi phí và lịch phù hợp trước khi thực hiện.</p></div><a href="/lien-he-idecal?khu-vuc=tp-hcm#yeu-cau" class="btn-primary-solid">Gửi yêu cầu tại TP.HCM →</a><nav><a href="/dich-vu#bang-gia-dich-vu">Bảng giá tham khảo →</a><a href="/lien-he-idecal#yeu-cau">Thông tin đặt dịch vụ →</a></nav></section>
<LocalNearbyAreas areaKey="tp-hcm" />
</div></Layout>
