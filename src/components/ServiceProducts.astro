---
import ProductCard from './ProductCard.astro';
import { products, productCategories } from '../data/catalogue';
import { servicePresentation } from '../data/service-presentation';
interface Props { service?: string; }
const content = Astro.props.service ? servicePresentation[Astro.props.service] : undefined;
const selected = content?.productSlugs
  ? content.productSlugs.map(slug => products.find(product => product.slug === slug)!).filter(Boolean)
  : content ? products.filter(product => product.category === content.category).slice(0, 4)
  : productCategories.slice(0, 4).map(category => products.find(product => product.category === category.slug)!).filter(Boolean);
const category = productCategories.find(category => category.slug === content?.category);
// These local photos are the same 3D models already used on the service page.
const localPhotos: Record<string, string> = {
  'decal-mo-3d-van-song': '/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-co-nho-3D.jpg',
  'decal-dan-kinh-mau-tra-hoa-tiet-song-3d': '/images/decal-song-3d/Decal-van-song-3D-mau-tra-song-nho.webp',
  'decal-trong-suot-song-3d-dan-kinh': '/images/decal-song-3d/Decal-dan-kinh-song-trong-suot-3D-song-to.webp',
};
---
<section id="mau-san-pham" class="service-featured-products">
  <div class="container"><div class="service-editorial-heading"><div><p class="service-kicker">Từ catalogue iDecal</p><h2>Sản phẩm nổi bật cho dịch vụ</h2></div><div><p>Chọn mẫu để xem hình ảnh, mô tả và quy cách trước khi đặt lịch tư vấn.</p><a class="service-inline-link" href={category ? `/danh-muc-san-pham/${category.slug}` : '/san-pham'}>Xem thêm mẫu <span aria-hidden="true">→</span></a></div></div>
    <div class:list={['service-product-grid', { 'service-product-grid-three': selected.length === 3 }]}>{selected.map(product => <ProductCard product={localPhotos[product.slug] ? { ...product, images: [localPhotos[product.slug], ...product.images.slice(1)] } : product} />)}</div>
    <div class="service-booking-line"><p>Đã có mẫu phù hợp? Gửi nhu cầu và kích thước để iDecal tư vấn cách thực hiện.</p><a href={`/dat-dich-vu${Astro.props.service ? `?dich-vu=${Astro.props.service}` : ''}`}>Đặt lịch thi công <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
