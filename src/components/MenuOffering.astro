---
interface Props { name:string; href:string; description:string; compact?:boolean; current?:boolean; }
const {name,href,description,compact=false,current=false}=Astro.props;
---
<a href={href} aria-current={current ? 'page' : undefined} class:list={['menu-offering',{compact}]}><span class="offering-name">{name}</span><small>{description}</small></a>
<style>
.menu-offering{display:block;min-height:64px;padding:8px 10px;border-radius:9px;transition:background .15s}
.menu-offering:hover,.menu-offering[aria-current="page"]{background:#e6f0ff}
.offering-name{display:block;color:#163d60;font-size:15px;font-weight:650;line-height:1.4}
small{display:block;margin-top:2px;color:#536579;font-size:13px;line-height:1.45}
.menu-offering:focus-visible{outline:2px solid #2563eb;outline-offset:2px}
.compact{min-height:48px;padding:12px 10px}
.compact small{display:none}
.compact .offering-name{font-size:16px;font-weight:500}
@media(prefers-reduced-motion:reduce){.menu-offering{transition:none}}
</style>
