---
interface Props { name:string; href:string; description:string; compact?:boolean; }
const {name,href,description,compact=false}=Astro.props;
---
<a href={href} class:list={['menu-offering',{compact}]}><span class="offering-name">{name}</span><small>{description}</small></a>
<style>
.menu-offering{display:block;min-height:72px;padding:14px 14px;border-radius:9px;transition:background .15s}
.menu-offering+.menu-offering{border-top:1px dashed #dce6f1}
.menu-offering:hover{background:#edf5ff}
.offering-name{display:block;color:#163d60;font-size:16px;font-weight:600;line-height:1.45}
small{display:block;margin-top:4px;color:#536579;font-size:13px;line-height:1.6}
.menu-offering:focus-visible{outline:2px solid #2563eb;outline-offset:2px}
.compact{min-height:52px;padding:14px 0;border-radius:0}
.compact small{display:none}
.compact .offering-name{font-size:16px;font-weight:500}
@media(prefers-reduced-motion:reduce){.menu-offering{transition:none}}
</style>
