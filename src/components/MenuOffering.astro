---
import SubmenuIcon from './SubmenuIcon.astro';
interface Props { name: string; href: string; description: string; image?: string; compact?: boolean; }
const { name, href, description, image, compact = false } = Astro.props;
---
<a href={href} class:list={['menu-offering', { compact }]}>
  {image ? <img src={image} alt={`Minh họa ${name.toLowerCase()}`} width="160" height="128" loading="lazy" decoding="async" /> : <SubmenuIcon href={href} />}
  <span class="offering-copy"><span class="offering-name">{name}</span><small>{description}</small></span>
</a>
<style>
  .menu-offering { display:flex; align-items:center; gap:12px; min-height:64px; padding:8px 10px; border-radius:10px; transition:background .15s; }
  .menu-offering:hover { background:#edf4fe; }
  img { flex:0 0 56px; width:56px; height:46px; object-fit:cover; border-radius:8px; }
  .offering-copy { min-width:0; }
  .offering-name { display:block; font-size:14px; font-weight:600; line-height:1.5; color:#163d60; }
  small { display:block; margin-top:3px; font-size:12px; line-height:1.6; color:#536579; }
  .menu-offering:focus-visible { outline:2px solid #2563eb; outline-offset:2px; }
  .compact { min-height:58px; padding:7px 0; gap:12px; }
  .compact img { flex-basis:48px; width:48px; height:40px; }
  .compact small { display:none; }
  .compact .offering-name { font-weight:500; }
  @media (min-width:1024px) {
    .menu-offering:not(.compact) { position:relative; }
    .menu-offering:not(.compact) + .menu-offering:not(.compact)::before { content:''; position:absolute; top:0; left:10px; right:10px; border-top:1px dashed #dce4ed; pointer-events:none; }
  }
  @media (prefers-reduced-motion:reduce) { .menu-offering { transition:none; } }
</style>
