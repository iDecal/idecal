---
import source from '../data/office-glass-original.json';
import solutionPresentation from '../data/office-glass-presentation.json';
import photos from '../data/installation-photo-library.json';
import '../styles/office-glass.css';
const tokens = source.tokens;
const headings = tokens.flatMap((token,index) => token.type === 'h2' ? [index] : []);
const sections = headings.map((index,n) => ({ heading:tokens[index], blocks:tokens.slice(index+1,headings[n+1] ?? tokens.length) }));
const [solutions,why,benefits,pricing,faq,gallery] = sections;
const content = (blocks:typeof tokens) => blocks.filter(block => ['p','ul','ol','table'].includes(block.type) && !['Our Features','Content Creation','Learn More'].includes(block.text ?? '')).map(block=>block.html ?? '').join('').replace(/nhanh<\/p>\s*<p>theo diện tích thực tế\?<\/p>/g, 'nhanh theo diện tích thực tế?</p>').replace(/Llumar\.Đội/g, 'Llumar. Đội');
const groupByH3 = (blocks:typeof tokens) => { const starts=blocks.flatMap((block,i)=>block.type==='h3'?[i]:[]);return starts.map((start,i)=>({heading:blocks[start],blocks:blocks.slice(start+1,starts[i+1]??blocks.length)})); };
const firstService=tokens.findIndex(token=>token.type==='h3');
const services=groupByH3(tokens.slice(firstService,headings[0]));
const whyContactStart=why.blocks.findIndex(block=>block.text?.startsWith('Bạn cần báo giá'));
const serviceIcons=['M4 4h16v12H9l-5 4V4Zm4 4h8M8 12h5','m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15v5Z','M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6z','m3 21 6-6M14 3l7 7-5 5-7-7 5-5ZM3 3l5 5'];
const serviceLinks=['/dich-vu/thiet-ke','/dich-vu/thiet-ke','/dich-vu/in-decal','/dich-vu/thi-cong-decal'];
const types=solutionPresentation;
const benefitItems=benefits.blocks.filter(block=>block.type==='h3');
const faqs=faq.blocks.filter(block=>block.type==='faq');
const heroLead=tokens.filter(token=>token.type==='p').slice(1,3);
const heroPoints=tokens.filter(token=>token.type==='p').slice(3,6);
const kicker=tokens.find(token=>token.text==='iDecal – Công ty cung cấp dịch vụ Decal dán kính văn phòng');
const constructionPhotos=photos.filter(photo=>['anh-01','anh-05','anh-21'].includes(photo.id));
const image=(index:number)=>source.images[index];
---
<div class="office-glass-page">
  <section class="office-hero compact-page-banner"><div class="container office-hero-grid"><div class="compact-banner-copy"><p class="office-eyebrow">Decal kính văn phòng · iDecal</p><h1 class="brand-heading text-balance">{source.title}</h1><div class="office-hero-lead" set:html={content(heroLead)} /><div class="office-hero-actions"><a class="btn-primary-solid" href="#bao-gia-van-phong">Xem bảng giá <span aria-hidden="true">↓</span></a><a class="office-text-link" href="/lien-he-idecal?dich-vu=thi-cong-decal">Tư vấn theo không gian →</a></div><ul class="office-hero-points">{heroPoints.map(point=><li>{point.text}</li>)}</ul></div><figure><img src={image(0).src} alt={image(0).alt} width={image(0).width} height={image(0).height} fetchpriority="high" /></figure></div></section>
  <nav class="container office-jump-links" aria-label="Nội dung trang"><a href="#dich-vu-van-phong">Dịch vụ</a><a href="#giai-phap-van-phong">Chọn giải pháp</a><a href="#vi-sao-idecal">Vì sao iDecal</a><a href="#loi-ich-van-phong">Lợi ích</a><a href="#bao-gia-van-phong">Bảng giá</a><a href="#faq-van-phong">Câu hỏi thường gặp</a><a href="#anh-van-phong">Ảnh thi công</a></nav>
  <section id="dich-vu-van-phong" class="container office-services" aria-labelledby="office-services-title"><header class="office-services-heading"><p class="office-eyebrow">Dịch vụ theo nhu cầu</p><h2 id="office-services-title">Từ thiết kế đến thi công</h2></header><div class="office-services-grid">{services.map((service,i)=><a class="office-service-card" href={serviceLinks[i]}><span class="office-service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={serviceIcons[i]} /></svg></span><div class="office-service-copy"><h3>{service.heading.title}</h3><div set:html={content(service.blocks)} /></div><span class="office-service-arrow" aria-hidden="true">→</span></a>)}</div></section>
  <section id="giai-phap-van-phong" class="container office-section"><header class="office-section-heading"><p class="office-eyebrow">Vật liệu & thiết kế</p><h2>{solutions.heading.text}</h2></header><div class="office-solutions">{types.map((type,i)=><article class="office-solution"><figure><img src={image(i+1).src} alt={image(i+1).alt} width={image(i+1).width} height={image(i+1).height} loading="lazy" /></figure><div class="office-solution-copy"><h3>{type.title}</h3><p>{type.intro}</p><ul class="office-solution-checks">{type.points.map(point=><li><strong>{point.label}:</strong> {point.text}</li>)}</ul><a class="office-solution-button" href={type.href}>{type.action}<span aria-hidden="true">→</span></a></div></article>)}</div></section>
  <section id="vi-sao-idecal" class="office-why"><div class="container"><div class="office-why-grid"><div><p class="office-eyebrow">{kicker?.text}</p><h2>{why.heading.text}</h2><div class="office-original-copy" set:html={content(why.blocks.slice(0,whyContactStart))} /></div><figure><img src={image(6).src} alt={image(6).alt} width={image(6).width} height={image(6).height} loading="lazy" /></figure></div><div class="office-why-contact"><div><div class="office-original-copy" set:html={content(why.blocks.slice(whyContactStart))} /><p class="office-context-note">Tiến độ, thông số hiệu quả và điều kiện bảo hành được xác nhận theo vật liệu, khối lượng và hiện trạng trong báo giá cụ thể.</p></div><a class="office-solution-button" href="/lien-he-idecal?dich-vu=thi-cong-decal">Trao đổi với iDecal <span aria-hidden="true">→</span></a></div></div></section>
  <section id="loi-ich-van-phong" class="container office-section"><header class="office-section-heading"><h2>{benefits.heading.text}</h2><div set:html={content(benefits.blocks.filter(block=>block.type!=='h3'))} /></header><div class="office-benefits-grid"><figure><img src={image(7).src} alt={image(7).alt} width={image(7).width} height={image(7).height} loading="lazy" /></figure><div class="office-benefits">{benefitItems.map((benefit,i)=><article><span class="office-index" aria-hidden="true">0{i+1}</span><h3>{benefit.title}</h3><p set:html={benefit.subtitle ?? ''} /></article>)}</div></div></section>
  <section id="bao-gia-van-phong" class="office-pricing"><div class="container"><header class="office-section-heading"><p class="office-eyebrow">Chi phí theo diện tích & thiết kế</p><h2>{pricing.heading.text}</h2></header><div class="office-price-layout"><div><div class="office-original-copy" set:html={content(pricing.blocks.filter(block=>block.type==='p').slice(0,1))} /><div class="office-price-table" role="region" aria-label="Bảng giá decal kính văn phòng" tabindex="0" set:html={content(pricing.blocks.filter(block=>block.type==='table'))} /><div class="office-price-cta"><p>Gửi ảnh và kích thước để nhận báo giá cho văn phòng của bạn.</p><a href="/lien-he-idecal?dich-vu=thi-cong-decal">Nhận báo giá →</a></div></div><aside class="office-original-copy" aria-label="Các yếu tố ảnh hưởng giá" set:html={content(pricing.blocks.filter(block=>block.type!=='table').slice(1))} /></div></div></section>
  <section id="faq-van-phong" class="container office-section office-faq"><header><p class="office-eyebrow">Giải đáp trước khi thi công</p><h2>{faq.heading.text}</h2><div set:html={content(faq.blocks.filter(block=>block.type!=='faq'))} /><a class="office-text-link" href="/lien-he-idecal">Hỏi thêm về công trình của bạn →</a></header><div>{faqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><div class="office-original-copy" set:html={item.html ?? ''} /></details>)}</div></section>
  <section id="anh-van-phong" class="container office-section office-gallery"><header class="office-section-heading"><h2>{gallery.heading.text}</h2></header><div class="office-gallery-grid">{constructionPhotos.map(photo=><figure><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}</div><div class="office-gallery-copy office-original-copy" set:html={content(gallery.blocks)} /><div class="office-gallery-links"><a href="/du-an">Xem công trình thực tế →</a><a href="/decal-mo-dan-kinh">Chọn mẫu Decal mờ →</a><a href="/dich-vu/thi-cong-decal">Dịch vụ thi công →</a></div></section>
</div>
