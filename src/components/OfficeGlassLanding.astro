---
import ServiceHeroReview from './ServiceHeroReview.astro';
import BannerBenefits from './BannerBenefits.astro';
import source from '../data/office-glass-original.json';
import copy from '../data/office-glass-copy.json';
import visuals from '../data/office-glass-visuals.json';
import solutionPresentation from '../data/office-glass-presentation.json';
import photos from '../data/installation-photo-library.json';
import '../styles/office-glass.css';
const tokens = source.tokens;
const headings = tokens.flatMap((token,index) => token.type === 'h2' ? [index] : []);
const sections = headings.map((index,n) => ({ heading:tokens[index], blocks:tokens.slice(index+1,headings[n+1] ?? tokens.length) }));
const [,why,benefits,pricing,faq] = sections;
const content = (blocks:typeof tokens) => blocks.filter(block => ['p','ul','ol','table'].includes(block.type) && !['Our Features','Content Creation','Learn More'].includes(block.text ?? '')).map(block=>block.html ?? '').join('').replace(/nhanh<\/p>\s*<p>theo diện tích thực tế\?<\/p>/g, 'nhanh theo diện tích thực tế?</p>').replace(/Llumar\.Đội/g, 'Llumar. Đội');
const groupByH3 = (blocks:typeof tokens) => { const starts=blocks.flatMap((block,i)=>block.type==='h3'?[i]:[]);return starts.map((start,i)=>({heading:blocks[start],blocks:blocks.slice(start+1,starts[i+1]??blocks.length)})); };
const firstService=tokens.findIndex(token=>token.type==='h3');
const services=groupByH3(tokens.slice(firstService,headings[0]));
const whyContactStart=why.blocks.findIndex(block=>block.text?.startsWith('Bạn cần báo giá'));

const serviceLinks=['/dich-vu/thiet-ke','/dich-vu/thiet-ke','/dich-vu/in-decal','/dich-vu/thi-cong-decal'];
const types=solutionPresentation;
const benefitItems=benefits.blocks.filter(block=>block.type==='h3');
const faqs=faq.blocks.filter(block=>block.type==='faq');
const heroLead=tokens.filter(token=>token.type==='p').slice(1,3);
const heroPoints=tokens.filter(token=>token.type==='p').slice(3,6);
const kicker=tokens.find(token=>token.text==='iDecal – Công ty cung cấp dịch vụ Decal dán kính văn phòng');
const constructionPhotos=photos.filter(photo=>['anh-01','anh-05','anh-21'].includes(photo.id));
const image=(index:number)=>source.images[index];
---
<div class="office-glass-page">
  <section class="office-hero compact-page-banner" data-service-hero><div class="container office-hero-grid" data-hero-layout><div class="compact-banner-copy" data-hero-copy><p class="office-eyebrow">{copy.eyebrow}</p><h1 class="brand-heading text-balance">{copy.h1}</h1><div class="office-hero-lead" set:html={content(heroLead)} /><div class="office-hero-actions" data-hero-actions><div data-hero-action-main><div data-hero-action-links><a class="btn-primary-solid" href="#bao-gia-van-phong">Xem bảng giá <span aria-hidden="true">↓</span></a><a class="office-text-link" href="/lien-he-idecal?dich-vu=thi-cong-decal">Tư vấn theo không gian →</a></div><span data-hero-signature aria-hidden="true">iDecal</span></div><ServiceHeroReview /></div><div class="office-hero-points" data-hero-benefits><BannerBenefits benefits={heroPoints.map(point=>({title:point.text ?? ''}))} /></div></div><figure data-hero-media><img src={image(0).src} alt={image(0).alt} width={image(0).width} height={image(0).height} fetchpriority="high" /></figure></div></section>
  <div class="office-trust"><div class="container"><div><strong>Theo hiện trạng</strong><span>Khảo sát & báo giá</span></div><div><strong>Linh hoạt</strong><span>Sắp lịch thi công</span></div><div><strong>Theo vật liệu</strong><span>Bảo hành trong báo giá</span></div><div><strong>3M · Llumar</strong><span>Vật liệu theo phương án</span></div></div></div>
  <nav class="container office-jump-links" aria-label="Nội dung trang"><a href="#dich-vu-van-phong">Dịch vụ</a><a href="#giai-phap-van-phong">Chọn giải pháp</a><a href="#vi-sao-idecal">Vì sao iDecal</a><a href="#loi-ich-van-phong">Lợi ích</a><a href="#bao-gia-van-phong">Bảng giá</a><a href="#faq-van-phong">Câu hỏi thường gặp</a><a href="#anh-van-phong">Ảnh thi công</a></nav>
  <section id="dich-vu-van-phong" class="container office-services" aria-labelledby="office-services-title"><header class="office-services-heading"><p class="office-eyebrow">Dịch vụ theo nhu cầu</p><h2 id="office-services-title">{copy.headings.services}</h2></header><div class="office-services-grid">{services.map((service,i)=><a class="office-service-card" href={serviceLinks[i]}><img class="office-service-photo" src={visuals.services[i].src} alt={visuals.services[i].alt} width="800" height="520" loading="lazy" /><div class="office-service-copy"><span class="office-service-number" aria-hidden="true">0{i+1}</span><h3>{service.heading.title}</h3><div set:html={content(service.blocks)} /><span class="office-service-arrow" aria-hidden="true">Khám phá →</span></div></a>)}</div></section>
  <section id="giai-phap-van-phong" class="container office-section"><header class="office-section-heading"><p class="office-eyebrow">Vật liệu & thiết kế</p><h2>{copy.headings.solutions}</h2></header><div class="office-solutions">{types.map((type,i)=><article class="office-solution"><figure><img src={visuals.solutions[i].src} alt={visuals.solutions[i].alt} width="1200" height="800" loading="lazy" /></figure><div class="office-solution-copy"><h3>{type.title}</h3><p>{type.intro}</p><ul class="office-solution-checks">{type.points.map(point=><li><strong>{point.label}:</strong> {point.text}</li>)}</ul><a class="office-solution-button" href={type.href}>{type.action}<span aria-hidden="true">→</span></a></div></article>)}</div></section>
  <section class="container office-audiences" aria-labelledby="office-audiences-title"><header class="office-section-heading"><p class="office-eyebrow">Gợi ý ứng dụng theo nhu cầu</p><h2 id="office-audiences-title">{copy.headings.audiences}</h2></header><div class="office-audience-grid">{copy.audiences.map(item=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
  <section id="vi-sao-idecal" class="office-why brand-dark"><div class="container"><div class="office-why-grid"><div><p class="office-eyebrow">{kicker?.text}</p><h2>{copy.headings.why}</h2><div class="office-original-copy" set:html={content(why.blocks.slice(0,whyContactStart).filter(block=>block.type!=='ul'))} /></div><figure><img src={image(6).src} alt={image(6).alt} width={image(6).width} height={image(6).height} loading="lazy" /></figure></div><div class="office-why-proof office-original-copy" set:html={content(why.blocks.slice(0,whyContactStart).filter(block=>block.type==='ul'))} /></div></section>
  <section id="loi-ich-van-phong" class="container office-section"><header class="office-section-heading"><h2>{copy.headings.benefits}</h2><div set:html={content(benefits.blocks.filter(block=>block.type!=='h3'))} /></header><div class="office-benefits-grid"><figure><img src={image(7).src} alt={image(7).alt} width={image(7).width} height={image(7).height} loading="lazy" /></figure><div class="office-benefits">{benefitItems.map((benefit,i)=><article><span class="office-index" aria-hidden="true">0{i+1}</span><h3>{benefit.title}</h3><p set:html={benefit.subtitle ?? ''} /></article>)}</div></div></section>
  <section id="bao-gia-van-phong" class="office-pricing"><div class="container"><header class="office-section-heading"><p class="office-eyebrow">Chi phí theo diện tích & thiết kế</p><h2>{copy.headings.pricing}</h2></header><div class="office-price-layout"><div><div class="office-original-copy" set:html={content(pricing.blocks.filter(block=>block.type==='p').slice(0,1))} /><div class="office-price-table" role="region" aria-label="Bảng giá decal kính văn phòng" tabindex="0" set:html={content(pricing.blocks.filter(block=>block.type==='table'))} /></div><div class="office-price-factors"><article><h3>Chất liệu</h3><p>Chọn Decal mờ, PP, lưới hoặc in UV theo bề mặt và mục đích sử dụng.</p></article><article><h3>Diện tích</h3><p>Tính theo mét vuông thực tế; trao đổi mức giá theo khối lượng công trình.</p></article><article><h3>Gia công & lắp đặt</h3><p>Đối chiếu thiết kế, cắt bế, cán màng và điều kiện thi công tại vị trí dán.</p></article></div><div class="office-price-cta"><p>Gửi ảnh và kích thước để nhận báo giá cho văn phòng của bạn.</p><a href="/lien-he-idecal?dich-vu=thi-cong-decal">Nhận báo giá →</a></div><details class="office-price-notes"><summary>Chi tiết các yếu tố ảnh hưởng giá <span aria-hidden="true">+</span></summary><div class="office-original-copy" set:html={content(pricing.blocks.filter(block=>block.type!=='table').slice(1))} /></details></div></div></section>
  <section id="faq-van-phong" class="container office-section office-faq"><header><p class="office-eyebrow">Giải đáp trước khi thi công</p><h2>{copy.headings.faq}</h2><div set:html={content(faq.blocks.filter(block=>block.type!=='faq'))} /><a class="office-text-link" href="/lien-he-idecal">Hỏi thêm về công trình của bạn →</a></header><div>{faqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><div class="office-original-copy" set:html={item.html ?? ''} /></details>)}</div></section>
  <section id="anh-van-phong" class="container office-section office-gallery"><header class="office-section-heading"><h2>{copy.headings.gallery}</h2></header><div class="office-gallery-grid">{constructionPhotos.map(photo=><figure><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}</div></section>
  <section class="office-final-cta" aria-labelledby="office-cta-title"><div class="container office-final-grid"><div><h2 id="office-cta-title">Cần báo giá Decal kính văn phòng?</h2><p>Gửi ảnh và kích thước kính để iDecal tư vấn mẫu, vật liệu và chi phí thi công.</p></div><div class="office-final-actions"><a class="btn-primary-solid" href="/lien-he-idecal?dich-vu=thi-cong-decal">Nhận tư vấn & báo giá <span aria-hidden="true">→</span></a><a class="office-final-phone" href="https://zalo.me/0866077040">Hotline/Zalo: 0866.077.040</a></div></div></section>
</div>
