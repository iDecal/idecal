---
import source from '../data/signage-original.json';
import InteriorFilmImage from './InteriorFilmImage.astro';
interface Props {image?:typeof source.hero.image;}
const image=Astro.props.image??source.hero.image;
---
<section class="container signage-service-card" aria-labelledby="signage-child-service-title">
  <figure><a href="/dan-decal-bang-hieu/" aria-label={source.hero.title}><InteriorFilmImage image={image} /></a></figure>
  <div><p class="signage-service-kicker">Dịch vụ thuộc Decal quảng cáo</p><h2 id="signage-child-service-title"><a href="/dan-decal-bang-hieu/">Dịch vụ dán decal bảng hiệu</a></h2><p>{source.hero.intro.text}</p><a href="/dan-decal-bang-hieu/" class="btn-idecal-bold">Xem vật liệu, quy trình & bảng giá →</a></div>
</section>
<style>
.signage-service-card{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:40px;align-items:center;padding-block:38px;border-block:1px solid #e4eaf0}.signage-service-card figure{margin:0;aspect-ratio:4/3;border-radius:12px;overflow:hidden}.signage-service-card figure>a{display:block;height:100%}.signage-service-kicker{font-size:12px;color:#52677c;margin:0 0 14px;padding-left:10px;border-left:3px solid #93bad8}.signage-service-card h2{font-size:26px;font-weight:550;line-height:1.4;margin:0 0 16px}.signage-service-card div>p:not(.signage-service-kicker){font-size:15px;line-height:1.85;margin:0 0 20px}@media(max-width:767px){.signage-service-card{grid-template-columns:1fr;gap:24px;padding-block:30px}.signage-service-card h2{font-size:24px}}
</style>
