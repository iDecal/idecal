---
import ServiceHeroReview from './ServiceHeroReview.astro';
import service from '../data/elevator-service.json';
import InstallationPhotoGallery from './InstallationPhotoGallery.astro';
import '../styles/elevator-service.css';
---
<div class="elevator-page">
  <nav class="container elevator-breadcrumb" aria-label="Đường dẫn trang"><ol><li><a href="/">Trang chủ</a></li><li><a href={service.parent.href}>{service.parent.name}</a></li><li aria-current="page">Dán decal thang máy</li></ol></nav>
  <section class="elevator-hero" data-service-hero><div class="container" data-hero-layout>
    <div data-hero-copy><p class="elevator-eyebrow">Film nội thất & decal in quảng cáo</p><h1>{service.title}</h1><p class="elevator-lead">{service.intro}</p><div class="elevator-actions" data-hero-actions><div data-hero-action-main><div data-hero-action-links><a href={service.quoteHref} class="btn-primary-solid">Nhận tư vấn & báo giá →</a><a href="tel:0866077040" class="elevator-phone"><small>Gọi cho iDecal</small><span>0866-077-040</span></a></div><span data-hero-signature aria-hidden="true">iDecal</span></div><ServiceHeroReview /></div><a href="#giai-phap-thang-may" class="btn-idecal-bold elevator-hero-link">Chọn giải pháp cho thang máy ↓</a></div>
    <figure data-hero-media><img src={service.heroImage.src} alt={service.heroImage.alt} title={service.heroImage.title} width={service.heroImage.width} height={service.heroImage.height} fetchpriority="high" decoding="async" /><figcaption>{service.heroCaption}</figcaption></figure>
  </div></section>
  <nav class="container elevator-jump" aria-label="Nội dung dịch vụ thang máy"><a href="#giai-phap-thang-may">Giải pháp</a><a href="#bao-gia-thang-may">Báo giá</a><a href="#quy-trinh-thang-may">Quy trình</a><a href="#anh-dan-thang-may-title">Hình ảnh</a><a href="#hoi-dap-thang-may">Hỏi đáp</a></nav>
  <section id="giai-phap-thang-may" class="container elevator-section">
    <header class="elevator-heading"><p class="elevator-eyebrow">Chọn theo nhu cầu sử dụng</p><h2>Hai giải pháp dán decal thang máy</h2><p>Làm mới diện mạo hoặc truyền tải thông điệp. Vật liệu và cách hoàn thiện được chọn theo từng bề mặt.</p></header>
    <div class="elevator-solutions">{service.solutions.map((solution,index)=><article id={solution.id}><span class="elevator-index" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h3>{solution.title}</h3><p>{solution.intro}</p><ul>{solution.points.map(point=><li>{point}</li>)}</ul><p class="elevator-fit">{solution.fit}</p><div class="elevator-solution-links">{solution.links.map(link=><a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}</div></article>)}</div>
  </section>
  <section class="elevator-soft"><div class="container elevator-section">
    <header class="elevator-heading"><h2>Các vị trí có thể khảo sát để dán</h2></header>
    <div class="elevator-surfaces">{service.surfaces.map(surface=><article><h3>{surface.title}</h3><p>{surface.description}</p></article>)}</div><p class="elevator-scope">{service.scopeNote}</p>
  </div></section>
  <section id="bao-gia-thang-may" class="container elevator-section">
    <header class="elevator-heading"><p class="elevator-eyebrow">Làm rõ vật tư & công việc</p><h2>{service.quote.title}</h2><p>{service.quote.intro}</p></header>
    <div class="elevator-costs">{service.quote.items.map(item=><article><h3>{item.title}</h3><ul>{item.factors.map(factor=><li>{factor}</li>)}</ul></article>)}</div>
    <div class="elevator-quote-followup"><p>{service.quote.note}</p><a href={service.quoteHref} class="btn-primary-solid">Gửi nhu cầu để nhận báo giá →</a></div>
  </section>
  <section id="quy-trinh-thang-may" class="container elevator-section elevator-process-section">
    <div class="elevator-heading"><p class="elevator-eyebrow">Từ khảo sát đến bàn giao</p><h2>Quy trình thi công gọn trong 5 bước</h2><p>Thống nhất mẫu và phạm vi công việc trước khi thực hiện, kiểm tra hoàn thiện theo bản đã duyệt.</p></div>
    <ol class="elevator-process" role="list">{service.process.map((step,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
  </section>
  <div class="container elevator-gallery"><InstallationPhotoGallery id="anh-dan-thang-may" heading="Hình ảnh film nội thất & decal thang máy" introduction="Tham khảo cách phối vân, màu sắc và bố trí quảng cáo trên thang máy. Bấm vào ảnh để xem lớn." photos={service.gallery} /><a href="/blog/dan-decal-thang-may-giai-phap-refresh-khong-gian/" class="btn-idecal-bold">Đọc thêm về dán decal thang máy →</a></div>
  <section id="hoi-dap-thang-may" class="container elevator-section elevator-faq">
    <header class="elevator-heading"><h2>Câu hỏi thường gặp</h2><a href={service.quoteHref} class="btn-idecal-bold">Trao đổi phương án với iDecal →</a></header>
    <div>{service.faqs.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
  </section>
  <section class="container elevator-section elevator-contact"><div><p class="elevator-eyebrow">Bắt đầu từ hiện trạng của bạn</p><h2>Chọn mẫu film hoặc trao đổi ý tưởng quảng cáo</h2><p>Chuẩn bị ảnh bề mặt, kích thước và số lượng thang máy. iDecal sẽ tư vấn phương án phù hợp với nhu cầu sử dụng.</p></div><div class="elevator-actions"><a href={service.quoteHref} class="btn-primary-solid">Nhận tư vấn dán thang máy →</a><a href={service.parent.href} class="btn-idecal-bold">Về Decal quảng cáo →</a></div></section>
</div>
