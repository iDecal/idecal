---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="project-card group h-full overflow-hidden rounded-3xl border border-border bg-white shadow-sm transition-shadow hover:shadow-xl" data-category={project.data.category} data-search={`${project.data.title} ${project.data.client} ${project.data.location ?? ''} ${project.data.description}`}>
  <a href={`/du-an/${project.id}`} class="flex h-full flex-col focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
    <div class="relative aspect-[4/3] overflow-hidden bg-brand-pale">
      <img src={project.data.image} alt={project.data.title} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      <span class="absolute left-4 top-4 rounded-full bg-white/95 px-4 py-2 text-xs font-bold text-secondary shadow-sm">{project.data.category}</span>
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="!mb-2 text-xs font-semibold uppercase tracking-wider text-primary">{project.data.client}</p>
      <Heading class="!mb-3 text-xl font-bold leading-snug text-secondary transition-colors group-hover:text-primary">{project.data.title}</Heading>
      <p class="text-sm leading-relaxed text-text-muted">{project.data.description}</p>
      {project.data.location && <p class="text-xs text-text-muted">Khu vực: {project.data.location}</p>}
      <span class="mt-auto inline-flex items-center gap-2 pt-4 text-xs font-bold uppercase tracking-wider text-primary">
        Xem công trình <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
