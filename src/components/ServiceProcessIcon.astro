---
interface Props { slug: string; }
const {slug}=Astro.props;
---
<span class="process-icon" aria-hidden="true">
<svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
  {slug==='thiet-ke'?<>
    <rect x="7" y="9" width="30" height="30" rx="5" fill="#e5f3ff" />
    <path d="M12 31C17 13 28 37 35 17" stroke="#0076c9" stroke-width="2.5" />
    <path d="m25 24 11-14 5 4-12 14-6 2 2-6Z" fill="#fff" stroke="#133e65" stroke-width="2" />
    <path d="m34 13 5 4" stroke="#00a9c4" stroke-width="3" />
    <rect x="10" y="28" width="5" height="5" fill="#ffb858" stroke="#133e65" stroke-width="1.5" />
    <circle cx="35" cy="17" r="2.5" fill="#00a9c4" />
  </>:slug==='in-decal'?<>
    <path d="M14 17V8h20v9" fill="#e5f3ff" stroke="#133e65" stroke-width="2" />
    <rect x="6" y="16" width="36" height="20" rx="5" fill="#e5f3ff" stroke="#133e65" stroke-width="2" />
    <path d="M14 28h20v13H14z" fill="#fff" stroke="#133e65" stroke-width="2" />
    <path d="M19 33h10M19 37h7" stroke="#0076c9" stroke-width="2" />
    <circle cx="13" cy="22" r="2" fill="#00a9c4" /><circle cx="20" cy="22" r="2" fill="#eb6b96" /><circle cx="27" cy="22" r="2" fill="#ffbd53" />
  </>:slug==='thi-cong-decal'?<>
    <rect x="7" y="6" width="29" height="36" rx="4" fill="#e5f3ff" stroke="#133e65" stroke-width="2" />
    <path d="M12 32V11h18" stroke="#fff" stroke-width="3" />
    <path d="m12 30 21-14 8 12-21 14-8-12Z" fill="#00a9c4" stroke="#133e65" stroke-width="2" />
    <path d="m15 35 22-15" stroke="#fff" stroke-width="2" />
    <path d="m35 6 2 4m5-1-3 3" stroke="#ffb858" stroke-width="2.5" />
  </>:<>
    <rect x="7" y="7" width="29" height="34" rx="4" fill="#e5f3ff" />
    <path d="m14 34 16-22 8 6-17 21-9 3 2-8Z" fill="#fff" stroke="#133e65" stroke-width="2" />
    <path d="m26 18 8 6" stroke="#00a9c4" stroke-width="4" />
    <path d="m13 36 5 4M11 12h9M11 17h6" stroke="#0076c9" stroke-width="2" />
    <circle cx="37" cy="9" r="3" fill="#ffb858" />
  </>}
</svg>
</span>
<style>
.process-icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0}.process-icon svg{width:100%;height:100%}
</style>
