---
interface Props { kind: 'shield'|'glass'|'benefits'|'specs'|'uses'; }
const { kind } = Astro.props;
const paths = {
  shield:'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6',
  glass:'M4 3h16v18H4zM12 3v18M4 12h16',
  benefits:'m5 12 4 4L19 6',
  specs:'m3 16 13-13 5 5L8 21l-5-5Zm7-7 3 3m1-7 3 3m-11 5 3 3',
  uses:'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z',
};
---
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={paths[kind]} /></svg>
<style>svg { display:inline-block; width:18px; height:18px; flex:0 0 18px; color:#1689c0; }</style>
