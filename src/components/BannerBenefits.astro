---
interface Props { benefits: { title: string }[]; }
const { benefits } = Astro.props;
function iconFor(title: string) {
  const text = title.toLocaleLowerCase('vi-VN');
  if (/riêng tư/.test(text)) return 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z';
  if (/ánh sáng|chói/.test(text)) return 'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z';
  if (/nhiệt/.test(text)) return 'M9 14V5a3 3 0 0 1 6 0v9a5 5 0 1 1-6 0ZM12 8v9';
  if (/uv|bền màu/.test(text)) return 'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6';
  if (/tiết kiệm/.test(text)) return 'm13 2-9 12h7l-1 8 10-12h-7l0-8Z';
  if (/thay đổi/.test(text)) return 'M20 7v5h-5M4 17v-5h5M6 6a8 8 0 0 1 13 3M5 15a8 8 0 0 0 13 3';
  if (/catalogue/.test(text)) return 'M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1m0-15c3-2 6-2 10-1v15c-4-1-7-1-10 1V5Z';
  if (/linh hoạt/.test(text)) return 'M4 7h16M4 17h16M8 4v6m8 4v6';
  if (/thiết kế|thương hiệu|nhận diện/.test(text)) return 'm15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15v5Z';
  if (/mẫu|chất liệu|bề mặt/.test(text)) return 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z';
  if (/nhanh|tiến độ|thi công/.test(text)) return 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM12 7v5l3 2';
  return 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM8 12l3 3 5-6';
}
---
<ul class="banner-benefit-list" aria-label="Ưu điểm nổi bật">
  {benefits.map(benefit=><li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={iconFor(benefit.title)} /></svg><span>{benefit.title}</span></li>)}
</ul>
<style>
.banner-benefit-list { display: flex; flex-wrap: wrap; gap: 12px 20px; margin: 0; padding: 0; list-style: none; }
.banner-benefit-list li { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.6; color: #1b4f7a; }
.banner-benefit-list svg { flex: 0 0 17px; width: 17px; height: 17px; color: #006edc; }
@media(max-width:767px) {
 .banner-benefit-list { width: 100%; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px 16px; }
 .banner-benefit-list li { align-items: flex-start; }
 .banner-benefit-list svg { margin-top: 1px; }
}
</style>
