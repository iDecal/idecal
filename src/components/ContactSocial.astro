---
import SocialLinks from './SocialLinks.astro';
---
<section class="container contact-connect" aria-labelledby="contact-social-title">
  <div class="contact-connect-panel">
    <header class="connect-heading">
      <div>
        <h2 id="contact-social-title">Kết nối cùng iDecal</h2>
        <p>Xem ảnh công trình và theo dõi iDecal trên kênh bạn thường dùng.</p>
      </div>
      <a class="btn-primary-solid connect-zalo" href="https://zalo.me/0866077040" target="_blank" rel="noopener noreferrer" aria-label="Nhắn Zalo iDecal (mở tab mới)">Nhắn Zalo</a>
    </header>

    <SocialLinks branded label="Các kênh kết nối cùng iDecal" />

    <div class="connect-order-link">
      <p>Đã có mẫu hoặc kích thước cần đặt?</p>
      <a href="#yeu-cau">Điền thông tin đặt hàng</a>
    </div>
  </div>
</section>

<style>
  .contact-connect { padding-bottom: clamp(28px, 4vw, 48px); }
  .contact-connect-panel {
    padding: clamp(16px, 2.5vw, 28px);
    border: 1px solid #dce8f6;
    border-radius: 16px;
    background: var(--ui-page-wash);
  }
  .connect-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-bottom: 10px;
  }
  .connect-heading h2 { --heading-h2-local: 24px; margin: 0 0 6px; }
  .connect-heading p, .connect-order-link p { margin: 0; font-size: 14px; line-height: 1.65; }
  .connect-zalo { padding-inline: 18px; }
  .contact-connect-panel :global(.social-links a) { min-height: 48px; padding: 6px 10px; font-weight: 600; }
  .contact-connect-panel :global(.social-links a svg) { width: 18px; height: 18px; }
  .contact-connect-panel :global(.social-links a:hover span) { text-decoration: underline; text-underline-offset: 3px; }
  .connect-order-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 14px;
    margin-top: 8px;
    padding-top: 4px;
    border-top: 1px solid #d7e5f3;
  }
  .connect-order-link a { display: inline-flex; align-items: center; min-height: 48px; font-size: 14px; font-weight: 600; }
  .connect-order-link a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
