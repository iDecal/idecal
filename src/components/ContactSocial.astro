---
import profiles from '../data/social-profiles.json';
const palette:Record<string,{ink:string;tint:string}>={
  Facebook:{ink:'#1877f2',tint:'#edf4ff'},
  Instagram:{ink:'#c13584',tint:'#fcf0f7'},
  Pinterest:{ink:'#bd081c',tint:'#fff0f2'},
  Vimeo:{ink:'#139cc8',tint:'#eaf8fd'},
  Behance:{ink:'#1769ff',tint:'#edf3ff'},
  Flickr:{ink:'#d52a88',tint:'#fff0f8'},
  LinkedIn:{ink:'#0a66c2',tint:'#edf5fd'},
};
---
<section class="container contact-connect" aria-labelledby="contact-social-title">
  <div class="contact-connect-panel">
    <header class="connect-heading"><div><p data-heading-label>Theo dõi & trò chuyện</p><h2 id="contact-social-title">Kết nối cùng iDecal</h2></div><p>Xem thêm hình ảnh công trình, lưu ý tưởng và trao đổi cùng iDecal trên kênh bạn thường dùng.</p></header>
    <nav aria-label="Các kênh kết nối cùng iDecal"><ul class="connect-grid">
      <li><a class="connect-link connect-link--zalo" href="https://zalo.me/0866077040" target="_blank" rel="noopener noreferrer" aria-label="Nhắn Zalo iDecal (mở tab mới)"><span class="connect-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a3 3 0 0 1-3 3H8l-5 4V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9ZM8 8h8m-8 5h5"/></svg></span><svg class="connect-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg><span class="connect-copy"><strong>Zalo</strong><span>Tư vấn & đặt hàng</span></span></a></li>
      {profiles.map(profile=><li><a class="connect-link" href={profile.url} target="_blank" rel="me noopener noreferrer" aria-label={`${profile.name} iDecal (mở tab mới)`} style={`--connect-ink:${palette[profile.name]?.ink??'#1877f2'};--connect-tint:${palette[profile.name]?.tint??'#edf4ff'}`}><span class="connect-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d={profile.path}/></svg></span><svg class="connect-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg><span class="connect-copy"><strong>{profile.name}</strong><span>{new URL(profile.url).hostname.replace(/^www\./,'')}</span></span></a></li>)}
    </ul></nav>
    <div class="connect-order-link"><p>Đã có mẫu hoặc kích thước cần đặt?</p><a href="#yeu-cau">Điền thông tin đặt hàng <span aria-hidden="true">↑</span></a></div>
  </div>
</section>
<style>
  .contact-connect{padding-top:8px;padding-bottom:52px}
  .contact-connect-panel{padding:36px;border:1px solid #dce8f6;border-radius:24px;background:radial-gradient(ellipse at 100% 0%,#eee8ff75,transparent 60%),linear-gradient(115deg,#eff8ff,#f8fbff 65%)}
  .connect-heading{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:center;gap:40px;margin-bottom:28px}
  .contact-connect .connect-heading h2{--heading-h2-local:28px;margin:0}
  .connect-heading>p{font-size:14px;line-height:1.9;color:#5c738a;max-width:430px;margin:0}
  .connect-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;list-style:none;padding:0;margin:0}
  .connect-grid li{min-width:0}
  .connect-link{display:grid;grid-template-columns:minmax(0,1fr) auto;align-content:start;gap:19px 12px;min-height:154px;height:100%;padding:20px;border:1px solid #dce7f3;border-radius:15px;background:#fff;color:#244766;box-shadow:0 5px 16px -12px #14558d35;transition:border-color .18s,box-shadow .18s}
  .connect-link:hover{border-color:#9fc7ee;box-shadow:0 10px 24px -16px #2264a15c}
  .connect-icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:13px;background:var(--connect-tint);color:var(--connect-ink)}
  .connect-icon svg{display:block;width:23px;height:23px}
  .connect-arrow{width:18px;height:18px;align-self:start;margin-top:3px;color:#7c91a8}
  .connect-copy{display:grid;grid-column:1/-1;gap:5px;min-width:0}
  .connect-copy strong{font-size:16px;font-weight:600;line-height:1.5;color:#244766}
  .connect-copy>span{font-size:11px;line-height:1.8;color:#6a8096;overflow-wrap:anywhere}
  .connect-link--zalo{border-color:transparent;background:linear-gradient(125deg,#0789df,#4449df 65%,#7627ed);color:#fff;box-shadow:0 10px 24px -15px #4f46e59c}
  .connect-link--zalo .connect-icon{background:#ffffff24;color:#fff}
  .connect-link--zalo .connect-copy strong{color:#fff}
  .connect-link--zalo :is(.connect-copy>span,.connect-arrow){color:#edf6ff}
  .connect-link--zalo:hover{border-color:#a0bdff;box-shadow:0 12px 28px -15px #4f46e5c4}
  .connect-order-link{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px 24px;padding-top:22px;margin-top:26px;border-top:1px solid #d7e5f3}
  .connect-order-link p{font-size:13px;color:#60778d;line-height:1.8;margin:0}
  .connect-order-link a{display:inline-flex;align-items:center;gap:18px;min-height:44px;font-size:13px;font-weight:500;color:#006edc}
  .contact-connect a:focus-visible{outline:2px solid #0874bb;outline-offset:4px}
  @media(max-width:1023px){.contact-connect-panel{padding:28px}.connect-heading{gap:24px}.connect-link{padding:17px;gap:17px 8px}.connect-icon{width:40px;height:40px;border-radius:12px}}
  @media(max-width:767px){.contact-connect{padding-top:0;padding-bottom:36px}.contact-connect-panel{padding:24px 20px;border-radius:20px}.connect-heading{grid-template-columns:1fr;gap:16px;margin-bottom:24px}.contact-connect .connect-heading h2{--heading-h2-local:24px}.connect-heading>p{font-size:13px;line-height:1.85}.connect-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.connect-link{min-height:144px;padding:16px;gap:16px 8px;border-radius:13px}.connect-copy strong{font-size:15px}.connect-order-link{margin-top:22px;padding-top:18px;gap:5px}.connect-order-link p{font-size:12px}.connect-order-link a{font-size:12px}}
  @media(max-width:359px){.contact-connect-panel{padding:22px 14px}.connect-grid{gap:10px}.connect-link{padding:13px;gap:15px 5px}.connect-icon{width:36px;height:36px;border-radius:10px}.connect-icon svg{width:21px;height:21px}.connect-arrow{width:16px;height:16px}.connect-copy strong{font-size:14px}.connect-copy>span{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.connect-link{transition:none}}
</style>
