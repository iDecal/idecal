---
import {getInstallationPhotos} from '../data/installation-photo-links';
interface Props {numbers:number[];heading?:string;id?:string;}
const {numbers,heading='Ảnh thi công thực tế từ iDecal',id='anh-thi-cong-bo-sung'}=Astro.props;
const photos=getInstallationPhotos(numbers).filter(photo=>photo.kind==='installation');
---
{photos.length>0&&<section class="installation-upload-gallery" id={id} data-installation-gallery aria-labelledby={`${id}-title`}><h2 id={`${id}-title`}>{heading}</h2><p class="upload-gallery-intro">Hình ảnh do iDecal cung cấp, giúp bạn tham khảo cách ứng dụng tại công trình. Bấm vào ảnh để xem lớn.</p><div class="upload-gallery-grid">{photos.map(photo=><figure><a href={photo.src} target="_blank" rel="noopener" data-upload-photo aria-label={`Xem ảnh lớn: ${photo.alt}`} data-caption={photo.caption}><img src={photo.src} alt={photo.alt} title={photo.title} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></a><figcaption>{photo.caption}</figcaption></figure>)}</div><dialog aria-label="Xem ảnh thi công thực tế"><button type="button" data-gallery-close>Đóng ×</button><img alt="Ảnh thi công phóng lớn"/><p></p></dialog></section>}
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-installation-gallery]')){
 const dialog=root.querySelector<HTMLDialogElement>('dialog')!;const image=dialog.querySelector('img')!;const caption=dialog.querySelector('p')!;
 for(const link of root.querySelectorAll<HTMLAnchorElement>('[data-upload-photo]'))link.addEventListener('click',event=>{if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||typeof dialog.showModal!=='function')return;event.preventDefault();image.src=link.href;image.alt=link.querySelector('img')?.alt??'';image.title=link.querySelector('img')?.title??image.alt;caption.textContent=link.dataset.caption??'';dialog.showModal();});
 dialog.querySelector('[data-gallery-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});dialog.addEventListener('close',()=>image.removeAttribute('src'));
}
</script>
<style>
.installation-upload-gallery{padding:30px 0;color:#244766;scroll-margin-top:112px}.installation-upload-gallery h2{font-size:25px;line-height:1.45;font-weight:550;margin:0 0 14px}.upload-gallery-intro{font-size:14px;line-height:1.85;color:#657b8c;margin:0 0 24px}.upload-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.upload-gallery-grid figure{margin:0;min-width:0}.upload-gallery-grid a{display:block;overflow:hidden;border-radius:12px;background:#edf4f8}.upload-gallery-grid img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}.upload-gallery-grid figcaption{font-size:12px;line-height:1.8;color:#5f768a;margin-top:12px}.installation-upload-gallery dialog{width:min(1120px,calc(100% - 28px));max-height:94dvh;overflow:auto;padding:16px;border:0;border-radius:14px;background:#fff;color:#244766}.installation-upload-gallery dialog::backdrop{background:#071a30bd}.installation-upload-gallery dialog>img{display:block;max-width:100%;width:auto;height:auto;max-height:77dvh;margin:12px auto;object-fit:contain}.installation-upload-gallery dialog>button{display:block;margin-left:auto;font-size:14px;padding:9px 12px;cursor:pointer}.installation-upload-gallery dialog>p{font-size:14px;line-height:1.8;margin:10px 0 0}.installation-upload-gallery a:focus-visible,.installation-upload-gallery button:focus-visible{outline:2px solid #176f96;outline-offset:4px}@media(max-width:767px){.installation-upload-gallery h2{font-size:23px}.upload-gallery-grid{grid-template-columns:minmax(0,1fr);gap:24px}.upload-gallery-grid figcaption{font-size:13px}}
</style>
