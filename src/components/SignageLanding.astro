---
import source from '../data/signage-original.json';
import InteriorFilmImage from './InteriorFilmImage.astro';
import '../styles/signage.css';
const sectionLinks=[
  source.introduction.heading,source.materials.heading,source.process.heading,source.pricing.heading,
];
---
<div class="signage-page">
  <nav class="container sign-breadcrumb" aria-label="Đường dẫn trang">
    <ol><li><a href="/">Trang chủ</a></li><li><a href={source.parent.href}>{source.parent.name}</a></li><li aria-current="page">Dán decal bảng hiệu</li></ol>
  </nav>
  <section class="container sign-hero">
    <div>
      <p class="sign-eyebrow">{source.hero.eyebrow}</p>
      <h1>{source.hero.title}</h1>
      <div class="sign-original sign-lead" set:html={source.hero.intro.html} />
      <div class="sign-actions">{source.hero.actions.map((link,index)=><a href={link.href} class={index===0?'btn-primary-solid':'sign-phone'}>{link.label}</a>)}</div>
      <a href={'#'+source.pricing.heading.id} class="btn-idecal-bold sign-price-jump">Xem bảng giá dịch vụ ↓</a>
    </div>
    <div class="sign-hero-visual"><figure><InteriorFilmImage image={source.hero.image} eager /></figure><div class="sign-source-badge"><span aria-hidden="true">✓</span><div><h3>{source.hero.badge.title}</h3><p>{source.hero.badge.text}</p></div></div></div>
  </section>
  <nav class="container sign-jump" aria-label="Nội dung dịch vụ bảng hiệu">{sectionLinks.map(heading=><a href={'#'+heading.id}>{heading.title}</a>)}</nav>

  <section class="container sign-section sign-introduction" aria-labelledby={source.introduction.heading.id}>
    <h2 id={source.introduction.heading.id}>{source.introduction.heading.title}</h2>
    <div class="sign-original" set:html={source.introduction.blocks.map(block=>block.html).join('')} />
  </section>
  <section class="container sign-section sign-benefits" aria-labelledby={source.benefits.heading.id}>
    <header class="sign-heading"><h2 id={source.benefits.heading.id}>{source.benefits.heading.title}</h2></header>
    <div class="sign-benefit-grid">{source.benefits.items.map(item=><article><h3>{item.title}</h3><div class="sign-original" set:html={item.body.html} /></article>)}</div>
  </section>
  <section class="sign-soft" aria-labelledby={source.materials.heading.id}>
    <div class="container sign-section">
      <header class="sign-heading"><p class="sign-eyebrow">Lựa chọn vật liệu</p><h2 id={source.materials.heading.id}>{source.materials.heading.title}</h2></header>
      <div class="sign-materials">{source.materials.items.map(item=><article class:list={['sign-material',{'sign-material-text':!item.image}]}>
        {item.image&&<figure>{item.image.href?<a href={item.image.href}><InteriorFilmImage image={item.image} /></a>:<InteriorFilmImage image={item.image} />}</figure>}
        <div class="sign-material-heading"><h3 id={item.heading.id}>{item.heading.title}</h3></div>
        <div class="sign-original sign-material-copy" set:html={item.blocks.map(block=>block.html).join('')} />
      </article>)}</div>
    </div>
  </section>
  <section class="container sign-section" aria-labelledby={source.process.heading.id}>
    <header class="sign-heading"><h2 id={source.process.heading.id}>{source.process.heading.title}</h2></header>
    <ol class="sign-process">{source.process.items.map(item=><li><h3>{item.title}</h3><div class="sign-original" set:html={item.body.html} /></li>)}</ol>
    <figure class="sign-process-photo"><InteriorFilmImage image={source.process.image} /></figure>
  </section>
  <section class="container sign-section sign-applications" aria-labelledby={source.applications.heading.id}>
    <header class="sign-heading"><h2 id={source.applications.heading.id}>{source.applications.heading.title}</h2></header>
    <ul class="sign-original sign-application-list" set:html={source.applications.items.map(item=>item.html).join('')} />
  </section>
  <section class="sign-soft" aria-labelledby={source.commitments.heading.id}>
    <div class="container sign-section sign-commitments">
      <div><header class="sign-heading"><h2 id={source.commitments.heading.id}>{source.commitments.heading.title}</h2></header><div class="sign-original" set:html={source.commitments.intro.html} /><ul class="sign-original sign-commitment-list" set:html={source.commitments.items.map(item=>item.html).join('')} /></div>
      <figure><InteriorFilmImage image={source.commitments.image} /></figure>
    </div>
  </section>
  <section class="container sign-section sign-pricing" aria-labelledby={source.pricing.heading.id}>
    <header class="sign-heading"><p class="sign-eyebrow">Chi phí theo vật liệu & hạng mục</p><h2 id={source.pricing.heading.id}>{source.pricing.heading.title}</h2></header>
    {source.pricing.tables.map(table=><div class="sign-price-group"><h3 id={table.heading.id}>{table.heading.title}</h3><div class="sign-original" set:html={table.intro.map(block=>block.html).join('')} /><p class="sign-table-hint">Vuốt ngang để xem đầy đủ bảng giá →</p><div class="sign-table-scroll" role="region" tabindex="0" aria-labelledby={table.heading.id} set:html={table.html} /></div>)}
    <div class="sign-original sign-price-note" set:html={source.pricing.note.html} />
  </section>
  <section class="container sign-section sign-contact" aria-labelledby={source.contact.heading.id}>
    <div><h2 id={source.contact.heading.id}>{source.contact.heading.title}</h2><div class="sign-original" set:html={source.contact.blocks.map(block=>block.html).join('')} /></div>
    <div class="sign-contact-actions"><a href="/lien-he-idecal/?dich-vu=dan-decal-bang-hieu#yeu-cau" class="btn-primary-solid">Nhận tư vấn & báo giá →</a><a href={source.parent.href} class="btn-idecal-bold">Về {source.parent.name} →</a></div>
  </section>
</div>
