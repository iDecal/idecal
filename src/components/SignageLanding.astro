---
import {signage as source,signageCopy,signageTableHtml} from '../data/signage-presentation';
import InteriorFilmImage from './InteriorFilmImage.astro';
import InstallationPhotoGallery from './InstallationPhotoGallery.astro';
import {getEntry} from 'astro:content';
import {getInstallationPhotos} from '../data/installation-photo-links';
import gallery from '../data/signage-gallery.json';
const featuredPost=await getEntry('blog',gallery.featuredPost.slug);
const galleryCaptions:Record<string,string>=gallery.captions;
const workPhotos=[
  ...(featuredPost?[{src:featuredPost.data.image,alt:featuredPost.data.title,title:featuredPost.data.title,caption:gallery.featuredPost.caption,width:gallery.featuredPost.width,height:gallery.featuredPost.height}]:[]),
  ...getInstallationPhotos(gallery.installationNumbers).filter(photo=>photo.kind==='installation').map(photo=>({...photo,caption:galleryCaptions[String(photo.number)]??photo.caption})),
];
import '../styles/signage.css';
const sectionLinks=[
  {heading:source.introduction.heading,label:'Tổng quan'},
  {heading:source.materials.heading,label:'Vật liệu'},
  {heading:source.pricing.heading,label:'Báo giá'},
  {heading:source.process.heading,label:'Quy trình'},
  {heading:source.contact.heading,label:'Liên hệ'},
];
---
<div class="signage-page">
  <nav class="container sign-breadcrumb" aria-label="Đường dẫn trang">
    <ol><li><a href="/">Trang chủ</a></li><li><a href={source.parent.href}>{source.parent.name}</a></li><li aria-current="page">Dán decal bảng hiệu</li></ol>
  </nav>
  <section class="container sign-hero">
    <div>
      <p class="sign-eyebrow">{source.hero.eyebrow}</p>
      <h1>{source.hero.title}</h1>
      <div class="sign-original sign-lead" set:html={source.hero.intro.html} />
      <div class="sign-actions"><a href={signageCopy.quoteHref} class="btn-primary-solid">Nhận tư vấn & báo giá <span aria-hidden="true">→</span></a><a href={source.hero.actions[1].href} class="sign-phone"><small>{source.hero.actions[0].label}</small><span>{source.hero.actions[1].label}</span></a></div>
      <div class="sign-hero-links"><a href={'#'+source.pricing.heading.id} class="btn-idecal-bold sign-price-jump">Xem bảng giá dịch vụ ↓</a><a href={'#'+gallery.id+'-title'} class="btn-idecal-bold sign-gallery-jump">Xem ảnh thi công ↓</a></div>
    </div>
    <figure class="sign-hero-visual"><InteriorFilmImage image={source.hero.image} eager /><figcaption><strong>{source.hero.badge.title}</strong><span>{source.hero.badge.text}</span></figcaption></figure>
  </section>
  <nav class="sign-jump" aria-label="Nội dung dịch vụ bảng hiệu"><div class="container">{sectionLinks.map(({heading,label})=><a href={'#'+heading.id}>{label}</a>)}</div></nav>

  <section class="container sign-section sign-introduction" aria-labelledby={source.introduction.heading.id}>
    <h2 id={source.introduction.heading.id}>{source.introduction.heading.title}</h2>
    <div class="sign-original" set:html={source.introduction.blocks.map(block=>block.html).join('')} />
  </section>
  <section class="container sign-section sign-benefits" aria-labelledby={source.benefits.heading.id}>
    <header class="sign-heading"><h2 id={source.benefits.heading.id}>{source.benefits.heading.title}</h2></header>
    <div class="sign-benefit-grid">{source.benefits.items.map(item=><article><h3>{item.title}</h3><div class="sign-original" set:html={item.body.html} /></article>)}</div>
  </section>
  <section class="sign-soft" aria-labelledby={source.materials.heading.id}>
    <div class="container sign-section">
      <header class="sign-heading"><p class="sign-eyebrow">Lựa chọn vật liệu</p><h2 id={source.materials.heading.id}>{source.materials.heading.title}</h2></header>
      <nav class="sign-material-options" aria-label="Chọn loại decal">{source.materials.items.map(item=><a href={'#'+item.heading.id}>{item.heading.title.replace(/^\d+\.\s*/,'').replace(/\s*\([^)]*\)/g,'')}</a>)}</nav>
      <div class="sign-materials">{source.materials.items.map(item=><article class:list={['sign-material',{'sign-material-text':!item.image}]}>
        {item.image&&<figure>{item.image.href?<a href={item.image.href}><InteriorFilmImage image={item.image} /></a>:<InteriorFilmImage image={item.image} />}</figure>}
        <div class="sign-material-heading"><h3 id={item.heading.id}>{item.heading.title}</h3></div>
        <div class="sign-original sign-material-copy" set:html={item.blocks.map(block=>block.html).join('')} />
      </article>)}</div>
    </div>
  </section>
  <section class="container sign-section sign-pricing" aria-labelledby={source.pricing.heading.id}>
    <header class="sign-heading"><p class="sign-eyebrow">Chi phí theo vật liệu & hạng mục</p><h2 id={source.pricing.heading.id}>{source.pricing.heading.title}</h2></header>
    <nav class="sign-price-options" aria-label="Chọn bảng giá">{source.pricing.tables.map((table,index)=><a href={'#'+table.heading.id}>{index===0?'Giá theo loại decal':'Giá theo hạng mục'}<span aria-hidden="true">↓</span></a>)}</nav>
    {source.pricing.tables.map(table=><div class="sign-price-group"><h3 id={table.heading.id}>{table.heading.title}</h3><div class="sign-original" set:html={table.intro.map(block=>block.html).join('')} /><div class="sign-table-scroll" role="region" aria-labelledby={table.heading.id} set:html={signageTableHtml(table.html)} /></div>)}
    <div class="sign-price-followup"><div class="sign-original sign-price-note" set:html={source.pricing.note.html} /><a href={signageCopy.quoteHref} class="btn-idecal-bold">Nhận báo giá theo kích thước của bạn →</a></div>
  </section>
  <section class="container sign-section sign-process-section" aria-labelledby={source.process.heading.id}>
    <div class="sign-process-layout">
      <figure class="sign-process-photo"><InteriorFilmImage image={source.process.image} /></figure>
      <div class="sign-process-copy">
        <header class="sign-heading"><h2 id={source.process.heading.id}>{signageCopy.process.title}</h2></header>
        <ol class="sign-process" role="list">{signageCopy.process.items.map((item,index)=><li><span class="sign-process-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{item.href?<a href={item.href}>{item.title}</a>:item.title}</h3><p>{item.description}</p></div></li>)}</ol>
      </div>
    </div>
  </section>
  <div class="container sign-work-gallery">
    <InstallationPhotoGallery id={gallery.id} heading={gallery.heading} introduction={gallery.introduction} photos={workPhotos} />
  </div>
  <section class="container sign-section sign-applications" aria-labelledby={source.applications.heading.id}>
    <header class="sign-heading"><h2 id={source.applications.heading.id}>{source.applications.heading.title}</h2></header>
    <ul class="sign-original sign-application-list" set:html={source.applications.items.map(item=>item.html).join('')} />
  </section>
  <section class="sign-soft" aria-labelledby={source.commitments.heading.id}>
    <div class="container sign-section sign-commitments">
      <div><header class="sign-heading"><h2 id={source.commitments.heading.id}>{source.commitments.heading.title}</h2></header><div class="sign-original" set:html={source.commitments.intro.html} /><ul class="sign-original sign-commitment-list" set:html={source.commitments.items.map(item=>item.html).join('')} /></div>
      <figure><InteriorFilmImage image={source.commitments.image} /></figure>
    </div>
  </section>
  <section class="container sign-section sign-contact" aria-labelledby={source.contact.heading.id}>
    <div><h2 id={source.contact.heading.id}>{source.contact.heading.title}</h2><div class="sign-original" set:html={source.contact.blocks.map(block=>block.html).join('')} /></div>
    <div class="sign-contact-actions"><p>Gửi ảnh bảng hiệu, kích thước dự kiến và nội dung cần in để được tư vấn.</p><a href={signageCopy.quoteHref} class="btn-primary-solid">Nhận tư vấn & báo giá →</a><a href={source.parent.href} class="btn-idecal-bold">Về {source.parent.name} →</a></div>
  </section>
</div>

<script>
  const navigation=document.querySelector<HTMLElement>('.sign-jump');
  if(navigation){
    const links=Array.from(navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const targets=links.map(link=>{const target=document.getElementById(link.hash.slice(1));return {link,target,section:target?.closest('section')??target};}).filter(item=>item.target);
    let pending=false;
    const update=()=>{
      const limit=navigation.getBoundingClientRect().bottom+24;
      let current=targets[0];
      for(const item of targets)if(item.section!.getBoundingClientRect().top<=limit)current=item;
      if(window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-16)current=targets[targets.length-1];
      for(const item of targets){if(item===current)item.link.setAttribute('aria-current','location');else item.link.removeAttribute('aria-current');}
      pending=false;
    };
    window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(update);}},{passive:true});
    window.addEventListener('resize',update);
    update();
  }
</script>
