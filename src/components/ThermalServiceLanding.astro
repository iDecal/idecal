---
import PageBanner from './PageBanner.astro';
import BannerBenefits from './BannerBenefits.astro';
import ProductBrands from './ProductBrands.astro';
import ProductCatalog from './ProductCatalog.astro';
import ProductCard from './ProductCard.astro';
import InstallationPhotoGallery from './InstallationPhotoGallery.astro';
import ServiceSupport from './ServiceSupport.astro';
import {getServiceCta} from '../data/service-cta';
import {thermalTitle,thermalCategory as category,thermalLanding as landing,thermalPresentation,thermalFilms,thermalSupportProducts,thermalPricing,thermalPhotos,thermalFaqs,thermalChecks,thermalSelectionCriteria} from '../data/thermal-service';
import '../styles/thermal-service.css';
const quote=getServiceCta('phim-cach-nhiet').href;
const jumpItems=[
  {id:'bao-gia-phim-cach-nhiet',label:'Bảng giá'},
  {id:'chon-phim',label:'Cách chọn phim'},
  {id:'mau-san-pham',label:'Mẫu phim'},
  {id:'ung-dung-phim',label:'Ứng dụng'},
  {id:'thi-cong-phim',label:'Thi công'},
  {id:'anh-thi-cong-phim',label:'Ảnh thực tế'},
  {id:'cau-hoi-phim',label:'Câu hỏi'},
] as const;
---
<div class="thermal-service-page" data-thermal-service>
  <PageBanner serviceHero title={thermalTitle} eyebrow="Tư vấn vật liệu và thi công" image={category.image} imageAlt="Thi công phim cách nhiệt cho hệ kính văn phòng">
    <p slot="description">Phim cách nhiệt nhà kính giúp giảm nhiệt do nắng chiếu qua kính, giảm chói và hạn chế tia UV. Chọn mẫu theo loại kính, hướng nắng và lượng ánh sáng tự nhiên bạn muốn giữ.</p>
    <Fragment slot="actions"><a href="#bao-gia-phim-cach-nhiet" class="btn-primary-solid">Xem bảng giá theo m² <span aria-hidden="true">↓</span></a><a href={quote} class="thermal-secondary-button">Nhận báo giá thi công <span aria-hidden="true">→</span></a></Fragment>
    <BannerBenefits slot="meta" benefits={landing.benefits.map(title=>({title}))} />
  </PageBanner>
  <nav class="thermal-jump" aria-label="Nội dung dịch vụ phim cách nhiệt"><div class="container">{jumpItems.map(item=><a href={'#'+item.id}><span>{item.label}</span></a>)}</div></nav>

  <section id="bao-gia-phim-cach-nhiet" class="thermal-price-surface"><div class="container thermal-section"><header class="thermal-heading"><p data-heading-label>{thermalPricing.scope}</p><h2>Báo giá phim cách nhiệt nhà kính 2026</h2><p>{thermalPricing.description}</p></header><div class="thermal-price-layout"><div><table class="thermal-price-table"><caption class="sr-only">Báo giá phim cách nhiệt tham khảo năm 2026</caption><thead><tr>{thermalPricing.columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{thermalPricing.rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table><ul class="thermal-price-notes">{thermalPricing.notes.map(note=><li>{note}</li>)}</ul></div><aside class="thermal-quote-box"><h3>Báo giá theo công trình của bạn</h3><p>Gửi ảnh kính, kích thước và nhu cầu giữ sáng để được tư vấn mã phim cùng phương án thi công.</p><a href={quote} class="btn-primary-solid">Nhận báo giá thi công <span aria-hidden="true">→</span></a><a href="/huong-dan-do-kinh/" class="thermal-text-link">Hướng dẫn đo kính <span aria-hidden="true">→</span></a></aside></div></div></section>

  <section id="chon-phim" class="container thermal-section"><header class="thermal-heading"><p data-heading-label>Chọn mẫu phù hợp</p><h2>Cách chọn phim cách nhiệt cho nhà kính</h2><p>{landing.guidance}</p></header><dl class="thermal-specs">{thermalSelectionCriteria.map(item=><div><dt>{item.term}</dt><dd>{item.explanation}</dd></div>)}</dl><div class="thermal-needs">{category.needs.slice(0,3).map(item=><article><h3>{item.label}</h3><p>{item.tip}</p></article>)}</div><div class="thermal-swatches"><figure><img src="/images/uploads/film-phan-guong-xanh-la.png" alt="Minh họa sắc xanh lá của film phản gương trên cửa kính" width="1500" height="1120" loading="lazy" /><figcaption>Sắc xanh lá</figcaption></figure><figure><img src="/images/uploads/film-phan-guong-xanh-xam.png" alt="Minh họa sắc xanh xám của film phản gương trên cửa kính" width="1500" height="1120" loading="lazy" /><figcaption>Sắc xanh xám</figcaption></figure></div><p class="thermal-image-note">Ảnh minh họa sắc phim. Đối chiếu mẫu thực tế khi chọn.</p></section>

  <div class="thermal-soft"><ProductCatalog items={thermalFilms} category={category} heading="Sản phẩm phim cách nhiệt nhà kính" /></div>
  {thermalSupportProducts.length>0&&<section class="container thermal-section thermal-support-products" aria-labelledby="thermal-support-title"><header class="thermal-heading"><h2 id="thermal-support-title">Sản phẩm hỗ trợ & bảo vệ kính</h2><p>Tham khảo thêm bộ dụng cụ thi công và phim bảo vệ kính theo nhu cầu sử dụng.</p></header><div class="thermal-support-grid">{thermalSupportProducts.map(product=><ProductCard product={product} />)}</div></section>}

  <section class="container thermal-section thermal-overview" aria-labelledby="thermal-overview-title"><header class="thermal-heading"><p data-heading-label>Giảm nắng gắt, cân bằng ánh sáng</p><h2 id="thermal-overview-title">Phim cách nhiệt chống nóng cho kính</h2><p>{landing.description}</p></header><div class="thermal-benefits">{category.benefits.map(item=><article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>
  <div class="thermal-brands"><ProductBrands group="phim-cach-nhiet-nha-kinh" /></div>

  <section id="ung-dung-phim" class="thermal-soft"><div class="container thermal-section"><header class="thermal-heading"><p data-heading-label>Ứng dụng theo không gian</p><h2>Phim cách nhiệt nhà kính phù hợp ở đâu?</h2></header><div class="thermal-applications">{landing.uses.map(item=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <section id="thi-cong-phim" class="container thermal-section"><div class="thermal-installation"><header class="thermal-heading"><p data-heading-label>Thi công phim cách nhiệt nhà kính</p><h2>Thống nhất phương án trước khi dán</h2><p>Lựa chọn phim theo loại kính, hướng nắng và nhu cầu giữ sáng cho nhà ở, văn phòng hoặc showroom.</p><a data-cta-text href="/dich-vu/thi-cong-decal/" class="thermal-text-link">Xem dịch vụ thi công <span aria-hidden="true">→</span></a></header><ol>{thermalChecks.map((point,index)=><li><div><span class="thermal-step-label">Bước {'0'+(index+1)}</span><p>{point}</p></div></li>)}</ol></div><p class="thermal-installation-scope">Có thể mua vật liệu hoặc trao đổi thêm về thiết kế, in, cắt và thi công. Phạm vi công việc được xác nhận trước khi thực hiện.</p></section>
  <div class="container thermal-gallery"><InstallationPhotoGallery photos={thermalPhotos} id="anh-thi-cong-phim" heading="Ảnh thi công phim cách nhiệt" introduction={thermalPresentation.introduction} /></div>

  <section id="cau-hoi-phim" class="container thermal-section thermal-faq"><header class="thermal-heading"><p data-heading-label>Trước khi đặt dịch vụ</p><h2>Câu hỏi về phim cách nhiệt nhà kính</h2></header><div>{thermalFaqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
  <ServiceSupport service="phim-cach-nhiet" />
</div>
