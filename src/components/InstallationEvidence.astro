---
import content from '../data/installation-evidence.json';
import { regions } from '../data/regions';
import { districtUrl } from '../data/districts';
const hcmAreas=[{slug:'quan-1',name:'Quận 1 cũ'},{slug:'quan-3',name:'Quận 3 cũ'},{slug:'quan-12',name:'Quận 12 cũ'},{slug:'quan-tan-binh',name:'Tân Bình'},{slug:'thanh-pho-thu-duc',name:'Khu vực Thủ Đức'}];
---
<section id="anh-thi-cong-thuc-te" class="container installation-proof">
 <div class="proof-heading"><div><p class="proof-kicker">Công trình & hình ảnh đã có tại iDecal</p><h2>Hình ảnh thi công Decal thực tế</h2></div><a class="proof-text-link" href="/du-an">Xem các công trình →</a></div>
 <p class="proof-intro">{content.introduction}</p>
 <div class="proof-gallery">{content.photos.map(item=><figure><a class="proof-photo" href={item.href} aria-label={`${item.linkLabel}: ${item.title}`}><img src={item.image} alt={item.alt} width="900" height="675" loading="lazy" /></a><figcaption><h3>{item.title}</h3><p>{item.description}</p><a href={item.href}>{item.linkLabel} →</a></figcaption></figure>)}</div>
</section>
<section id="kinh-nghiem-thi-cong" class="container installation-experience">
 <div class="proof-heading"><div><p class="proof-kicker">Từ hiện trạng đến nghiệm thu</p><h2>Kinh nghiệm thi công Decal theo từng bề mặt</h2></div></div>
 <p class="proof-intro">Mỗi bề mặt cần một phương án riêng. Khi tư vấn và triển khai, iDecal trao đổi các điểm dưới đây để khách hàng có căn cứ kiểm tra vật liệu, công việc và kết quả hoàn thiện.</p>
 <div class="experience-grid">{content.experience.map((item,index)=><article><span class="experience-number" aria-hidden="true">0{index+1}</span><div><h3>{item.title}</h3><p>{item.text}</p><a href={item.href}>{item.linkLabel} →</a></div></article>)}</div>
 <aside class="installation-trust"><p><strong>Thông tin để đối chiếu trước khi đặt dịch vụ</strong> · Tìm hiểu iDecal, xem địa chỉ liên hệ và trao đổi rõ mã vật liệu, phạm vi công việc, lịch thi công cùng điều kiện hỗ trợ trước khi xác nhận.</p><nav aria-label="Thông tin đơn vị thi công"><a href="/gioi-thieu-idecal">Về iDecal →</a><a href="/lien-he-idecal#contact-locations-title">Địa chỉ & liên hệ →</a><a href="/dich-vu#bang-gia-dich-vu">Báo giá tham khảo →</a></nav></aside>
</section>
<section id="khu-vuc-thi-cong" class="container installation-coverage">
 <div class="proof-heading"><div><p class="proof-kicker">Trao đổi theo địa chỉ công trình</p><h2>Khu vực tiếp nhận thi công Decal</h2></div></div>
 <p class="proof-intro">Bạn có thể gửi yêu cầu thi công Decal tại TP.HCM và các khu vực dưới đây. Lịch khảo sát, phạm vi nhận việc và chi phí di chuyển được xác nhận theo địa chỉ, khối lượng và điều kiện thực tế.</p>
 <nav class="coverage-regions" aria-label="Khu vực thi công Decal">{regions.map(region=><a href={`/khu-vuc/${region.slug}`}><span>{region.shortName}</span><span aria-hidden="true">→</span></a>)}</nav>
 <div class="coverage-hcm"><h3>Tìm theo khu vực tại TP.HCM</h3><p>Dùng tên khu vực cũ để đối chiếu; khi gửi yêu cầu, ghi địa chỉ theo phường/xã hiện tại.</p><nav aria-label="Khu vực thi công tại TP.HCM">{hcmAreas.map(area=><a href={districtUrl(area.slug)}>{area.name}</a>)}<a href="/khu-vuc/tp-hcm#phuong-xa">Tra cứu phường/xã →</a></nav></div>
</section>
<style>
.installation-proof,.installation-experience,.installation-coverage{padding-top:40px;padding-bottom:40px;color:#244766;scroll-margin-top:112px}.proof-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:18px}.proof-kicker{font-size:12px!important;color:#627d91!important;margin:0 0 12px!important}.installation-proof .proof-heading h2,.installation-experience .proof-heading h2,.installation-coverage .proof-heading h2{font-size:clamp(24px,2.5vw,31px);line-height:1.4;margin:0;max-width:720px}.proof-intro{max-width:900px;font-size:15px;line-height:1.9;color:#5d7184;margin:0 0 28px}.proof-text-link{font-size:13px;flex-shrink:0;color:#176f96}.proof-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.proof-gallery figure{margin:0;min-width:0}.proof-photo{display:block;overflow:hidden;border-radius:14px;background:#eef4f8}.proof-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;transition:transform .2s}.proof-photo:hover img{transform:scale(1.025)}.proof-gallery figcaption{padding-top:18px}.installation-proof .proof-gallery h3,.installation-experience .experience-grid h3{font-size:18px;font-weight:500;line-height:1.6;color:#244766;margin:0 0 10px}.proof-gallery figcaption p{font-size:13px;line-height:1.85;color:#64788a;margin:0 0 13px}.proof-gallery figcaption a,.experience-grid a{font-size:13px;color:#176f96}.experience-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 44px}.experience-grid article{display:flex;gap:18px;padding-top:24px;border-top:1px solid #e1e9f0}.experience-number{font-size:12px;color:#8b9eac;padding-top:5px}.experience-grid article p{font-size:14px;line-height:1.9;color:#5d7184;margin:0 0 14px}.installation-trust{margin-top:32px;padding:24px 28px;background:linear-gradient(110deg,#f3f8fc,#f8f7fc);border-radius:12px}.installation-trust p{font-size:13px;line-height:1.9;margin:0;color:#526b80}.installation-trust strong{font-weight:550;color:#244766}.installation-trust nav{display:flex;flex-wrap:wrap;gap:12px 26px;margin-top:16px;font-size:13px;color:#176f96}.installation-coverage{border-top:1px solid #e5ebf0}.coverage-regions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 28px}.coverage-regions>a{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:19px 0;border-bottom:1px solid #e2eaf0;font-size:15px;color:#245a7b}.coverage-regions>a:hover{color:#0d7fa9}.coverage-regions>a>span:last-child{color:#8babc1}.coverage-hcm{margin-top:30px}.installation-coverage .coverage-hcm h3{font-size:17px;font-weight:500;margin:0 0 8px}.coverage-hcm p{font-size:13px;line-height:1.85;color:#718293;margin:0 0 16px}.coverage-hcm nav{display:flex;flex-wrap:wrap;gap:14px 24px;font-size:13px;color:#176f96}.installation-proof a:focus-visible,.installation-experience a:focus-visible,.installation-coverage a:focus-visible{outline:2px solid #176f96;outline-offset:4px}@media(max-width:767px){.installation-proof,.installation-experience,.installation-coverage{padding-top:28px;padding-bottom:28px}.proof-heading{align-items:flex-start;flex-direction:column;gap:15px}.proof-gallery,.experience-grid{grid-template-columns:minmax(0,1fr);gap:28px}.proof-gallery figcaption{padding-top:14px}.proof-photo img{aspect-ratio:4/3}.experience-grid article{padding-top:20px;gap:14px}.installation-trust{padding:22px}.coverage-regions{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.coverage-regions>a{font-size:14px}.installation-trust nav{gap:14px 20px}}
@media(prefers-reduced-motion:reduce){.proof-photo img{transition:none}.proof-photo:hover img{transform:none}}
</style>
