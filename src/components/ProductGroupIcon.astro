---
// Match the line icons used on the homepage product cards.
interface Props { slug: string; }
const { slug } = Astro.props;
const icons: Record<string,string> = {
  'decal-mo-dan-kinh': '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 6v12m4-12v12m4-12v12"/>',
  'phim-cach-nhiet-nha-kinh': '<path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/><circle cx="12" cy="12" r="4"/><path d="m10 12 2 2 3-4"/>',
  'film-dan-noi-that': '<path d="M4 4h16v16H4zM8 4c-3 5 3 5 0 10s1 6 1 6M14 4c-3 5 3 5 0 10s1 6 1 6M18 4v16"/>',
  'decal-dan-kinh-van-phong': '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M12 3v18M7 13v4m10-4v4"/>',
  'film-bao-ve-noi-that': '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>',
  'film-trang-tri-kinh': '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 6v12m4-12v12m4-12v12"/>',
  'decal-quang-cao': '<path d="m3 10 14-5v14L3 14v-4ZM7 16l1 5h4l-2-5M21 8v8M3 10H1v4h2"/>',
};
---
<span class="product-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[slug] ?? icons['decal-mo-dan-kinh']} /></span>
<style>
.product-group-icon { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: white; color: #006edc; }
.product-group-icon svg { width: 27px; height: 27px; }
</style>
