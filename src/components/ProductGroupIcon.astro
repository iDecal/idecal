---
import { productGroupIcons } from '../data/product-group-icons';
// Match the line icons used on the homepage product cards.
interface Props { slug: string; }
const { slug } = Astro.props;

---
<span class="product-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={productGroupIcons[slug] ?? productGroupIcons['decal-mo-dan-kinh']} /></span>
<style>
.product-group-icon { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: white; color: #006edc; }
.product-group-icon svg { width: 27px; height: 27px; }
</style>
