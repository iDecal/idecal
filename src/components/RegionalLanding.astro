---
import LocalInstallationPhotos from './LocalInstallationPhotos.astro';
import LocalAreaFaq from './LocalAreaFaq.astro';
import LocalRelatedPosts from './LocalRelatedPosts.astro';
import LocalNearbyAreas from './LocalNearbyAreas.astro';
import {getAreaFaqs,areaFaqSchema} from '../data/local-area-content';

import DistrictDirectory from './DistrictDirectory.astro';
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import { type Region } from '../data/regions';
import type { RegionalPageContent } from '../data/regional-content';
import '../styles/regional-landing.css';
interface Props { region: Region; content: RegionalPageContent; projects: CollectionEntry<'projects'>[]; }
const {region,content,projects} = Astro.props;
const faqs = content.faqs.length ? content.faqs : region.faqs;
const localFaq=getAreaFaqs(region.slug,faqs);
const steps = [
  {title:'Gửi hiện trạng',text:'Chia sẻ địa chỉ, ảnh kính, kích thước và mẫu mong muốn.'},
  {title:'Chọn mẫu & vật liệu',text:'Tư vấn chất liệu, thiết kế và cách chia ô theo không gian.'},
  {title:'Xác nhận báo giá',text:'Thống nhất khối lượng, phạm vi công việc và lịch thực hiện.'},
  {title:'Thi công & bàn giao',text:'Chuẩn bị bề mặt, thi công và hướng dẫn vệ sinh, sử dụng.'},
];
---
<Layout title={`${content.title} | iDecal`} description={content.description} image={content.heroImage} structuredData={[areaFaqSchema(localFaq.items)]}>
  <div class="regional-landing">
    <section class="regional-hero"><div class="container"><div class="regional-hero-grid"><div><p class="regional-eyebrow">Dịch vụ tại {region.name}</p><h1 class="brand-heading">{content.title}</h1><p class="regional-lead">{content.lead}</p><div class="regional-actions"><a href="https://zalo.me/0866077040" class="btn-primary-solid">Tư vấn qua Zalo</a><a href="#dich-vu" class="btn-idecal-bold">Xem dịch vụ ↓</a></div><a href="tel:0866077040" class="regional-phone">Hotline 0866.077.040</a></div><figure class="regional-hero-photo"><img src={content.heroImage} alt={content.imageAlt} width="900" height="675" fetchpriority="high" /></figure></div></div></section>
    <nav class="regional-jump" aria-label={`Nội dung trang ${region.name}`}><div class="container"><a href="#dich-vu">Dịch vụ</a><a href="#dia-ban">Địa bàn</a><a href="#bao-gia">{content.prices.length ? 'Bảng giá' : 'Thông tin báo giá'}</a><a href="#quy-trinh">Quy trình</a><a href="#cau-hoi">Câu hỏi thường gặp</a></div></nav>
    {region.slug==='tp-hcm'&&<DistrictDirectory />}
    <section id="dich-vu" class="container regional-section"><div class="regional-heading"><p class="regional-kicker">Giải pháp cho từng không gian</p><h2 class="brand-heading">Dịch vụ Decal tại {region.name}</h2>{content.introduction.map(paragraph=><p>{paragraph}</p>)}</div><div class="regional-service-grid">{content.services.map((service,index)=><article class="regional-service-card"><div><span aria-hidden="true">0{index+1}</span><h3>{service.title}</h3></div><p>{service.text}</p><a href={`/dich-vu/${service.slug}`}>Xem dịch vụ<span aria-hidden="true">→</span></a></article>)}</div></section>
    <section id="dia-ban" class="regional-soft"><div class="container regional-section regional-local-grid"><div><p class="regional-kicker">Địa bàn phục vụ</p><h2 class="brand-heading">Trao đổi vị trí công trình</h2><ul class="regional-areas">{content.areas.map(area=><li>{area}</li>)}</ul><p class="regional-body">{content.areaNote}</p></div><div class="regional-benefits"><h3>Vì sao chọn iDecal?</h3>{content.benefits.map(benefit=><div class="regional-benefit"><span aria-hidden="true">✓</span><div><h4>{benefit.title}</h4><p>{benefit.text}</p></div></div>)}</div></div></section>
    <section id="bao-gia" class="container regional-section"><div class="regional-heading"><p class="regional-kicker">Chi phí & phạm vi thực hiện</p><h2 class="brand-heading">{content.prices.length ? `Bảng giá tham khảo tại ${region.name}` : `Báo giá công trình tại ${region.name}`}</h2><p>{content.priceNote}</p></div>{content.prices.length > 0 && <div class="regional-price-scroll" tabindex="0" role="region" aria-label={`Bảng giá Decal ${region.name}`}><table><caption class="sr-only">Bảng giá tham khảo Decal Đồng Nai theo tài liệu 2026</caption><thead><tr><th scope="col">Hạng mục</th><th scope="col">Giá tham khảo</th><th scope="col">Ghi chú</th></tr></thead><tbody>{content.prices.map(row=><tr><th scope="row">{row.item}</th><td>{row.price}</td><td>{row.note || '—'}</td></tr>)}</tbody></table></div>}<div class="regional-quote-info"><div><h3>Thông tin nên gửi</h3><p>Địa chỉ, ảnh hiện trạng, kích thước từng ô kính, mẫu hoặc file logo và thời gian mong muốn. Cho biết nếu cần tháo lớp Decal cũ.</p></div><a href="/dich-vu#bang-gia-dich-vu" class="btn-idecal-bold">Xem bảng giá dịch vụ →</a></div></section>
    <section id="quy-trinh" class="regional-soft"><div class="container regional-section"><div class="regional-heading"><p class="regional-kicker">Cách đặt dịch vụ</p><h2 class="brand-heading">Bốn bước từ tư vấn đến bàn giao</h2></div><ol class="regional-steps">{steps.map((step,index)=><li><span aria-hidden="true">0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>
    <LocalInstallationPhotos areaKey={region.slug} areaName={region.name} showProjectsLink={projects.length===0 && content.references.length===0} />
    {(projects.length>0 || content.references.length>0) && <section class="container regional-section"><div class="regional-heading"><p class="regional-kicker">Ứng dụng thực tế</p><h2 class="brand-heading">Công trình tham khảo</h2></div>{projects.length>0 && <div class="regional-projects">{projects.map(project=><ProjectCard project={project} />)}</div>}{content.references.length>0 && <details class="regional-references"><summary>Hạng mục được giới thiệu tại {region.name}<span aria-hidden="true">+</span></summary><ul>{content.references.map(reference=><li>{reference}</li>)}</ul></details>}<a href="/du-an" class="regional-project-link">Xem hồ sơ công trình iDecal →</a></section>}
    <LocalAreaFaq title={localFaq.title} items={localFaq.items} />
    <LocalRelatedPosts areaKey={region.slug} areaName={region.shortName} services={region.serviceSlugs} />
    <LocalNearbyAreas areaKey={region.slug} />
  </div>
</Layout>
