---
interface Props {
  name: string;
  logo?: { src: string; width: number; height: number; layout?: string };
}
const { name, logo } = Astro.props;
---
<span class:list={['product-brand-logo',logo?.layout&&`product-brand-logo--${logo.layout}`]}>
  {logo ? <><img src={logo.src} alt={`Logo thương hiệu ${name}`} title={`Logo thương hiệu ${name}`} width={logo.width} height={logo.height} loading="lazy" decoding="async" />{logo.layout==='symbol'&&<span>{name}</span>}</> : <span>{name}</span>}
</span>
<style>
  .product-brand-logo{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:72px;overflow:hidden;color:#1b4f7a;font-size:22px;font-weight:600;line-height:1.3}
  img{display:block;width:100%;height:100%;object-fit:contain}
  .product-brand-logo--square-wordmark img{height:auto;max-height:none;flex-shrink:0}
  .product-brand-logo--symbol img{width:44px;height:44px;flex:0 0 44px}
  .product-brand-logo--symbol{color:#001c55}
  @media(max-width:767px){.product-brand-logo{height:64px;font-size:20px}.product-brand-logo--symbol{gap:8px}.product-brand-logo--symbol img{width:36px;height:36px;flex-basis:36px}}
  @media(max-width:359px){.product-brand-logo{font-size:18px}.product-brand-logo--symbol img{width:28px;height:28px;flex-basis:28px}}
</style>
