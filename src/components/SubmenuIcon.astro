---
import { productGroupIcons } from '../data/product-group-icons';
interface Props { href: string; }
const { href } = Astro.props;
const productIcon = href.startsWith('/danh-muc-san-pham/') ? productGroupIcons[href.split('/').filter(Boolean).at(-1) ?? ''] : undefined;
const path = href.startsWith('/khu-vuc')
  ? 'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z'
  : href.includes('cach-nhiet')
  ? 'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'
  : href.includes('/cat-decal')
  ? 'M6 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM8.2 8.2 21 21M8.2 15.8 21 3'
  : /thiet-ke|logo|open-time/.test(href)
  ? 'm15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15v5Z'
  : /film-(?:dan-)?noi-that/.test(href)
  ? 'M3 3h18v18H3zM3 9h18M9 9v12'
  : href.includes('bao-ve')
  ? 'M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7l-9-4Zm-4 9 3 3 5-6'
  : /in-decal/.test(href)
  ? 'M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6z'
  : /thi-cong|tron-goi/.test(href)
  ? 'm3 21 6-6M14 3l7 7-5 5-7-7 5-5ZM3 3l5 5'
  : /decal-mo|van-phong|trang-tri-kinh/.test(href)
  ? 'M4 3h16v18H4zM4 9h16M4 15h16M12 3v18'
  : /quang-cao|standee/.test(href)
  ? 'M5 3h14v14H5zM12 17v4M8 21h8M8 7h8M8 11h5'
  : 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z';
---
<span class="submenu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={productIcon ?? `<path d="${path}" />`} /></svg></span>
<style>
  .submenu-icon { display: inline-flex; flex: 0 0 30px; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 8px; background: #edf4ff; color: #006edc; }
  svg { width: 17px; height: 17px; }
</style>
