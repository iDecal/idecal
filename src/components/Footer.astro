---
import SocialLinks from './SocialLinks.astro';
import {regions} from '../data/regions';
import {serviceOfferings} from '../data/site-offerings';
import {contactLocations} from '../data/contact-locations';
const groups=[
 {title:'Dịch vụ',links:serviceOfferings.map(s=>({name:s.name,href:`/dich-vu/${s.slug}/`}))},
 {title:'Vật liệu & giải pháp',links:[{name:'Decal mờ dán kính',href:'/decal-mo-dan-kinh/'},{name:'Phim cách nhiệt',href:'/phim-cach-nhiet-nha-kinh/'},{name:'Film dán nội thất',href:'/dich-vu-film-dan-noi-that/'},{name:'Film bảo vệ',href:'/film-bao-ve-noi-that/'},{name:'Decal vân sóng',href:'/decal-dan-kinh-3d-van-song/'}]},
 {title:'Khu vực phục vụ',links:regions.map(r=>({name:r.shortName,href:`/khu-vuc/${r.slug}/`}))},
 {title:'Khám phá',links:[{name:'Giới thiệu iDecal',href:'/gioi-thieu-idecal/'},{name:'Công trình thực tế',href:'/du-an/'},{name:'Vật liệu Decal',href:'/blog/'},{name:'Hướng dẫn đo kính',href:'/huong-dan-do-kinh/'},{name:'Liên hệ',href:'/lien-he-idecal/'}]},
];
---
<footer id="site-footer" class="site-footer footer-reference" aria-label="Thông tin và liên hệ iDecal">
 <div class="container">
  <div class="footer-introduction">
   <div class="footer-brand"><div class="footer-brand-heading"><a class="footer-logo" href="/" aria-label="iDecal – trang chủ"><img src="/images/idecal-logo.png" alt="Logo iDecal" width="46" height="46"/></a><p class="footer-brand-label">Thiết kế · In ấn · Thi công Decal & film</p></div><p class="footer-description">Giải pháp Decal và film cho kính, nội thất và nhận diện thương hiệu. Bắt đầu từ không gian và điều bạn muốn thay đổi.</p></div>
   <div class="footer-direct"><p class="footer-overline">Cùng trao đổi về không gian của bạn</p><a class="footer-phone" href="tel:0866077040">0866 077 040</a><div class="footer-direct-actions"><a class="footer-zalo" href="https://zalo.me/0866077040">Tư vấn qua Zalo <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="footer-email" href="mailto:hi@idecal.vn">hi@idecal.vn</a></div></div>
  </div>
  <nav class="footer-nav-grid" aria-label="Điều hướng cuối trang">{groups.map(group=><details class="footer-link-group" open><summary><h3>{group.title}</h3><span class="footer-toggle" aria-hidden="true">+</span></summary><ul>{group.links.map(link=><li><a href={link.href}>{link.name}</a></li>)}</ul></details>)}</nav>
  <div class="footer-connections"><details class="footer-locations"><summary>Địa chỉ iDecal <span aria-hidden="true">+</span></summary><div class="footer-location-grid">{contactLocations.map(location=><address><strong>{location.name}</strong><span>{location.address}</span></address>)}</div></details><SocialLinks compact dark label="Kết nối với iDecal trên mạng xã hội" /></div>
  <div class="footer-bottom"><p>© {new Date().getFullYear()} iDecal. All rights reserved.</p><p>Chọn vật liệu phù hợp. Hoàn thiện không gian.</p></div>
 </div>
</footer>
<script>
 const groups=[...document.querySelectorAll<HTMLDetailsElement>('.footer-link-group')];
 const desktop=matchMedia('(min-width:768px)');
 const sync=()=>groups.forEach(group=>{group.open=desktop.matches;const summary=group.querySelector('summary');if(summary)summary.tabIndex=desktop.matches?-1:0;});sync();desktop.addEventListener('change',sync);
 for(const group of groups){group.querySelector('summary')?.addEventListener('click',event=>{if(desktop.matches)event.preventDefault();});group.addEventListener('toggle',()=>{if(!desktop.matches&&group.open)groups.forEach(other=>{if(other!==group)other.open=false;});});}
</script>
<style>
.site-footer{color:#c7d4e2;padding:56px 0 0;}
.footer-introduction{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-bottom:44px;border-bottom:1px solid #ffffff25;}
.footer-logo{display:inline-flex;align-items:center;gap:14px;color:#fff;min-height:48px;}.footer-logo span{font-size:36px;font-weight:600;letter-spacing:-1.4px;}.footer-logo img{width:46px;height:46px;}
.footer-brand-heading{display:flex;align-items:center;gap:18px;margin-bottom:22px;}.footer-brand-label{margin:0;font-size:12px;font-weight:600;letter-spacing:.08em;color:#e6c85b;}
.footer-description{max-width:430px;font-size:14px;line-height:1.9;margin:0;color:#bfcddd;}
.footer-overline{font-size:12px;letter-spacing:.08em;font-weight:500;color:#bfcddd;margin:0 0 18px;}
.footer-phone{display:inline-block;color:#fff;font-size:clamp(32px,3.5vw,46px);font-weight:450;letter-spacing:-1.5px;line-height:1.4;}
.footer-direct-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:24px;}.footer-zalo{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:48px;padding:12px 24px;border-radius:999px;background:#e6c85b;color:#102e57;font-weight:600;font-size:14px;}.footer-zalo:hover{background:#f2db83;}.footer-email{display:inline-flex;align-items:center;min-height:48px;color:#c7d4e2;font-size:14px;}
.footer-nav-grid{display:grid;grid-template-columns:1fr 1.25fr 1fr 1fr;gap:44px;padding:38px 0 30px;}.footer-link-group summary{list-style:none;pointer-events:none;}.footer-link-group summary::-webkit-details-marker,.footer-locations summary::-webkit-details-marker{display:none;}.footer-link-group h3{margin:0 0 20px;font-size:14px;font-weight:600;line-height:1.5;letter-spacing:.03em;}.footer-toggle{display:none;}.footer-link-group ul{list-style:none;padding:0;margin:0;}.footer-link-group li a{display:flex;align-items:center;min-height:40px;font-size:14px;line-height:1.6;color:#c0cfe0;}.footer-link-group a:hover,.footer-email:hover{color:#fff;text-decoration:none;}
.footer-connections{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;padding-bottom:22px;}.footer-locations{flex:1;min-width:0;}.footer-locations summary{display:flex;align-items:center;gap:20px;min-height:48px;list-style:none;cursor:pointer;font-size:13px;color:#c7d4e2;}.footer-locations[open] summary>span{transform:rotate(45deg);}.footer-location-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;padding:14px 0;}.footer-location-grid address{font-style:normal;font-size:12px;line-height:1.9;color:#bfcddd;}.footer-location-grid strong{display:block;color:#e0e8f1;font-weight:500;}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff25;padding:20px 0;}.footer-bottom p{font-size:12px;line-height:1.7;margin:0;color:#b4c4d5;}.site-footer a:focus-visible,.site-footer summary:focus-visible{outline:2px solid #f2db83;outline-offset:4px;}.site-footer :global(.social-links--compact a){width:40px;height:40px;min-height:40px;padding:10px;border:0;background:transparent;border-radius:8px;}.site-footer :global(.social-links--compact){gap:4px;}
@media(max-width:1000px){.footer-introduction{gap:44px;}.footer-nav-grid{gap:24px;}.footer-connections{flex-direction:column;}.footer-locations{width:100%;}}
@media(max-width:767px){.site-footer{padding-top:32px;}.footer-introduction{grid-template-columns:1fr;gap:28px;padding-bottom:28px;}.footer-logo span{font-size:30px;}.footer-brand-heading{gap:14px;margin-bottom:18px;}.footer-brand-label{margin:0;font-size:11px;letter-spacing:.02em;}.footer-direct-actions{gap:20px;margin-top:16px;}.footer-phone{font-size:36px;}.footer-nav-grid{display:block;padding:20px 0;}.footer-link-group{border-bottom:1px solid #ffffff20;}.footer-link-group summary{display:flex;align-items:center;justify-content:space-between;min-height:58px;pointer-events:auto;cursor:pointer;}.footer-link-group h3{margin:0;font-size:15px;}.footer-toggle{display:block;font-size:22px;color:#d0ddea;}.footer-link-group[open] .footer-toggle{transform:rotate(45deg);}.footer-link-group ul{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;padding-bottom:16px;}.footer-link-group li a{min-height:48px;font-size:13px;}.footer-connections{gap:18px;}.footer-location-grid{grid-template-columns:1fr;gap:16px;}.footer-bottom{flex-direction:column;align-items:flex-start;gap:6px;}.site-footer :global(.social-links--compact){display:flex;flex-wrap:wrap;gap:4px;}.site-footer :global(.social-links--compact a){width:44px;height:48px;min-height:48px;}}
</style>
