---
import SocialLinks from './SocialLinks.astro';
import {contactLocations} from '../data/contact-locations';
---
<footer id="site-footer" class="site-footer footer-reference" aria-label="Thông tin và liên hệ iDecal">
 <div class="container">
  <div class="footer-introduction">
   <div class="footer-brand">
    <a class="footer-logo" href="/" aria-label="iDecal – trang chủ"><img src="/images/idecal-logo.png" alt="Logo iDecal" width="52" height="52"/></a>
    <p class="footer-description">Giải pháp Decal và film cho kính, nội thất và nhận diện thương hiệu.</p>
    <SocialLinks compact dark label="Kết nối với iDecal trên mạng xã hội" />
   </div>
   <div class="footer-direct">
    <p class="footer-overline">Cùng trao đổi về không gian của bạn</p>
    <a class="footer-phone" href="tel:0866077040">
     <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2 16 16 0 0 0 16 16 2 2 0 0 0 2-2v-3l-5-2-2 2a12 12 0 0 1-6-6l2-2z"/>
     </svg>
     0866 077 040
    </a>
    <div class="footer-direct-actions">
     <a class="footer-zalo" href="https://zalo.me/0866077040">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
       <path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/>
       <path d="M8 12h8"/>
      </svg>
      Tư vấn qua Zalo
      <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 19 19 5M5 5h14v14"/></svg>
     </a>
     <a class="footer-email" href="mailto:hi@idecal.vn">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
       <rect x="3" y="5" width="18" height="14" rx="2"/>
       <path d="m3 7 9 6 9-6"/>
      </svg>
      hi@idecal.vn
     </a>
    </div>
   </div>
  </div>
  <section class="footer-addresses" aria-label="Địa chỉ iDecal">
   <div class="footer-location-grid">
    {contactLocations.map(location => (
     <address>
      <strong>
       <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/>
        <circle cx="12" cy="10" r="2.5"/>
       </svg>
       {location.name}
      </strong>
      <span>{location.address}</span>
     </address>
    ))}
   </div>
  </section>
  <div class="footer-bottom"><p>© {new Date().getFullYear()} iDecal. All rights reserved.</p><p>Chọn vật liệu phù hợp. Hoàn thiện không gian.</p></div>
 </div>
</footer>
<style>
.site-footer{color:#c7d4e2;padding-top:38px;}
.footer-introduction{display:grid;grid-template-columns:1.1fr 1fr;gap:80px;align-items:center;padding-bottom:30px;}
.footer-brand{min-width:0;}
.footer-logo{display:inline-flex;align-items:center;min-height:52px;}.footer-logo img{width:52px;height:52px;}
.footer-description{max-width:380px;font-size:14px;line-height:1.8;margin:16px 0 18px;color:#bfcddd;}
.footer-overline{font-size:12px;letter-spacing:.04em;color:#bfcddd;margin:0 0 12px;}
.footer-phone{display:inline-flex;align-items:center;gap:10px;min-height:48px;color:#fff;font-size:clamp(32px,3.5vw,44px);font-weight:450;letter-spacing:-1px;line-height:1.4;}
.footer-direct-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:18px;}
.footer-zalo{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 22px;border-radius:999px;font-weight:600;font-size:14px;}.footer-email{display:inline-flex;align-items:center;gap:8px;min-height:48px;color:#c7d4e2;font-size:14px;}
.footer-direct svg,.footer-location-grid svg{flex-shrink:0;}
.footer-addresses{padding:24px 0;border-top:1px solid #ffffff25;}
.footer-location-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px;}
.footer-location-grid address{font-style:normal;font-size:13px;line-height:1.8;color:#bfcddd;}
.footer-location-grid strong{display:flex;align-items:center;gap:8px;margin-bottom:8px;color:#e0e8f1;font-weight:600;font-size:13px;}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff25;padding:18px 0;}
.footer-bottom p{font-size:12px;line-height:1.7;margin:0;color:#b4c4d5;}
.site-footer a:focus-visible{outline:2px solid var(--ui-accent-on-dark);outline-offset:4px;border-radius:4px;}
.site-footer :global(.social-links--compact){display:flex;flex-wrap:wrap;gap:4px;}
.site-footer :global(.social-links--compact a){width:42px;height:42px;min-height:42px;padding:10px;border:0;background:transparent;border-radius:8px;}
@media(max-width:900px){.footer-introduction{gap:36px;}.footer-location-grid{gap:24px;}}
@media(max-width:767px){
.site-footer{padding-top:28px;}.footer-introduction{grid-template-columns:1fr;gap:26px;padding-bottom:26px;}.footer-description{max-width:100%;}.footer-phone{font-size:34px;}.footer-direct-actions{gap:20px;margin-top:14px;}.footer-location-grid{grid-template-columns:1fr;gap:20px;}.footer-location-grid strong{margin-bottom:4px;}.footer-addresses{padding:22px 0;}.footer-bottom{flex-direction:column;align-items:flex-start;gap:5px;padding:16px 0;}.site-footer :global(.social-links--compact a){width:44px;height:48px;min-height:48px;}}
</style>
