---
import ProtectionIcon from './ProtectionIcon.astro';
import { products, formatPrice } from '../data/catalogue';
const films = [
  { slug:'phim-ppf-tph', title:'Film PPF bảo vệ nội thất', label:'Bảo vệ bề mặt',
    image:'/images/film-bao-ve/ppf-bao-ve-san-pham.webp', alt:'Mẫu film PPF bảo vệ bề mặt nội thất',
    intro:'Lớp film trong giúp giữ diện mạo bề mặt, hạn chế trầy xước nhẹ do tiếp xúc trong quá trình sử dụng.',
    advantages:['Giữ được màu sắc và vân của bề mặt bên dưới.','Hỗ trợ hạn chế trầy xước nhẹ trên nền tương thích.','Cắt theo kích thước, hoàn thiện theo mép và góc bo.'],
    specs:[['Độ dày tham khảo','7,5 mil · khoảng 190 µm'],['Quy cách cuộn','1,52 × 30 m'],['Bề mặt sử dụng','Nền phẳng, lớp hoàn thiện ổn định']],
    uses:'Mặt bàn, quầy tiếp khách, bàn đá và các chi tiết nội thất phù hợp sau khi thử độ bám.',
    note:'Thử mẫu trước khi dán trên sơn hoặc lớp phủ nhạy cảm. Khả năng tự phục hồi, độ bóng và tháo gỡ cần đối chiếu theo sản phẩm.' },
  { slug:'phim-bao-ve-kinh-safety-4ml', title:'Phim an toàn bảo vệ kính', label:'Bảo vệ hệ kính',
    image:'/images/film-bao-ve/phim-an-toan-kinh.webp', alt:'Mẫu phim an toàn trong suốt dùng bảo vệ kính',
    intro:'Film bám trên kính giúp giữ các mảnh vỡ khi kính vỡ, hỗ trợ giảm nguy cơ mảnh kính rơi hoặc văng.',
    advantages:['Lớp film trong, giữ tầm nhìn qua kính.','Hỗ trợ giữ mảnh kính nhờ lớp film và keo bám.','Tư vấn theo loại kính, kích thước và hệ khung.'],
    specs:[['Độ dày tham khảo','4 mil · khoảng 100 µm'],['Quy cách cuộn','1,52 × 30 m'],['Bề mặt sử dụng','Kính phù hợp sau khảo sát']],
    uses:'Cửa, vách kính, văn phòng, nhà ở và showroom có nhu cầu hỗ trợ giữ mảnh kính khi vỡ.',
    note:'Không làm kính trở thành kính không thể vỡ. Hiệu quả phụ thuộc loại kính, khung, phương án neo giữ và thi công; không thay thế yêu cầu kính an toàn của thiết kế.' },
].map(film => ({...film, product: products.find(product => product.slug === film.slug)!}));
const faqs = [
  {question:'Nên chọn film PPF hay phim an toàn kính?',answer:'Chọn PPF khi cần hạn chế trầy xước trên bề mặt nội thất tương thích. Chọn phim an toàn khi cần hỗ trợ giữ mảnh kính khi kính vỡ. Hai loại có thể dùng ở các vị trí khác nhau trong cùng công trình.'},
  {question:'Phim an toàn có chống vỡ kính và chống trộm không?',answer:'Kính vẫn có thể vỡ khi chịu tác động. Phim giúp liên kết và giữ mảnh vỡ; khả năng chịu tác động phụ thuộc toàn bộ hệ kính, film, keo và phương án neo giữ. Không mặc định film có khả năng chống trộm hoặc thay thế kính an toàn theo yêu cầu thiết kế.'},
  {question:'PPF có dán được lên mọi loại mặt bàn không?',answer:'Cần đánh giá vật liệu nền, lớp sơn hoặc phủ, độ phẳng và các góc bo. Với bề mặt nhạy cảm, nên thử trên vùng nhỏ để kiểm tra độ bám, diện mạo và ảnh hưởng khi tháo film.'},
  {question:'Báo giá film bảo vệ gồm những gì?',answer:'Báo giá theo loại film, diện tích và điều kiện thi công. Phần xử lý nền, tháo lớp cũ, bo cạnh hoặc neo giữ film kính, nếu cần, được xác nhận riêng. Gửi ảnh, kích thước và địa chỉ để iDecal tư vấn phương án cụ thể.'},
  {question:'Sau khi thi công cần vệ sinh như thế nào?',answer:'Tuân thủ thời gian chờ và hướng dẫn của mẫu film đã chọn. Dùng khăn mềm, tránh vật sắc và chất tẩy không tương thích; không cạy mép film. iDecal trao đổi cách bảo quản khi kiểm tra bàn giao.'},
];
---
<section id="mau-san-pham" class="container protection-guide" aria-labelledby="protection-guide-title">
  <div class="protection-intro"><p class="offering-kicker">Chọn theo bề mặt cần bảo vệ</p><h2 id="protection-guide-title">Hai loại film, hai nhu cầu bảo vệ</h2><p>Đối chiếu ứng dụng và thông số cơ bản để chọn film phù hợp với nội thất hoặc hệ kính của bạn.</p></div>
  <div class="protection-films">
    {films.map(film => <article class="protection-film" data-protection-film={film.slug}>
      <a class="protection-photo" href={`/san-pham/${film.slug}`} aria-label={`Xem chi tiết ${film.title.toLowerCase()}`}><img src={film.image} alt={film.alt} width="960" height="800" loading="lazy" decoding="async" /></a>
      <div class="protection-copy"><p class="film-label"><ProtectionIcon kind={film.slug === 'phim-ppf-tph' ? 'shield' : 'glass'} />{film.label}</p><h3>{film.title}</h3><p class="film-intro">{film.intro}</p>
        <h4><ProtectionIcon kind="benefits" />Ưu điểm</h4><ul>{film.advantages.map(advantage => <li>{advantage}</li>)}</ul>
        <h4><ProtectionIcon kind="specs" />Thông số cơ bản</h4><dl>{film.specs.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
        <h4><ProtectionIcon kind="uses" />Ứng dụng</h4><p>{film.uses}</p><p class="film-note">{film.note}</p>
        <div class="film-actions"><div><span>Giá tham khảo</span><strong>{formatPrice(film.product.price)}</strong></div><a href={`/san-pham/${film.slug}`}>Xem chi tiết <span aria-hidden="true">→</span></a></div>
      </div>
    </article>)}
  </div>
</section>
<section class="protection-faq-section" aria-labelledby="protection-faq-title"><div class="container protection-faq-layout">
  <div class="faq-intro"><p class="offering-kicker">Giải đáp trước khi chọn</p><h2 id="protection-faq-title">Bạn cần biết thêm điều gì?</h2><p>Chọn đúng film bắt đầu từ bề mặt và nhu cầu sử dụng thực tế.</p><a href="/lien-he-idecal">Gửi ảnh để được tư vấn <span aria-hidden="true">→</span></a><a class="faq-service" href="/dich-vu/thi-cong-decal">Tìm hiểu dịch vụ thi công →</a></div>
  <div class="protection-questions">{faqs.map(faq => <details><summary>{faq.question}<span class="faq-plus" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div>
</div></section>
<style>
  .protection-guide { padding-top:56px; padding-bottom:64px; scroll-margin-top:110px; }
  .protection-intro { max-width:740px; margin-bottom:36px; }
  h2 { font-size:30px; line-height:1.4; margin:0 0 16px; color:#244766; }
  h3 { font-size:26px; line-height:1.4; margin:0 0 14px; color:#244766; }
  h4 { display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600; color:#244766; margin:20px 0 9px; }
  p,li,dl { font-size:14px; line-height:1.75; color:#536579; }
  p { margin:0 0 12px; }
  .protection-film { display:grid; grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr); gap:48px; align-items:start; }
  @media(min-width:768px) { .protection-film:nth-child(even) .protection-photo { grid-column:2; grid-row:1; } .protection-film:nth-child(even) .protection-copy { grid-column:1; grid-row:1; } }
  .protection-film + .protection-film { margin-top:52px; padding-top:52px; border-top:1px solid #e1eaf4; }
  .protection-photo { display:block; overflow:hidden; border-radius:18px; background:#f3f6f8; }
  .protection-photo img { display:block; width:100%; height:auto; aspect-ratio:6/5; object-fit:cover; }
  .film-label { display:flex; align-items:center; gap:8px; color:#0d6b96; font-size:12px; font-weight:500; margin:0 0 9px; }
  .film-intro { font-size:15px; }
  ul { list-style:none; padding:0; margin:0; }
  li { position:relative; padding-left:17px; margin-bottom:5px; }
  li::before { content:''; position:absolute; top:11px; left:1px; width:5px; height:5px; border-radius:50%; background:#3296bb; }
  dl { margin:0; }
  dl div { display:grid; grid-template-columns:1fr 1.2fr; gap:12px; padding:8px 0; border-bottom:1px dashed #e1e7ee; }
  dt { color:#64748b; } dd { margin:0; color:#244766; }
  .film-note { color:#64748b; font-size:12px; margin-top:12px; }
  .film-actions { display:flex; align-items:center; justify-content:space-between; gap:18px; border:1px solid #cadff2; border-radius:12px; background:#edf5ff; margin-top:22px; padding:18px 20px; }
  .film-actions>div>span { display:block; font-size:11px; color:#55738b; margin-bottom:4px; }
  strong { display:block; font-size:15px; font-weight:500; color:#123d69; }
  .film-actions>a { display:inline-flex; align-items:center; justify-content:center; gap:18px; min-height:44px; padding:10px 18px; border:1px solid #b8d4ed; border-radius:8px; background:#f8fbff; color:#24527b; font-size:14px; font-weight:500; }
  .film-actions>a:hover { background:#dcecff; border-color:#8ab8dc; }
  a:focus-visible,summary:focus-visible { outline:2px solid #0d6b96; outline-offset:4px; }
  .protection-faq-section { background:linear-gradient(110deg,#f5f9fe,#faf8ff); padding:52px 0; margin-bottom:40px; }
  .protection-faq-layout { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:64px; }
  .faq-intro a { display:inline-flex; align-items:center; gap:16px; min-height:44px; color:#0d6b96; font-size:14px; }
  .faq-intro .faq-service { display:flex; font-size:12px; }
  details { border-bottom:1px solid #dfe7ef; }
  details:first-child { border-top:1px solid #dfe7ef; }
  summary { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:68px; padding:16px 0; cursor:pointer; list-style:none; color:#244766; font-size:15px; font-weight:500; line-height:1.6; }
  summary::-webkit-details-marker { display:none; }
  .faq-plus { position:relative; width:28px; height:28px; flex:0 0 28px; border:1px solid #d9e4ef; border-radius:50%; }
  .faq-plus::before,.faq-plus::after { content:''; position:absolute; background:#0d6b96; top:13px; left:8px; width:10px; height:1px; }
  .faq-plus::after { transform:rotate(90deg); } details[open] .faq-plus::after { display:none; }
  details>p { padding:0 44px 18px 0; margin:0; }
  @media(max-width:767px) { .protection-guide { padding-top:32px; padding-bottom:40px; } .protection-film,.protection-faq-layout { grid-template-columns:1fr; gap:24px; } .protection-film + .protection-film { margin-top:36px; padding-top:36px; } h2 { font-size:24px; } h3 { font-size:23px; } .protection-faq-section { padding:32px 0; } .protection-photo img { max-height:400px; } .film-actions { gap:10px; padding:14px; } .film-actions>a { padding:10px 14px; } }
</style>
