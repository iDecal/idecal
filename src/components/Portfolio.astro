---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id))
  .slice(0, 3);
---

<section id="portfolio" class="bg-surface py-20 md:py-24" aria-labelledby="portfolio-title">
  <div class="container">
    <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p data-heading-label class="!mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Dấu ấn iDecal</p>
        <h2 id="portfolio-title" class="brand-heading !mb-4">Công trình thực tế</h2>
        <p class="!mb-0 text-text-muted">Khám phá các công trình decal dán kính, trang trí và quảng cáo do iDecal thực hiện.</p>
      </div>
      <a href="/du-an" class="btn-idecal-bold shrink-0 self-start md:self-auto">Xem tất cả công trình <span aria-hidden="true">→</span></a>
    </div>
    {projects.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {projects.map(project => <ProjectCard project={project} />)}
      </div>
    ) : (
      <p>Các công trình đang được cập nhật. <a href="/lien-he-idecal" class="text-primary underline">Liên hệ để được tư vấn</a>.</p>
    )}
  </div>
</section>
