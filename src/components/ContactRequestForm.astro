---
import hcmWards from '../data/hcm-wards.json';
import { districts } from '../data/districts';
import { regions } from '../data/regions';
import { products } from '../data/catalogue';
import { isPVCProduct, pvcFinishes } from '../data/pvc-options';
import { serviceOfferings as services } from '../data/site-offerings';

const bookingData = {
  products: products.map(({slug, name}) => ({ slug, name, pvc: isPVCProduct(slug) })),
  regions: Object.fromEntries(regions.map(({slug, name}) => [slug, name])),
  districts: Object.fromEntries(districts.map(({slug, name}) => [slug, name])),
  wards: Object.fromEntries(hcmWards.units.filter(ward => ward.districtSlug).map(({slug, type, name}) => [slug, `${type.charAt(0).toUpperCase()}${type.slice(1)} ${name}`])),
  finishes: Object.fromEntries(pvcFinishes.map(({value, label}) => [value, label])),
};
---
<div class="booking-form-card">
  <div class="booking-form-heading">
    <h2>Thông tin đặt hàng</h2>
    <p>Điền thông tin để soạn tin nhắn gửi qua Zalo. Các mục có dấu <span aria-hidden="true">*</span> cần được điền.</p>
  </div>
  <div id="booking-product-info" class="booking-product" hidden>
    <span>Mẫu bạn quan tâm</span><strong id="booking-product-name"></strong><a id="booking-product-link" href="/san-pham">Xem lại sản phẩm</a>
  </div>
  <noscript><p>Vui lòng <a href="https://zalo.me/0866077040">nhắn Zalo iDecal</a> và gửi tên, số điện thoại cùng nhu cầu của bạn.</p></noscript>
  <form id="booking-form" class="booking-form" hidden>
    <div class="booking-form-grid">
      <div><label for="booking-name">Họ và tên <span aria-hidden="true">*</span></label><input id="booking-name" name="name" autocomplete="name" required maxlength="80" /></div>
      <div><label for="booking-phone">Số điện thoại <span aria-hidden="true">*</span></label><input id="booking-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required minlength="9" maxlength="20" /></div>
      <div class="booking-full"><label for="booking-service">Nhu cầu <span aria-hidden="true">*</span></label><select id="booking-service" name="service" required><option value="">Chọn nhu cầu</option><option value="mua-san-pham">Mua sản phẩm / vật liệu</option>{services.map(service => <option value={service.slug}>{service.name}</option>)}</select></div>
      <div class="booking-full"><label for="booking-notes">Ghi chú <span class="booking-optional">(nếu có)</span></label><textarea id="booking-notes" name="notes" rows="2" maxlength="1500" placeholder="Ví dụ: mẫu bạn thích, kích thước hoặc khu vực thi công"></textarea></div>
    </div>
    <div class="booking-form-actions"><button type="submit" class="btn-primary-solid">Soạn yêu cầu đặt hàng</button><button type="reset" class="booking-reset">Điền lại</button></div>
  </form>
  <section id="booking-preview" class="booking-preview" hidden aria-labelledby="booking-preview-title">
    <h2 id="booking-preview-title" tabindex="-1">Yêu cầu đã được soạn</h2>
    <p>Sao chép nội dung rồi mở Zalo để gửi cho iDecal.</p>
    <label for="booking-message" class="sr-only">Nội dung yêu cầu đặt hàng</label>
    <textarea id="booking-message" rows="7" readonly></textarea>
    <div class="booking-preview-actions">
      <button id="booking-copy" type="button">1. Sao chép yêu cầu</button>
      <a href="https://zalo.me/0866077040" target="_blank" rel="noopener noreferrer" class="btn-primary-solid">2. Mở Zalo gửi yêu cầu</a>
    </div>
    <p id="booking-copy-status" role="status" aria-live="polite"></p>
  </section>
</div>
<script type="application/json" id="booking-product-data" set:html={JSON.stringify(bookingData).replaceAll('<', '\\u003c')} />
<script>import '../scripts/booking';</script>
