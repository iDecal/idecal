---
import { getServiceCta } from '../data/service-cta';
interface Props { service?:string; }
const {service}=Astro.props;
const cta=getServiceCta(service);
---
<section class="container service-consultation" aria-label="Tư vấn dịch vụ cùng iDecal">
 <div class="consultation-card">
  <div class="consultation-main">
   <div class="consultation-heading"><span>Bắt đầu cùng iDecal</span></div>
   <h2>{cta.title}</h2><p>{cta.description}</p>
  </div>
  <div class="consultation-actions">
   <a href={cta.href} class="consultation-primary"><span>{cta.action}</span><span class="consultation-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
   <a href="https://zalo.me/0866077040" class="consultation-secondary"><span>Nhắn Zalo iDecal</span></a>
   <span class="consultation-note">Trao đổi nhu cầu trước khi đặt dịch vụ</span>
  </div>
  <nav class="consultation-links" aria-label="Thông tin trước khi đặt dịch vụ"><a href="/blog/cach-do-kich-thuoc-kinh-truoc-khi-dat-decal">Hướng dẫn đo kính</a><a href="/dich-vu#bang-gia-dich-vu">Bảng giá tham khảo</a><a href="/du-an">Công trình thực tế</a></nav>
 </div>
</section>
<style>
.service-consultation{padding-top:40px;padding-bottom:48px;color:#21455e}.consultation-card{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(250px,.85fr);gap:30px 64px;align-items:center;overflow:hidden;padding:40px 42px 0;border:1px solid #e0e8ef;border-radius:24px;background:radial-gradient(ellipse at 100% 0%,#e8edffb3,transparent 62%),linear-gradient(110deg,#fff 25%,#f8fbff);box-shadow:0 16px 48px -26px #123c6338}.consultation-heading{display:flex;align-items:center;gap:13px;font-size:12px;letter-spacing:.025em;color:#5a7389;margin-bottom:22px}.service-consultation .consultation-main h2{font-size:clamp(24px,2.4vw,31px);line-height:1.4;font-weight:550;letter-spacing:-.035em;margin:0 0 16px;color:#173c59;max-width:590px}.service-consultation .consultation-main>p{font-size:15px;line-height:1.85;color:#627487;margin:0;max-width:570px}.consultation-actions{display:grid;gap:12px;position:relative}.consultation-primary,.consultation-secondary{display:flex;align-items:center;justify-content:center;gap:12px;border-radius:12px;min-height:54px;padding:10px 18px;font-size:14px;font-weight:550;text-align:center;transition:transform .18s,box-shadow .18s,background .18s}.consultation-primary{justify-content:space-between;color:#fff;background:linear-gradient(110deg,#146f9c,#3857aa);box-shadow:0 8px 20px -8px #1b5c9b70}.consultation-arrow{display:grid;place-items:center;border-radius:50%;width:32px;height:32px;flex-shrink:0;background:#ffffff20}.consultation-arrow svg{width:19px;height:19px}.consultation-secondary{border:1px solid #d6e2ee;background:#ffffffb3;color:#285b7c}.consultation-primary:hover{transform:translateY(-2px);box-shadow:0 12px 24px -8px #1b5c9b70}.consultation-secondary:hover{background:#fff;border-color:#9fbcd5}.consultation-note{text-align:center;font-size:11px;color:#7b8a99;margin-top:3px;line-height:1.6}.consultation-links{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:14px 30px;padding:22px 0 24px;border-top:1px solid #dfe7f0}.consultation-links a{display:flex;align-items:center;gap:9px;font-size:12px;color:#52728b;padding:4px 0}.consultation-links a:hover{color:#146f9c}.service-consultation a:focus-visible{outline:2px solid #146f9c;outline-offset:5px}@media(max-width:900px){.consultation-card{gap:26px 32px;padding:30px 28px 0;grid-template-columns:minmax(0,1fr) minmax(225px,.8fr)}}@media(max-width:767px){.service-consultation{padding-top:28px;padding-bottom:32px}.consultation-card{grid-template-columns:minmax(0,1fr);padding:26px 22px 0;gap:24px;border-radius:20px}.consultation-heading{margin-bottom:18px}.service-consultation .consultation-main h2{font-size:25px;margin-bottom:14px}.service-consultation .consultation-main>p{font-size:14px;line-height:1.85}.consultation-primary,.consultation-secondary{min-height:52px}.consultation-links{padding:18px 0 22px;gap:14px;align-items:flex-start;flex-direction:column}.consultation-links a{font-size:12px}}
@media(prefers-reduced-motion:reduce){.consultation-primary,.consultation-secondary{transition:none}.consultation-primary:hover{transform:none}}
</style>
