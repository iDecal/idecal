---
import { getServiceCta } from '../data/service-cta';
interface Props { service?:string; }
const {service}=Astro.props;
const cta=getServiceCta(service);
const icons:Record<string,string>={
 'thiet-ke':'m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15v5Z',
 'in-decal':'M6 9V3h12v6M6 18H3V9h18v9h-3M6 14h12v7H6zM17 11h1',
 'cat-decal':'M6 6 20 20M6 18 20 4M3 3a3 3 0 1 0 6 0 3 3 0 1 0-6 0M3 21a3 3 0 1 0 6 0 3 3 0 1 0-6 0',
 'phim-cach-nhiet':'M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M8 12a4 4 0 1 0 8 0 4 4 0 1 0-8 0',
 'film-noi-that':'m3 6 9-4 9 4-9 4-9-4Zm0 6 9 4 9-4M3 18l9 4 9-4',
};
const icon=icons[service??'']??'M4 3h16v18H4zM12 3v18M4 12h16';
---
<section class="container service-consultation" aria-label="Tư vấn dịch vụ cùng iDecal">
 <div class="consultation-card">
  <svg class="consultation-art" aria-hidden="true" viewBox="0 0 300 300" fill="none"><rect x="55" y="35" width="180" height="230" rx="22"/><path d="M55 150h180M145 35v230M75 95l50-40M165 245l50-40"/><circle cx="246" cy="70" r="27"/></svg>
  <div class="consultation-main">
   <div class="consultation-heading"><span class="consultation-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icon}/></svg></span><span>Bắt đầu cùng iDecal</span></div>
   <h2>{cta.title}</h2><p>{cta.description}</p>
  </div>
  <div class="consultation-actions">
   <a href={cta.href} class="consultation-primary"><span>{cta.action}</span><span class="consultation-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
   <a href="https://zalo.me/0866077040" class="consultation-secondary"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11a8 8 0 0 1-8 8H7l-4 3V11a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z"/><path d="M8 9h8M8 13h5"/></svg><span>Nhắn Zalo iDecal</span></a>
   <span class="consultation-note">Trao đổi nhu cầu trước khi đặt dịch vụ</span>
  </div>
  <nav class="consultation-links" aria-label="Thông tin trước khi đặt dịch vụ"><a href="/blog/cach-do-kich-thuoc-kinh-truoc-khi-dat-decal"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 17 14-14 4 4L7 21Zm5-5 3 3m1-7 3 3"/></svg>Hướng dẫn đo kính<span aria-hidden="true">→</span></a><a href="/dich-vu#bang-gia-dich-vu"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 3h9l8 8-10 10-8-8V4ZM8 8h.01"/></svg>Bảng giá tham khảo<span aria-hidden="true">→</span></a><a href="/du-an"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m3 17 6-6 4 4 3-3 5 5M8 7h.01"/></svg>Công trình thực tế<span aria-hidden="true">→</span></a></nav>
 </div>
</section>
<style>
.service-consultation{padding-top:40px;padding-bottom:48px;color:#21455e}.consultation-card{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(250px,.85fr);gap:30px 64px;align-items:center;overflow:hidden;padding:40px 42px 0;border:1px solid #e0e8ef;border-radius:24px;background:radial-gradient(ellipse at 100% 0%,#e8edffb3,transparent 62%),linear-gradient(110deg,#fff 25%,#f8fbff);box-shadow:0 16px 48px -26px #123c6338}.consultation-art{position:absolute;z-index:-1;width:300px;height:300px;right:-60px;top:-105px;stroke:#607bbb;stroke-width:1;opacity:.14;transform:rotate(16deg);pointer-events:none}.consultation-heading{display:flex;align-items:center;gap:13px;font-size:12px;letter-spacing:.025em;color:#5a7389;margin-bottom:22px}.consultation-icon{display:grid;place-items:center;width:46px;height:46px;flex-shrink:0;border-radius:14px;background:linear-gradient(135deg,#e9f6fc,#efedfb);border:1px solid #dce8f3;color:#2179aa}.consultation-icon svg{width:23px;height:23px}.service-consultation .consultation-main h2{font-size:clamp(24px,2.4vw,31px);line-height:1.4;font-weight:550;letter-spacing:-.035em;margin:0 0 16px;color:#173c59;max-width:590px}.service-consultation .consultation-main>p{font-size:15px;line-height:1.85;color:#627487;margin:0;max-width:570px}.consultation-actions{display:grid;gap:12px;position:relative}.consultation-primary,.consultation-secondary{display:flex;align-items:center;justify-content:center;gap:12px;border-radius:12px;min-height:54px;padding:10px 18px;font-size:14px;font-weight:550;text-align:center;transition:transform .18s,box-shadow .18s,background .18s}.consultation-primary{justify-content:space-between;color:#fff;background:linear-gradient(110deg,#146f9c,#3857aa);box-shadow:0 8px 20px -8px #1b5c9b70}.consultation-arrow{display:grid;place-items:center;border-radius:50%;width:32px;height:32px;flex-shrink:0;background:#ffffff20}.consultation-arrow svg{width:19px;height:19px}.consultation-secondary{border:1px solid #d6e2ee;background:#ffffffb3;color:#285b7c}.consultation-secondary svg{width:21px;height:21px}.consultation-primary:hover{transform:translateY(-2px);box-shadow:0 12px 24px -8px #1b5c9b70}.consultation-secondary:hover{background:#fff;border-color:#9fbcd5}.consultation-note{text-align:center;font-size:11px;color:#7b8a99;margin-top:3px;line-height:1.6}.consultation-links{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:14px 30px;padding:22px 0 24px;border-top:1px solid #dfe7f0}.consultation-links a{display:flex;align-items:center;gap:9px;font-size:12px;color:#52728b;padding:4px 0}.consultation-links svg{width:17px;height:17px;flex-shrink:0;color:#5584a4}.consultation-links a>span{margin-left:3px;color:#829bad}.consultation-links a:hover{color:#146f9c}.service-consultation a:focus-visible{outline:2px solid #146f9c;outline-offset:5px}@media(max-width:900px){.consultation-card{gap:26px 32px;padding:30px 28px 0;grid-template-columns:minmax(0,1fr) minmax(225px,.8fr)}}@media(max-width:767px){.service-consultation{padding-top:28px;padding-bottom:32px}.consultation-card{grid-template-columns:minmax(0,1fr);padding:26px 22px 0;gap:24px;border-radius:20px}.consultation-heading{margin-bottom:18px}.service-consultation .consultation-main h2{font-size:25px;margin-bottom:14px}.service-consultation .consultation-main>p{font-size:14px;line-height:1.85}.consultation-primary,.consultation-secondary{min-height:52px}.consultation-links{padding:18px 0 22px;gap:14px;align-items:flex-start;flex-direction:column}.consultation-links a{font-size:12px}.consultation-art{right:-95px;top:-110px}}
@media(prefers-reduced-motion:reduce){.consultation-primary,.consultation-secondary{transition:none}.consultation-primary:hover{transform:none}}
</style>
