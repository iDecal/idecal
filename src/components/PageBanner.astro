---
import ProductImage from './ProductImage.astro';
interface Props {
  title: string;
  eyebrow: string;
  image: string;
  imageAlt: string;
}
const { title, eyebrow, image, imageAlt } = Astro.props;
---
<section class="compact-page-banner">
  <div class="container">
    <div class="compact-banner-grid">
      <div class="compact-banner-copy"><p class="compact-banner-eyebrow">{eyebrow}</p><h1 class="brand-heading">{title}</h1><div class="compact-banner-description"><slot name="description" /></div><div class="compact-banner-actions"><slot name="actions" /></div>{Astro.slots.has('meta') && <div class="compact-banner-meta"><slot name="meta" /></div>}</div>
      <figure class="compact-banner-image"><ProductImage src={image} alt={imageAlt} eager /><slot name="image-badge" /></figure>
    </div>
  </div>
</section>
<style>
.compact-page-banner { padding: 36px 0; border-bottom: 1px solid #dce6f3; background: radial-gradient(ellipse at 100% 0%,#eae7ff,transparent 65%),linear-gradient(120deg,#edf7ff,#fafbff); }
.compact-banner-grid { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 48px; align-items: center; }
.compact-banner-copy { max-width: 740px; }
.compact-banner-eyebrow { display: inline-flex; width: fit-content; max-width: 100%; margin: 0 0 20px; padding: 8px 14px; border: 1px solid #dce6f8; border-radius: 999px; background: linear-gradient(110deg,#f0f8ff,#f3eeff); font-size: 14px; color: #1b4f7a; font-weight: 500; }
.compact-banner-copy h1 { margin: 0 0 22px; max-width: 680px; font-size: clamp(30px,3vw,40px); font-weight: 600; line-height: 1.3; text-wrap: balance; }
.compact-banner-description { max-width: 680px; color: #44566b; font-size: 16px; line-height: 1.7; }
.compact-banner-description :global(p) { font-size: 16px; line-height: 1.7; margin: 0; color: #44566b; }
.compact-banner-description :global(p + p) { margin-top: 8px; }
.compact-banner-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 26px; }
.compact-banner-actions :global(.btn-primary-solid) { min-height: 46px; padding: 12px 24px; font-size: 15px; }
.compact-banner-actions :global(.btn-idecal-bold) { color: #0d6b96; border-color: currentColor; font-size: 14px; }
.compact-banner-actions :global(.btn-idecal-bold:hover) { color: #1b4f7a; }
.compact-banner-image { position: relative; width: 100%; aspect-ratio: 1; margin: 0; overflow: hidden; border-radius: 18px; border: 0; background: #edf4fc; box-shadow: none; }
.compact-banner-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 18px; font-size: 13px; color: #52657c; }
.compact-banner-meta :global(p) { margin: 0; font-size: 13px; color: #52657c; }
.compact-banner-meta :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
@media(min-width:768px) and (max-width:1023px) { .compact-banner-grid { grid-template-columns: minmax(0,1fr) 220px; gap: 28px; } }
@media(max-width:767px) {
 .compact-page-banner { padding: 28px 0; }
 .compact-page-banner .container { padding-left: 20px; padding-right: 20px; }
 .compact-banner-grid { grid-template-columns: 1fr; gap: 24px; }
 .compact-banner-copy h1 { font-size: 29px; line-height: 1.3; }
 .compact-banner-eyebrow { font-size: 13px; padding: 7px 12px; margin-bottom: 16px; }
 .compact-banner-image { max-width: 220px; justify-self: center; border-radius: 14px; }
 .compact-banner-actions { gap: 14px 18px; margin-top: 20px; }
}
</style>
