---
import ProductImage from './ProductImage.astro';
interface Props {
  title: string;
  eyebrow: string;
  image: string;
  imageAlt: string;
  breadcrumbs: { label: string; href?: string }[];
}
const { title, eyebrow, image, imageAlt, breadcrumbs } = Astro.props;
---
<section class="compact-page-banner">
  <div class="container">
    <nav aria-label="Đường dẫn" class="compact-banner-breadcrumb">{breadcrumbs.map((crumb,index)=><>{index>0&&<span aria-hidden="true">/</span>}{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</>)}</nav>
    <div class="compact-banner-grid">
      <div class="compact-banner-copy"><p class="compact-banner-eyebrow">{eyebrow}</p><h1 class="brand-heading">{title}</h1><div class="compact-banner-description"><slot name="description" /></div><div class="compact-banner-actions"><slot name="actions" /></div>{Astro.slots.has('meta') && <div class="compact-banner-meta"><slot name="meta" /></div>}</div>
      <figure class="compact-banner-image"><ProductImage src={image} alt={imageAlt} eager /></figure>
    </div>
  </div>
</section>
{Astro.slots.has('after') && <div class="compact-banner-after"><div class="container"><slot name="after" /></div></div>}
<style>
.compact-page-banner { padding: 24px 0 32px; border-bottom: 1px solid #dce6f3; background: radial-gradient(ellipse at 100% 0%,#eae7ff,transparent 65%),linear-gradient(120deg,#edf7ff,#fafbff); }
.compact-banner-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 20px; font-size: 12px; line-height: 1.6; color: #52657c; }
.compact-banner-breadcrumb a { color: #0d6b96; }
.compact-banner-grid { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 48px; align-items: center; }
.compact-banner-eyebrow { margin: 0 0 12px; font-size: 11px; color: #0d6b96; font-weight: 500; }
.compact-banner-copy h1 { margin: 0 0 16px; max-width: 850px; font-size: clamp(27px,2.5vw,34px); font-weight: 600; line-height: 1.3; }
.compact-banner-description { max-width: 780px; color: #44566b; font-size: 14px; line-height: 1.7; }
.compact-banner-description :global(p) { font-size: 14px; line-height: 1.7; margin: 0; color: #44566b; }
.compact-banner-description :global(p + p) { margin-top: 8px; }
.compact-banner-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 22px; }
.compact-banner-actions :global(.btn-primary-solid) { min-height: 44px; padding: 11px 20px; font-size: 13px; }
.compact-banner-actions :global(.btn-idecal-bold) { color: #0d6b96; border-color: currentColor; font-size: 13px; }
.compact-banner-actions :global(.btn-idecal-bold:hover) { color: #1b4f7a; }
.compact-banner-image { position: relative; width: 100%; aspect-ratio: 1; margin: 0; overflow: hidden; border-radius: 18px; border: 1px solid #d7e2f0; background: #edf4fc; box-shadow: 0 8px 26px #1b4f7a0a; }
.compact-banner-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 18px; font-size: 12px; color: #52657c; }
.compact-banner-meta :global(p) { margin: 0; font-size: 12px; color: #52657c; }
.compact-banner-meta :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
.compact-banner-after { padding: 24px 0; border-bottom: 1px solid #e1e9f3; background: #fff; }
.compact-banner-after :global(.banner-benefits) { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 24px; }
.compact-banner-after :global(h2) { font-size: 14px; margin: 0 0 7px; line-height: 1.5; font-weight: 500; color: #1b4f7a; }
.compact-banner-after :global(p) { font-size: 12px; line-height: 1.7; margin: 0; color: #52657c; }
@media(min-width:768px) and (max-width:1023px) { .compact-banner-grid { grid-template-columns: minmax(0,1fr) 220px; gap: 28px; } .compact-banner-after :global(.banner-benefits) { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; } }
@media(max-width:767px) {
 .compact-page-banner { padding: 20px 0 28px; }
 .compact-page-banner .container, .compact-banner-after .container { padding-left: 20px; padding-right: 20px; }
 .compact-banner-grid { grid-template-columns: 1fr; gap: 24px; }
 .compact-banner-copy h1 { font-size: 27px; }
 .compact-banner-image { max-width: 220px; justify-self: center; border-radius: 14px; }
 .compact-banner-actions { gap: 14px 18px; margin-top: 20px; }
 .compact-banner-after :global(.banner-benefits) { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
}
</style>
