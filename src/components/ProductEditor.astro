---
import { productCategories, type Product } from '../data/catalogue';
interface Props { product: Product; }
const { product } = Astro.props;
---
<div class="product-editor" data-product-editor data-product-slug={product.slug}>
  <div class="product-editor-toolbar">
    <button type="button" data-editor-open hidden>Chỉnh sửa sản phẩm</button>
    <button type="button" data-editor-logout hidden>Đăng xuất</button>
  </div>
  <dialog data-editor-dialog aria-labelledby="product-editor-title">
    <div class="product-editor-heading"><h2 id="product-editor-title">Quản lý sản phẩm</h2><button type="button" data-editor-close aria-label="Đóng popup">×</button></div>
    <form data-editor-form hidden>
      <p>Chỉnh sửa <strong>{product.code || product.name}</strong>. Lưu sẽ cập nhật sản phẩm trên GitHub; website hiển thị bản mới sau khi triển khai hoàn tất.</p>
      <label>URL sản phẩm<input value={product.slug} readonly /></label>
      <label>Tên sản phẩm<input name="name" required maxlength="250" /></label>
      <div class="product-editor-grid">
        <label>Mã mẫu<input name="code" maxlength="100" /></label>
        <div><label>Thương hiệu<select name="brand"><option value="">Chưa chọn</option></select></label><button type="button" data-brand-add class="editor-small-button">+ Thêm thương hiệu</button><label data-brand-new-field hidden>Tên thương hiệu mới<input name="brandNew" maxlength="100" /></label></div>
        <label>Giá (đồng)<input name="price" type="number" min="0" step="1" placeholder="Để trống nếu liên hệ báo giá" /></label>
        <div><label>Danh mục<select name="category">{productCategories.map(category => <option value={category.slug}>{category.name}</option>)}</select></label><button type="button" data-category-add class="editor-small-button">+ Thêm danh mục</button><div data-category-new hidden><label>Tên danh mục mới<input name="categoryName" maxlength="100" /></label><label>Đường dẫn danh mục<input name="categorySlug" maxlength="80" placeholder="vi-du-danh-muc" /></label><button type="button" data-category-create class="editor-small-button">Tạo danh mục</button></div></div>
      </div>
      <label>Mô tả ngắn<textarea name="description" required rows="3"></textarea></label>
      <label>Mô tả chi tiết<textarea name="paragraphs" rows="6" placeholder="Các đoạn cách nhau bằng một dòng trống"></textarea></label>
      <fieldset class="editor-images"><legend>Ảnh sản phẩm</legend><div data-editor-images></div><button type="button" data-image-add class="editor-small-button">+ Thêm ảnh</button><p class="product-editor-help">Chọn ảnh từ máy hoặc sửa URL. Điền ALT và tiêu đề cho từng ảnh. Ảnh đầu tiên là ảnh chính. Upload lưu tệp lên GitHub ngay; bấm Lưu sản phẩm để áp dụng ảnh, ALT và tiêu đề.</p></fieldset>
      <div class="product-editor-actions"><button type="submit" class="btn-primary-solid">Lưu sản phẩm</button><a href="/admin/cms.html" target="_blank" rel="noopener noreferrer">Mở trang quản trị ↗</a></div>
    </form>
    <p data-editor-status role="status" aria-live="polite"></p>
  </dialog>
</div>
<script>import '../scripts/product-editor';</script>
<style>
.product-editor{margin-top:0}.product-editor.is-authenticated{margin-top:22px}.product-editor [hidden]{display:none!important}.product-editor-toolbar{display:flex;flex-wrap:wrap;gap:16px}.product-editor-toolbar :is(button,a){font-size:12px;color:#52677c;text-decoration:underline;text-underline-offset:4px}.product-editor-toolbar [data-editor-open]{background:#d6e9f5;color:#031245;padding:9px 14px;border:1px solid #93bad8;border-radius:7px;text-decoration:none}dialog{width:min(720px,calc(100% - 28px));max-height:90dvh;padding:26px;border:1px solid #d6e9f5;border-radius:16px;color:#1b4f7a;overflow-y:auto;box-shadow:0 20px 80px #03124533}dialog::backdrop{background:#03124588}.product-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.product-editor-heading h2{font-size:23px;margin:0}.product-editor-heading button{font-size:30px;line-height:1;width:36px;height:36px}form{display:grid;gap:16px}label{display:grid;gap:7px;font-size:13px;font-weight:500}input,textarea,select{width:100%;padding:10px 12px;border:1px solid #cbd5e1;border-radius:7px;background:white;color:#1b4f7a;font:inherit;font-weight:400}input[readonly]{background:#f1f7fc;color:#52677c}textarea{resize:vertical}.product-editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.product-editor p{font-size:13px;line-height:1.7;margin:0}.product-editor .product-editor-help{color:#52677c;font-size:12px}.product-editor-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px}.product-editor-actions a{font-size:13px;text-decoration:underline}[data-editor-status]{margin-top:18px!important;white-space:pre-wrap}[data-editor-status][data-error]{color:#b91c1c}button:disabled{opacity:.6;cursor:wait}:is(button,input,textarea,select,a):focus-visible{outline:2px solid #0d6b96;outline-offset:3px}@media(max-width:540px){dialog{padding:20px}.product-editor-grid{grid-template-columns:1fr}}
.editor-small-button{margin-top:10px;padding:8px 12px;border:1px solid #93bad8;border-radius:6px;background:#d6e9f540;color:#1b4f7a;font-size:12px}.editor-images{border:0;min-width:0;padding:0}.editor-images legend{font-size:15px;font-weight:600;margin-bottom:12px}.editor-image-row{display:grid;gap:12px;padding:16px;margin-bottom:14px;border:1px solid #e1e8ee;border-radius:10px;background:#f9fbfd}.editor-image-top{display:flex;align-items:center;gap:10px}.editor-image-top img{width:70px;height:70px;object-fit:cover;border-radius:6px}.editor-image-top button:last-child{margin-left:auto}.editor-image-row input[type=file]{font-size:12px}.editor-image-row [data-image-file]{display:none}
</style>
