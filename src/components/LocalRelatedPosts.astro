---
import {getCollection} from 'astro:content';
import {relatedGuides} from '../data/content-topics';
import {postCategory} from '../data/blog-categories';
interface Props {areaKey:string;areaName:string;services?:string[];}
const {areaKey,areaName,services=[]}=Astro.props;
const all=await getCollection('blog');
const normalize=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().replace(/-/g,' ');
const labels=areaKey==='thanh-pho-thu-duc'?['Thủ Đức','Quận 2','Quận 9']:areaKey==='tp-hcm'?['TP HCM','TPHCM']: [areaName];
const local=all.filter(post=>labels.some(label=>new RegExp(`\\b${normalize(label).replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`).test(normalize(post.data.title+' '+(post.data.originalUrl??''))))).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const recommended=relatedGuides(all,{context:services.join(' '),limit:3});
const fallback=['cach-do-kich-thuoc-kinh-truoc-khi-dat-decal','so-sanh-decal-sua-trong-va-luoi','cach-doc-bao-gia-decal-theo-hang-muc'].flatMap(id=>all.find(post=>post.id===id)??[]);
const posts=[...local,...recommended,...fallback].filter((post,index,list)=>list.findIndex(other=>other.id===post.id)===index).slice(0,3);
---
<section class="container local-related-posts" aria-labelledby="local-related-title"><div class="local-related-heading"><div><p data-heading-label>Đọc thêm trước khi chọn mẫu</p><h2 id="local-related-title">Gợi ý hữu ích cho nhu cầu tại {areaName}</h2></div><a href="/blog">Xem Blog iDecal →</a></div><div class="local-related-grid">{posts.map(post=><article><a class="local-related-photo" href={`/blog/${post.id}`} aria-label={`Đọc ${post.data.title}`}><img src={post.data.image} alt={post.data.title} width="800" height="500" loading="lazy" decoding="async" /></a><div class="local-related-copy"><span>{postCategory(post).name}</span><h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="local-related-read" href={`/blog/${post.id}`}>Đọc bài viết <span aria-hidden="true">→</span></a></div></article>)}</div></section>
<style>
.local-related-posts{padding-top:30px;padding-bottom:36px;color:#244766}.local-related-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}.local-related-heading>div>p{font-size:12px;color:#64748b;margin:0 0 12px}.local-related-heading h2{font-size:clamp(22px,2.2vw,27px);line-height:1.5;font-weight:550;margin:0}.local-related-heading>a{font-size:13px;color:#0d6b96;white-space:nowrap}.local-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.local-related-grid article{display:flex;flex-direction:column;min-width:0;border:1px solid #e0e9f2;border-radius:14px;overflow:hidden;background:linear-gradient(150deg,#fff 68%,#f5f6ff)}.local-related-photo{display:block;overflow:hidden;background:#eef3f8}.local-related-photo img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;transition:transform .2s}.local-related-photo:hover img{transform:scale(1.025)}.local-related-copy{display:flex;flex-direction:column;flex:1;padding:20px}.local-related-copy>span{align-self:start;font-size:11px;color:#476f92;padding:4px 9px;border-radius:6px;background:var(--idecal-faint-gradient);margin-bottom:12px}.local-related-copy h3{font-size:17px;line-height:1.65;font-weight:500;margin:0 0 12px}.local-related-copy h3 a:hover{color:#0d6b96}.local-related-copy>p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:13px;line-height:1.8;color:#64748b;margin:0 0 20px}.local-related-read{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:13px;color:#0d6b96;margin-top:auto;padding-top:14px;border-top:1px solid #e3eaf2}.local-related-posts a:focus-visible{outline:2px solid #0d6b96;outline-offset:3px}@media(max-width:767px){.local-related-grid{grid-template-columns:1fr;gap:18px}.local-related-heading{align-items:start;flex-direction:column;gap:12px}.local-related-posts{padding-top:28px;padding-bottom:28px}.local-related-grid article{display:grid;grid-template-columns:110px minmax(0,1fr)}.local-related-photo img{height:100%;aspect-ratio:auto;min-height:160px}.local-related-copy{padding:16px}.local-related-copy h3{font-size:15px}.local-related-copy>p{display:none}.local-related-copy>span{margin-bottom:8px}.local-related-read{margin-top:6px}}@media(prefers-reduced-motion:reduce){.local-related-photo img{transition:none}}
</style>
