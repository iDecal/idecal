---
import { getCollection } from 'astro:content';
const selected=['decal-mo-logo-bio-cio','decal-mo-logo-protraco-logistics','in-an-thi-cong-decal-dfcare-quan-9'];
const all=await getCollection('projects');
const projects=selected.flatMap(id=>{const project=all.find(p=>p.id===id);return project?[project]:[]});
---
<section id="home-projects" class="home-projects brand-dark alignfull" aria-labelledby="home-projects-title">
  <div class="home-projects-inner">
    <header class="home-projects-heading"><div><p data-heading-label>Hình ảnh đã thực hiện</p><h2 id="home-projects-title">Công trình thực tế của iDecal</h2><p>Tham khảo cách phối Decal, logo và vùng che phủ qua những không gian đã thi công.</p></div><a href="/du-an" class="home-projects-all">Xem các công trình <span aria-hidden="true">→</span></a></header>
    <div class="home-projects-grid">{projects.map((project,index)=><article class:list={['home-project',{'home-project-featured':index===0}]}><a href={`/du-an/${project.id}/`} aria-label={project.data.title}><figure><img src={project.data.image} alt={project.data.title} width="1200" height="900" loading="lazy" decoding="async" /><figcaption><span>{project.data.category}</span><h3>{project.data.client}</h3><svg class="home-project-open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 18 18 6M6 6h12v12"/></svg></figcaption></figure></a></article>)}</div>
  </div>
</section>
