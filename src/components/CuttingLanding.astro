---
import source from '../data/cutting-original.json';
import {cuttingMaterials,cuttingRelatedSolutions,cuttingFaqs,cuttingServiceImages,cuttingMaterialImages} from '../data/cutting-presentation';
import {uploadedServicePhotos} from '../data/installation-photo-links';
import BannerBenefits from './BannerBenefits.astro';
import InstallationPhotoGallery from './InstallationPhotoGallery.astro';
import RelatedGuides from './RelatedGuides.astro';
import '../styles/cutting-landing.css';
const quote='/lien-he-idecal?dich-vu=cat-decal#yeu-cau';
const consultationHtml=source.materials.consult.map(block=>block.html.replace(/<\/p>$/,` <a href="${quote}">gửi mẫu cần cắt để được hỗ trợ</a>.</p>`)).join('');
const sections=[{id:'san-pham-dich-vu',label:'Kiểu cắt'},{id:'bang-gia',label:'Bảng giá'},{id:'chat-lieu',label:'Vật liệu'},{id:'quy-trinh',label:'Quy trình'},{id:'cau-hoi',label:'FAQ'}];
const servicesActions=['Xem mẫu','Trao đổi mẫu tem nhãn','Gửi mẫu trang trí','Đặt cắt LOGO ngay'];
---
<div class="cut-service-page">
  <section class="cut-service-hero compact-page-banner" data-service-hero data-technical-hero><div class="container cut-hero-grid" data-hero-layout><div class="compact-banner-copy" data-hero-copy><nav class="cut-breadcrumb" aria-label="Đường dẫn trang"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/dich-vu/">Dịch vụ</a><span aria-hidden="true">/</span><span aria-current="page">Cắt Decal</span></nav><p data-heading-label>Cắt chữ, logo & họa tiết</p><h1>{source.hero.title}</h1><div class="cut-hero-lead" set:html={source.hero.blocks[0].html} /><div class="cut-hero-actions" data-hero-actions><a class="btn-primary-solid" href={source.hero.actions[0].href}>{source.hero.actions[0].label}<span aria-hidden="true">→</span></a><a class="cut-text-link" href="#bang-gia">{source.hero.actions[1].label}<span aria-hidden="true">↓</span></a></div><BannerBenefits benefits={['Đa dạng chất liệu','Cắt theo file','Hỗ trợ thiết kế'].map(title=>({title}))} /></div><figure class="cut-hero-photo" data-hero-media data-hero-image-treatment><img src={source.hero.image.src} alt={source.hero.image.alt} width={source.hero.image.width} height={source.hero.image.height} fetchpriority="high" /><figcaption>Minh họa máy cắt và vật liệu Decal</figcaption></figure></div></section>
  <nav class="cut-jump" aria-label="Nội dung dịch vụ cắt Decal"><div class="container">{sections.map(section=><a href={'#'+section.id}>{section.label}</a>)}</div></nav>

  <section id="san-pham-dich-vu" class="container cut-section"><header class="cut-section-heading"><div><p data-heading-label>{source.services.heading.title}</p><h2>Bạn cần cắt loại Decal nào?</h2><div set:html={source.services.intro.map(b=>b.html).join('')} /></div><div id="pham-vi" class="cut-intro" set:html={source.hero.blocks.slice(1).map(b=>b.html).join('')} /></header><div class="cut-service-grid">{source.services.items.map((item,index)=><article><figure class="cut-product-photo"><img {...cuttingServiceImages[index]} loading="lazy" /></figure><div class="cut-product-copy"><span class="cut-item-number" aria-hidden="true">0{index+1}</span><div><h3>{item.title}</h3><div set:html={item.blocks.map(block=>block.html).join('')} /><a class="cut-text-link" href={item.actions[0]?.href??quote}>{servicesActions[index]}<span aria-hidden="true">→</span></a></div></div></article>)}</div></section>

  <section id="bang-gia" class="cut-pricing cut-section"><div class="container"><span id="bang-gia-cat-decal-vi-tinh-tai-idecal-moi-nhat" class="cut-anchor" aria-hidden="true"></span><header class="cut-section-heading"><div><p data-heading-label>{source.pricing.heading.subtitle}</p><h2>{source.pricing.heading.title}</h2></div><div set:html={source.pricing.intro.slice(0,1).map(b=>b.html).join('')} /></header><div class="cut-pricing-table"><table role="table"><caption class="sr-only">Bảng giá cắt chữ Decal tham khảo từ nội dung năm 2025</caption><thead><tr>{source.pricing.headers.map(header=><th scope="col">{header}</th>)}</tr></thead><tbody>{source.pricing.rows.map(row=><tr><th scope="row">{row[0]}</th><td class="cut-price" data-label={source.pricing.headers[1]}>{row[1]}</td><td data-label={source.pricing.headers[2]}>{row[2]}</td></tr>)}</tbody></table></div><div class="cut-price-footer"><div><p>{source.pricing.caption}</p><div set:html={source.pricing.intro.slice(2).map(b=>b.html).join('')} /></div><a class="btn-primary-solid" href={quote}>Gửi file nhận báo giá <span aria-hidden="true">→</span></a></div><details class="cut-price-details"><summary>Thông tin thêm về báo giá <span aria-hidden="true">+</span></summary><div set:html={source.pricing.intro.slice(1,2).map(b=>b.html).join('')} /></details></div></section>

  <section id="chat-lieu" class="container cut-section"><header class="cut-section-heading"><div><p data-heading-label>Vật liệu theo bề mặt dán</p><h2>{source.materials.heading.title}</h2></div><div set:html={source.materials.intro.map(b=>b.html).join('')} /></header><div class="cut-material-layout"><div class="cut-material-list">{cuttingMaterials.map((item,index)=><article><figure class="cut-material-photo"><img src={cuttingMaterialImages[index].src} alt={cuttingMaterialImages[index].alt} width={cuttingMaterialImages[index].width} height={cuttingMaterialImages[index].height} loading="lazy" /><figcaption>{cuttingMaterialImages[index].caption}</figcaption></figure><div class="cut-material-copy"><h3>{item.title}</h3><div set:html={item.blocks.map(b=>b.html).join('')} /></div><a href={item.href} aria-label={`Tìm hiểu ${item.title}`}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></article>)}</div><aside class="cut-material-help"><h3>{source.materials.consultHeading.title}</h3><div set:html={consultationHtml} /></aside></div><details class="cut-related-solutions"><summary>Giải pháp theo mục đích sử dụng <span aria-hidden="true">+</span></summary><nav aria-label="Giải pháp liên quan">{cuttingRelatedSolutions.map(item=><a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}</nav></details></section>

  <section id="quy-trinh" class="cut-process cut-section"><div class="container"><header class="cut-section-heading"><div><p data-heading-label>Từ file đến thành phẩm</p><h2>{source.process.heading.title.replace('Dịch vụcắt','Dịch vụ cắt')}</h2></div><div set:html={source.process.notes.map(b=>b.html).join('')} /></header><ol class="cut-process-list">{source.process.steps.map(step=><li><h3>{step.title}</h3><div set:html={step.blocks.map(b=>b.html).join('')} /></li>)}</ol><a href={source.process.action.href} class="cut-text-link">{source.process.action.label}<span aria-hidden="true">→</span></a></div></section>

  <section id="vi-sao-chon-idecal" class="container cut-section cut-benefits"><div><p data-heading-label>Thiết kế · Gia công · Thi công</p><h2>{source.benefits.heading.title}</h2><div set:html={source.benefits.intro.map(b=>b.html).join('')} /><ul>{source.benefits.pointsHtml.map(point=><li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg><Fragment set:html={point} /></li>)}</ul></div><figure><img src={source.benefits.image.src} alt={source.benefits.image.alt} width={source.benefits.image.width} height={source.benefits.image.height} loading="lazy" /><figcaption>{source.benefits.caption}</figcaption></figure></section>

  <div class="container"><InstallationPhotoGallery numbers={uploadedServicePhotos['cat-decal']} heading="Decal chữ và logo tại công trình" /></div>

  <section id="cau-hoi" class="container cut-section cut-faq"><header><p data-heading-label>{source.faq.heading.subtitle}</p><h2>{source.faq.heading.title}</h2><a class="cut-text-link" href="https://zalo.me/0866077040">Trao đổi qua Zalo <span aria-hidden="true">→</span></a></header><div class="cut-faq-list">{cuttingFaqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><div><Fragment set:html={item.blocks.map(b=>b.html).join('')} />{item.clarification&&<p>{item.clarification}</p>}</div></details>)}</div></section>
  <RelatedGuides context="cat-decal" />
  <section class="cut-final-cta"><div class="container cut-final-grid"><div><h2>Cần cắt chữ hoặc logo theo mẫu?</h2><p>Gửi file AI, Corel hoặc PDF, kích thước và số lượng để iDecal kiểm tra, tư vấn và báo giá.</p></div><div class="cut-final-actions"><a class="btn-primary-solid" href={quote}>Nhận báo giá cắt <span aria-hidden="true">→</span></a><a class="cut-text-link" href="https://zalo.me/0866077040">Hotline/Zalo: 0866.077.040</a></div></div></section>
</div>
