---
import type {CollectionEntry} from 'astro:content';
import {postCategory} from '../data/blog-categories';
interface Props {post:CollectionEntry<'blog'>;heading?:'h2'|'h3';priority?:boolean;}
const {post,heading='h2',priority=false}=Astro.props;
const Heading=heading;
const category=postCategory(post);
const dateFormat=new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',day:'2-digit',month:'2-digit',year:'numeric'});
---
<article class="post-card">
  <a class="blog-card-image" href={`/blog/${post.id}`} aria-label={`Đọc ${post.data.title}`}><img src={post.data.image} alt={post.data.title} width="800" height="400" loading={priority?'eager':'lazy'} fetchpriority={priority?'high':undefined} /></a>
  <div class="blog-card-content">
    <Heading><a href={`/blog/${post.id}`}>{post.data.title}</a></Heading>
    <div class="blog-card-meta"><a href={`/blog/chuyen-muc/${category.slug}`}>{category.name}</a><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time></div>
    <a class="blog-read-link" href={`/blog/${post.id}`} aria-label={`Đọc bài viết: ${post.data.title}`}>Đọc bài viết <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
  </div>
</article>
