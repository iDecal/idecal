---
import type { CollectionEntry } from 'astro:content';
import { blogCategories, postCategory, sortBlogPosts } from '../data/blog-categories';
import '../styles/blog.css';
interface Props { posts:CollectionEntry<'blog'>[]; title:string; description:string; categorySlug?:string; }
const {posts,title,description,categorySlug}=Astro.props;
const entries=sortBlogPosts(posts);
const dateFormat=new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',day:'2-digit',month:'2-digit',year:'numeric'});
---
<div class="blog-listing"><section class="blog-hero"><div class="container"><p class="blog-kicker">Góc chia sẻ iDecal</p><h1 class="brand-heading">{title}</h1><p>{description}</p></div></section><section class="container blog-list-section" aria-label="Danh sách bài viết"><nav class="blog-category-nav" aria-label="Chuyên mục Blog"><a href="/blog" aria-current={!categorySlug?'page':undefined}>Tất cả bài viết</a>{blogCategories.map(category=><a href={`/blog/chuyen-muc/${category.slug}`} aria-current={categorySlug===category.slug?'page':undefined}>{category.name}</a>)}</nav><p class="blog-post-count">{entries.length} bài viết</p><div id="blog-grid" class="blog-post-grid">{entries.map(post=><article class="post-card"><a class="blog-card-image" href={`/blog/${post.id}`} aria-label={`Đọc ${post.data.title}`}><img src={post.data.image} alt={post.data.title} width="800" height="500" loading="lazy" /></a><div class="blog-card-content"><div class="blog-card-meta"><a href={`/blog/chuyen-muc/${postCategory(post).slug}`}>{postCategory(post).name}</a><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time></div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="blog-read-link" href={`/blog/${post.id}`}>Đọc bài viết <span aria-hidden="true">→</span></a></div></article>)}</div>{entries.length===0&&<p class="blog-empty">Chuyên mục đang được cập nhật. Bạn có thể xem các bài viết khác trong Blog iDecal.</p>}</section></div>
