---
import type { CollectionEntry } from 'astro:content';
import BlogPostCard from './BlogPostCard.astro';
import { blogCategories, sortBlogPosts } from '../data/blog-categories';
import '../styles/blog.css';
interface Props { posts:CollectionEntry<'blog'>[]; title:string; description:string; categorySlug?:string; }
const {posts,title,description,categorySlug}=Astro.props;
const entries=sortBlogPosts(posts);
---
<div class="blog-listing">
  <section class="blog-hero container"><div class="blog-hero-panel"><div class="blog-hero-art" aria-hidden="true"></div><div class="blog-hero-copy"><p class="blog-kicker">{categorySlug?<a href="/blog">Blog iDecal / Chuyên mục</a>:'Góc chia sẻ iDecal'}</p><h1>{title}</h1><p>{description}</p></div></div></section>
  <section class="container blog-list-section" aria-label="Danh sách bài viết">
    <nav class="blog-category-nav" aria-label="Chuyên mục Blog">
      <div class="blog-category-grid"><a href="/blog" aria-current={!categorySlug?'page':undefined}>Tất cả bài viết</a>{blogCategories.map(category=><a href={`/blog/chuyen-muc/${category.slug}`} aria-current={categorySlug===category.slug?'page':undefined}>{category.name}</a>)}</div>
    </nav>
    <div class="blog-section-title"><h2>{categorySlug==='so-sanh-vat-lieu'?'Tìm hiểu từng loại vật liệu Decal':categorySlug?'Bài viết trong chuyên mục':'Bài viết mới từ iDecal'}</h2><span>{entries.length} bài viết</span></div>
    <div id="blog-grid" class="blog-post-grid">{entries.map((post,index)=><BlogPostCard post={post} priority={index===0} />)}</div>
    {entries.length===0&&<p class="blog-empty">Chuyên mục đang được cập nhật. Bạn có thể xem các bài viết khác trong Blog iDecal.</p>}
  </section>
</div>
