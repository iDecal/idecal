---
interface Props { title:string; eyebrow:string; image:string; imageAlt:string; detailImage?:string; detailAlt?:string; }
const {title,eyebrow,image,imageAlt}=Astro.props;
---
<section class="lp-hero compact-page-banner" data-service-hero data-technical-hero><div class="container lp-hero-grid" data-hero-layout><div class="lp-hero-copy" data-hero-copy><p class="lp-eyebrow">{eyebrow}</p><h1 class="brand-heading">{title}</h1><div class="lp-lead"><slot name="description" /></div><div class="lp-actions" data-hero-actions><slot name="actions" /></div><slot name="meta" /></div><div class="lp-hero-visual" data-hero-media data-hero-image-treatment><figure class="lp-hero-photo"><img src={image} alt={imageAlt} width="1100" height="900" fetchpriority="high" /></figure></div></div></section>
