---
interface Props { title:string; eyebrow:string; image:string; imageAlt:string; detailImage?:string; detailAlt?:string; }
const {title,eyebrow,image,imageAlt,detailImage,detailAlt}=Astro.props;
---
<section class="lp-hero compact-page-banner"><div class="container lp-hero-grid"><div class="lp-hero-copy"><p class="lp-eyebrow"><span aria-hidden="true"></span>{eyebrow}</p><h1 class="brand-heading">{title}</h1><div class="lp-lead"><slot name="description" /></div><div class="lp-actions"><slot name="actions" /></div><div class="lp-hero-points"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Thống nhất mẫu trước khi làm</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Rõ phạm vi và chi phí</span></div><slot name="meta" /></div><div class="lp-hero-visual"><figure class="lp-hero-photo"><img src={image} alt={imageAlt} width="1100" height="900" fetchpriority="high" /></figure>{detailImage && <figure class="lp-hero-detail"><img src={detailImage} alt={detailAlt ?? imageAlt} width="500" height="400" loading="lazy" /><figcaption>Từ ý tưởng đến hoàn thiện</figcaption></figure>}</div></div></section>
