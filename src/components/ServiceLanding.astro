---
import ServiceHero from './ServiceHero.astro';
import PrintingServiceContent from './PrintingServiceContent.astro';
import DesignServiceContent from './DesignServiceContent.astro';
import InstallationServiceContent from './InstallationServiceContent.astro';
import installationContent from '../data/installation-service.json';
import designContent from '../data/design-service.json';
import { serviceLandingContent } from '../data/service-landing-content';
import { type ServiceOffering } from '../data/site-offerings';
import cut from '../data/decal-cutting.json';
import '../styles/service-landing.css';
interface Props { service:ServiceOffering; }
const {service}=Astro.props;
const content=serviceLandingContent[service.slug];
const steps=service.slug==='cat-decal'?cut.steps.map(step=>({title:step.title,text:step.text})):service.slug==='thi-cong-decal'?installationContent.steps:service.steps;
const hasDetails=Astro.slots.has('details');
const booking=`/dat-dich-vu?dich-vu=${service.slug}`;
const extraFaqs = service.slug === 'thiet-ke' ? designContent.faqs : service.slug === 'thi-cong-decal' ? installationContent.faqs : [];
const faqs = [...content.faqs, ...extraFaqs];
---
<div class="service-lp">
  <ServiceHero title={service.headline} eyebrow={`Dịch vụ ${service.name.toLocaleLowerCase('vi-VN')}`} image={service.image} imageAlt={service.name} detailImage={content.image} detailAlt={content.imageAlt}>
    <p slot="description">{service.description}</p><Fragment slot="actions"><a href={booking} class="btn-primary-solid">Nhận tư vấn dịch vụ <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19 19 5M5 5h14v14" /></svg></a><a href="#pham-vi" class="btn-idecal-bold">Khám phá dịch vụ ↓</a></Fragment>
  </ServiceHero>
  <nav class="lp-section-nav" aria-label="Nội dung trang dịch vụ"><div class="container"><a href="#pham-vi">Phạm vi dịch vụ</a>{service.slug === 'thiet-ke' && <Fragment><a href="#hang-muc-thiet-ke">Hạng mục thiết kế</a><a href="#chuan-bi-thiet-ke">Thông tin cần gửi</a><a href="#ban-giao-thiet-ke">Bàn giao</a></Fragment>}{service.slug === 'in-decal' && <Fragment><a href="#vat-lieu-in">Vật liệu in</a><a href="#cong-nghe-in">Công nghệ in</a><a href="#vi-sao-chon-idecal">Vì sao chọn iDecal</a></Fragment>}{service.slug === 'thi-cong-decal' && <Fragment><a href="#hang-muc-thi-cong">Hạng mục thi công</a><a href="#khao-sat-thi-cong">Khảo sát & báo giá</a><a href="#ban-giao-thi-cong">Bàn giao</a></Fragment>}<a href="#quy-trinh">Quy trình</a>{hasDetails && <a href="#bang-gia">Bảng giá</a>}<a href={hasDetails?'#cau-hoi':'#lp-cau-hoi'}>Câu hỏi thường gặp</a><a href={booking}>Gửi yêu cầu <span aria-hidden="true">→</span></a></div></nav>
  <section id="pham-vi" class="container lp-section"><div class="lp-section-heading"><div><p class="lp-kicker">{content.kicker}</p><h2>Dịch vụ phù hợp với phần việc bạn cần</h2></div><p>Chọn riêng một công đoạn hoặc phối hợp nhiều phần việc. Mẫu, vật liệu và phạm vi được thống nhất trước khi thực hiện.</p></div><div class="lp-scope-grid">{service.deliverables.map((title,index)=><article><span class="lp-scope-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d={['M4 4h16v16H4zM8 8h8M8 12h8M8 16h4','m4 16 1 4 4-1L20 8l-5-5L4 16Zm9-11 5 5','M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6'][index%3]} /></svg></span><h3>{title}</h3><p>{content.scope[index]}</p></article>)}</div></section>
  {service.slug === 'in-decal' && <PrintingServiceContent />}
  {service.slug === 'thiet-ke' && <DesignServiceContent />}
  {service.slug === 'thi-cong-decal' && <InstallationServiceContent />}
  {hasDetails && <div class="lp-details"><slot name="details" /></div>}
  <section id="quy-trinh" class="lp-process lp-section"><div class="container"><div class="lp-section-heading"><div><p class="lp-kicker">Dễ theo dõi từng bước</p><h2>Từ trao đổi đến hoàn thiện</h2></div><p>Biết cần chuẩn bị gì và xác nhận ở đâu trước mỗi công đoạn.</p></div><ol class:list={['lp-process-grid',{'lp-process-four':steps.length===4}]}>{steps.map((step,index)=><li><span class="lp-step-number">0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>
  <section class="container lp-section lp-quote"><div class="lp-quote-image"><img src={content.image} alt={content.imageAlt} width="900" height="650" loading="lazy" /></div><div><p class="lp-kicker">Bắt đầu từ thông tin thực tế</p><h2>Gửi yêu cầu, nhận phương án rõ ràng</h2><p>Chuẩn bị ảnh vị trí dán, kích thước, nội dung hoặc file thiết kế và thời gian mong muốn. iDecal sẽ trao đổi về vật liệu, cách thực hiện và chi phí theo nhu cầu.</p><div class="lp-cost-parts"><span>Vật liệu</span><span>Thiết kế</span><span>In / gia công</span><span>Thi công</span></div><p class="lp-quote-note">Phần nào đã bao gồm trong đơn giá sẽ được ghi rõ khi báo giá.</p><a class="btn-primary-solid" href={booking}>Gửi yêu cầu của bạn <span aria-hidden="true">→</span></a></div></section>
  {hasDetails ? <slot name="faq" /> : <section id="lp-cau-hoi" class="lp-faq lp-section"><div class="container lp-faq-grid"><div><p class="lp-kicker">Giải đáp trước khi bắt đầu</p><h2>Câu hỏi thường gặp</h2><p>Chưa rõ phần việc cần chọn? Bạn có thể gửi hình ảnh để trao đổi thêm.</p><a href="https://zalo.me/0866077040" class="btn-idecal-bold">Trao đổi qua Zalo →</a></div><div>{faqs.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></div></section>}
  <div class="container lp-other-services"><a href="/dich-vu">Xem các dịch vụ iDecal <span aria-hidden="true">→</span></a><a href="/du-an">Xem công trình thực tế <span aria-hidden="true">→</span></a></div>
</div>
